#!/usr/bin/env python3
"""smux — operate several independent Slurm controllers over SSH."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

CONFIG_FILE = Path(os.environ.get("SMUX_HOSTS", "~/.config/smux/hosts")).expanduser()
STATE_FILE = Path(os.environ.get("SMUX_STATE", "~/.local/state/smux/jobs.jsonl")).expanduser()
SSH_TIMEOUT = 12

PROBE_SCRIPT = r'''set -u
printf '__SMUX_SCHEDULER__\n'
if command -v sbatch >/dev/null 2>&1; then
    sbatch --version 2>/dev/null || true
else
    printf 'absent\n'
fi
printf '__SMUX_PARTITIONS__\n'
if command -v sinfo >/dev/null 2>&1; then
    sinfo -h -o '%P|%a|%l|%D|%G' 2>/dev/null || true
fi
printf '__SMUX_GPUS__\n'
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi \
        --query-gpu=index,name,memory.used,memory.total,utilization.gpu,compute_cap,driver_version \
        --format=csv,noheader,nounits 2>/dev/null | sed 's/, /|/g' || true
fi
printf '__SMUX_GRES_MAP__\n'
for gres_file in /etc/slurm/gres.conf /etc/slurm-llnl/gres.conf; do
    if [ -r "$gres_file" ]; then
        awk '
            $0 !~ /^[[:space:]]*#/ && $0 ~ /Name=gpu/ && $0 ~ /File=\/dev\/nvidia[0-9]+/ {
                type = "generic"
                file = ""
                for (i = 1; i <= NF; i++) {
                    if ($i ~ /^Type=/) { type = $i; sub(/^Type=/, "", type) }
                    if ($i ~ /^File=/) { file = $i; sub(/^File=/, "", file) }
                }
                gpu_index = file
                sub(/^.*nvidia/, "", gpu_index)
                if (gpu_index ~ /^[0-9]+$/) print gpu_index "|" type
            }
        ' "$gres_file"
        break
    fi
done
printf '__SMUX_JOBS__\n'
if command -v squeue >/dev/null 2>&1; then
    squeue -h -u "$(id -un)" -o '%i|%P|%j|%T|%M|%L|%e|%R' 2>/dev/null || true
fi
'''


class SmuxError(RuntimeError):
    pass


@dataclass(frozen=True)
class ClusterStatus:
    host: str
    scheduler: str
    partitions: list[dict[str, str]]
    gpus: list[dict[str, str]]
    gres_map: list[dict[str, str]]
    jobs: list[dict[str, str]]
    error: str | None = None


def die(message: str) -> None:
    print(f"smux: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_hosts(*, required: bool = True) -> list[str]:
    if not CONFIG_FILE.exists():
        if required:
            die(f"host config not found: {CONFIG_FILE} (run 'smux init')")
        return []
    hosts: list[str] = []
    for number, raw in enumerate(CONFIG_FILE.read_text(encoding="utf-8").splitlines(), 1):
        host = raw.split("#", 1)[0].strip()
        if not host:
            continue
        if any(char.isspace() for char in host):
            die(f"invalid host on {CONFIG_FILE}:{number}: aliases cannot contain whitespace")
        if host in hosts:
            die(f"duplicate host in {CONFIG_FILE}: {host}")
        hosts.append(host)
    if required and not hosts:
        die(f"no hosts configured in {CONFIG_FILE}")
    return hosts


def select_hosts(requested: list[str]) -> list[str]:
    configured = load_hosts()
    if not requested:
        return configured
    unknown = [host for host in requested if host not in configured]
    if unknown:
        die(f"unknown host(s): {', '.join(unknown)}")
    return requested


def ssh_options() -> list[str]:
    # One connection per host, reused: the first command opens a master socket
    # and later ones — including a second smux invocation within
    # ControlPersist — skip the TCP and auth handshake entirely. 'status'
    # followed by 'gpus' across five clusters is ten handshakes without it.
    #
    # The socket path has to stay under the ~104-byte sun_path limit, and
    # macOS's $TMPDIR plus the 40-char %C hash overflows it, so anchor
    # somewhere short and per-user rather than in the system temp dir.
    control_base = "/tmp" if os.path.isdir("/tmp") else tempfile.gettempdir()
    control_dir = os.path.join(control_base, f"smux-ssh-{os.getuid()}")
    try:
        os.makedirs(control_dir, mode=0o700, exist_ok=True)
        control = ["-o", "ControlMaster=auto",
                   "-o", f"ControlPath={control_dir}/%C",
                   "-o", "ControlPersist=30s"]
    except OSError:
        # A read-only or otherwise unusable /tmp is not worth failing over;
        # every command still works, just without the shared connection.
        control = []
    return [
        "-o", "BatchMode=yes",
        "-o", f"ConnectTimeout={SSH_TIMEOUT}",
        "-o", "ServerAliveInterval=30",
        *control,
    ]


def run_shell(
    host: str,
    script: str,
    *,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    if host == "local":
        command = ["sh", "-lc", script]
    else:
        command = ["ssh", *ssh_options(), host, script]
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
    except subprocess.TimeoutExpired as exc:
        raise SmuxError(f"{host}: timed out") from exc


def run_command(
    host: str,
    command: list[str],
    *,
    cwd: str | None = None,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    if host == "local":
        try:
            return subprocess.run(
                command,
                cwd=cwd,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
            )
        except subprocess.TimeoutExpired as exc:
            raise SmuxError(f"{host}: timed out") from exc

    remote = shlex.join(command)
    if cwd:
        remote = f"cd {shlex.quote(cwd)} && {remote}"
    try:
        return subprocess.run(
            ["ssh", *ssh_options(), host, remote],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise SmuxError(f"{host}: timed out") from exc


def parse_sections(output: str) -> dict[str, list[str]]:
    sections: dict[str, list[str]] = {
        "scheduler": [],
        "partitions": [],
        "gpus": [],
        "gres_map": [],
        "jobs": [],
    }
    marker_map = {
        "__SMUX_SCHEDULER__": "scheduler",
        "__SMUX_PARTITIONS__": "partitions",
        "__SMUX_GPUS__": "gpus",
        "__SMUX_GRES_MAP__": "gres_map",
        "__SMUX_JOBS__": "jobs",
    }
    current: str | None = None
    for raw in output.splitlines():
        line = raw.strip()
        if line in marker_map:
            current = marker_map[line]
        elif current is not None and line:
            sections[current].append(line)
    return sections


def split_fields(line: str, names: list[str]) -> dict[str, str]:
    values = line.split("|", len(names) - 1)
    values += [""] * (len(names) - len(values))
    return dict(zip(names, values))


def probe_host(host: str) -> ClusterStatus:
    try:
        result = run_shell(host, PROBE_SCRIPT, timeout=SSH_TIMEOUT)
    except SmuxError as exc:
        return ClusterStatus(host, "unknown", [], [], [], [], str(exc))
    if result.returncode != 0 and not result.stdout.strip():
        error = result.stderr.strip() or f"command exited {result.returncode}"
        return ClusterStatus(host, "unknown", [], [], [], [], error)
    sections = parse_sections(result.stdout)
    scheduler = sections["scheduler"][0] if sections["scheduler"] else "unknown"
    partitions = [
        split_fields(line, ["partition", "availability", "time_limit", "nodes", "gres"])
        for line in sections["partitions"]
    ]
    gpus = [
        split_fields(
            line,
            [
                "index", "name", "memory_used_mib", "memory_mib", "utilization_pct",
                "compute_capability", "driver_version",
            ],
        )
        for line in sections["gpus"]
    ]
    gres_map = [
        split_fields(line, ["index", "type"])
        for line in sections["gres_map"]
    ]
    jobs = [
        split_fields(
            line,
            [
                "job_id",
                "partition",
                "name",
                "state",
                "elapsed",
                "time_left",
                "end_time",
                "reason",
            ],
        )
        for line in sections["jobs"]
    ]
    return ClusterStatus(host, scheduler, partitions, gpus, gres_map, jobs)


def probe_many(hosts: list[str]) -> list[ClusterStatus]:
    # ThreadPoolExecutor rejects max_workers=0, so an empty list would raise
    # rather than return nothing. select_hosts() dies before that can happen
    # today, which is exactly why it is worth pinning here instead.
    if not hosts:
        return []
    results: dict[str, ClusterStatus] = {}
    with ThreadPoolExecutor(max_workers=min(8, len(hosts))) as executor:
        futures = {executor.submit(probe_host, host): host for host in hosts}
        for future in as_completed(futures):
            host = futures[future]
            try:
                results[host] = future.result()
            except Exception as exc:  # defensive: one host must not hide the others
                results[host] = ClusterStatus(host, "unknown", [], [], [], [], str(exc))
    return [results[host] for host in hosts]


def print_table(headers: list[str], rows: list[list[str]]) -> None:
    widths = [len(header) for header in headers]
    for row in rows:
        for index, value in enumerate(row):
            widths[index] = max(widths[index], len(value))
    print("  ".join(header.ljust(widths[index]) for index, header in enumerate(headers)))
    print("  ".join("-" * width for width in widths))
    for row in rows:
        print("  ".join(value.ljust(widths[index]) for index, value in enumerate(row)))


def command_init(args: argparse.Namespace) -> int:
    if CONFIG_FILE.exists() and not args.force:
        die(f"config already exists: {CONFIG_FILE} (use --force to replace it)")
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    CONFIG_FILE.write_text(
        "# One SSH alias per line. Use 'local' for this machine.\n"
        "# gpu-a\n"
        "# gpu-b\n"
        "local\n",
        encoding="utf-8",
    )
    os.chmod(CONFIG_FILE, 0o600)
    print(f"created {CONFIG_FILE}")
    return 0


def command_edit(_args: argparse.Namespace) -> int:
    if not CONFIG_FILE.exists():
        command_init(argparse.Namespace(force=False))
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    if not editor:
        die("set VISUAL or EDITOR before running 'smux edit'")
    return subprocess.run([*shlex.split(editor), str(CONFIG_FILE)], check=False).returncode


def command_hosts(args: argparse.Namespace) -> int:
    hosts = load_hosts()
    if args.json:
        print(json.dumps({"config": str(CONFIG_FILE), "hosts": hosts}, indent=2))
    else:
        print(f"config: {CONFIG_FILE}")
        for host in hosts:
            print(host)
    return 0


def command_status(args: argparse.Namespace) -> int:
    statuses = probe_many(select_hosts(args.hosts))
    if args.json:
        print(json.dumps([asdict(status) for status in statuses], indent=2))
        return int(any(status.error for status in statuses))
    # The ERROR column costs width on every row to say nothing at all when the
    # clusters are healthy, which is the usual case. Add it only when there is
    # something to put in it.
    failed = any(status.error for status in statuses)
    rows: list[list[str]] = []
    for status in statuses:
        if status.error:
            rows.append([status.host, "error", "-", "-", "-", status.error])
            continue
        partitions = ", ".join(item["partition"] for item in status.partitions) or "-"
        gpu_groups: dict[tuple[str, str], int] = {}
        for gpu in status.gpus:
            key = (gpu["name"], gpu["memory_mib"])
            gpu_groups[key] = gpu_groups.get(key, 0) + 1
        gpus = ", ".join(
            f"{count}x {name} ({memory_mib} MiB)"
            for (name, memory_mib), count in gpu_groups.items()
        ) or "-"
        running = sum(job["state"] == "RUNNING" for job in status.jobs)
        pending = sum(job["state"] == "PENDING" for job in status.jobs)
        rows.append([status.host, status.scheduler, partitions, gpus, f"{running}R/{pending}P", ""])
    headers = ["HOST", "SCHEDULER", "PARTITIONS", "GPUS", "MY JOBS"]
    if failed:
        headers.append("ERROR")
    else:
        rows = [row[:-1] for row in rows]
    print_table(headers, rows)
    return int(failed)


def command_gpus(args: argparse.Namespace) -> int:
    """Show physical occupancy together with Slurm's per-index GRES type."""
    statuses = probe_many(select_hosts(args.hosts))
    if args.json:
        payload: list[dict[str, Any]] = []
        for status in statuses:
            gres_by_index = {item["index"]: item["type"] for item in status.gres_map}
            for gpu in status.gpus:
                payload.append({
                    "host": status.host,
                    **gpu,
                    "gres_type": gres_by_index.get(gpu["index"], "unknown"),
                    "idle": _gpu_is_idle(gpu),
                })
        print(json.dumps(payload, indent=2))
        return int(any(status.error for status in statuses))
    rows: list[list[str]] = []
    for status in statuses:
        gres_by_index = {item["index"]: item["type"] for item in status.gres_map}
        for gpu in status.gpus:
            rows.append([
                status.host,
                gpu["index"],
                gres_by_index.get(gpu["index"], "unknown"),
                f'{gpu["memory_used_mib"]}/{gpu["memory_mib"]} MiB',
                f'{gpu["utilization_pct"]}%',
                "yes" if _gpu_is_idle(gpu) else "no",
                gpu["name"],
            ])
    if rows:
        print_table(["HOST", "GPU", "SLURM TYPE", "MEMORY", "UTIL", "IDLE", "MODEL"], rows)
        print(free_summary(statuses))
    else:
        print("no GPUs found")
    for status in statuses:
        if status.error:
            print(f"smux: {status.host}: {status.error}", file=sys.stderr)
    return int(any(status.error for status in statuses))


def free_summary(statuses: list[ClusterStatus]) -> str:
    """One line answering the question the table is read for.

    The table says what every GPU is doing; this says where to go. Grouped by
    host and ordered as the hosts were, so the answer reads as an address —
    'byul:0,1' is something you can act on without counting rows.
    """
    free: dict[str, list[str]] = {}
    for status in statuses:
        for gpu in status.gpus:
            if _gpu_is_idle(gpu):
                free.setdefault(status.host, []).append(gpu["index"])
    total = sum(len(indexes) for indexes in free.values())
    if not total:
        return "no GPUs free"
    detail = "  ".join(f"{host}:{','.join(indexes)}" for host, indexes in free.items())
    return f"{total} GPU{'s' if total != 1 else ''} free  ({detail})"


def _gpu_is_idle(gpu: dict[str, str]) -> bool:
    try:
        return float(gpu["memory_used_mib"]) < 256 and float(gpu["utilization_pct"]) == 0
    except (KeyError, ValueError):
        return False


def command_jobs(args: argparse.Namespace) -> int:
    if getattr(args, "watch", False) and not args.json:
        # Same frame, redrawn: erase-below after each one so a shorter queue
        # leaves nothing of the longer one behind it.
        try:
            while True:
                sys.stdout.write("\033[H\033[2J")
                render_jobs(probe_many(select_hosts(args.hosts)))
                sys.stdout.write("\033[J")
                sys.stdout.flush()
                time.sleep(args.interval)
        except KeyboardInterrupt:
            print()
            return 0
    return render_jobs(probe_many(select_hosts(args.hosts)), as_json=args.json)


def render_jobs(statuses: list[ClusterStatus], *, as_json: bool = False) -> int:
    if as_json:
        payload = [
            {"host": status.host, **job}
            for status in statuses
            for job in status.jobs
        ]
        print(json.dumps(payload, indent=2))
        return int(any(status.error for status in statuses))
    rows = [
        [
            status.host,
            job["job_id"],
            job["partition"],
            job["state"],
            job["elapsed"],
            job["time_left"],
            job["end_time"],
            job["name"],
            job["reason"],
        ]
        for status in statuses
        for job in status.jobs
    ]
    if rows:
        print_table(
            [
                "HOST",
                "JOB",
                "PARTITION",
                "STATE",
                "ELAPSED",
                "LEFT",
                "END",
                "NAME",
                "REASON",
            ],
            rows,
        )
    else:
        print("no jobs")
    for status in statuses:
        if status.error:
            print(f"smux: {status.host}: {status.error}", file=sys.stderr)
    return int(any(status.error for status in statuses))


def ensure_host(host: str) -> None:
    if host not in load_hosts():
        die(f"unknown host: {host}")


def append_state(payload: dict[str, Any]) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(STATE_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(descriptor, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(payload, separators=(",", ":")) + "\n")


def read_state(host: str | None = None, limit: int | None = None) -> list[dict[str, Any]]:
    """Recorded submissions, newest last, optionally for one host.

    Bad lines are skipped rather than fatal: this is a log, and a truncated
    final write should not stop you reading the hundred good records above it.
    """
    try:
        raw = STATE_FILE.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    records = []
    for line in raw:
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if host and record.get("host") != host:
            continue
        records.append(record)
    return records[-limit:] if limit else records


def command_history(args: argparse.Namespace) -> int:
    records = read_state(args.host, args.limit)
    if args.json:
        print(json.dumps(records, indent=2))
        return 0
    if not records:
        print("no recorded submissions")
        return 0
    rows = [
        [
            f'{record.get("host", "?")}:{record.get("job_id", "?")}',
            (record.get("submitted_at") or "")[:19].replace("T", " "),
            record.get("script_source", ""),
            record.get("script", ""),
        ]
        for record in records
    ]
    print_table(["JOB", "SUBMITTED (UTC)", "SOURCE", "SCRIPT"], rows)
    return 0


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def upload_script(host: str, script: str) -> tuple[str, str]:
    """Upload one local Slurm script and return its verified remote path."""
    source = Path(script).expanduser().resolve()
    if not source.is_file():
        die(f"local script not found: {source}")
    digest = file_sha256(source)
    if host == "local":
        return str(source), digest

    payload = source.read_bytes()
    safe_name = re.sub(r"[^A-Za-z0-9_.-]+", "-", source.name).strip(".-") or "job.sbatch"
    remote_name = f"{digest[:16]}-{safe_name}"
    upload = f'''# __SMUX_UPLOAD__
set -eu
directory="$HOME/.local/state/smux/scripts"
target="$directory/{remote_name}"
temporary="$target.tmp.$$"
umask 077
mkdir -p "$directory"
cat > "$temporary"
chmod 700 "$temporary"
mv "$temporary" "$target"
actual=$(sha256sum "$target" | awk '{{print $1}}')
[ "$actual" = {shlex.quote(digest)} ]
printf '%s\\n' "$target"
'''
    try:
        result = subprocess.run(
            ["ssh", *ssh_options(), host, upload],
            input=payload,
            capture_output=True,
            timeout=SSH_TIMEOUT,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise SmuxError(f"{host}: script upload timed out") from exc
    if result.returncode != 0:
        detail = result.stderr.decode(errors="replace").strip()
        raise SmuxError(f"{host}: script upload failed: {detail or 'unknown error'}")
    remote_path = result.stdout.decode(errors="replace").strip().splitlines()
    if not remote_path or not remote_path[-1].startswith("/"):
        raise SmuxError(f"{host}: script upload returned no absolute remote path")
    return remote_path[-1], digest


def remote_script_sha256(host: str, script: str) -> str:
    if host == "local":
        path = Path(script).expanduser().resolve()
        if not path.is_file():
            die(f"script not found: {path}")
        return file_sha256(path)
    result = run_command(host, ["sha256sum", "--", script], timeout=SSH_TIMEOUT)
    if result.returncode != 0:
        raise SmuxError(
            f"{host}: could not hash remote script: "
            f"{result.stderr.strip() or result.stdout.strip()}"
        )
    digest = result.stdout.strip().split(None, 1)[0] if result.stdout.strip() else ""
    if len(digest) != 64 or any(char not in "0123456789abcdefABCDEF" for char in digest):
        raise SmuxError(f"{host}: invalid SHA-256 response for {script}")
    return digest.lower()


def has_scheduler(host: str) -> bool:
    """Whether sbatch exists on the far side.

    One cheap command rather than a full probe, and it shares the connection
    the submit is about to use anyway.
    """
    result = run_command(host, ["sh", "-c", "command -v sbatch"], timeout=SSH_TIMEOUT)
    return result.returncode == 0 and bool(result.stdout.strip())


def command_submit(args: argparse.Namespace) -> int:
    ensure_host(args.host)
    try:
        # Checked before the upload: a host with no controller cannot run the
        # script, so there is no reason to copy it there first.
        if not has_scheduler(args.host):
            die(f"{args.host} has no Slurm controller (sbatch is not on its PATH)")
    except SmuxError as exc:
        die(str(exc))
    try:
        if args.remote:
            submitted_script = args.script
            script_sha256 = remote_script_sha256(args.host, args.script)
        else:
            submitted_script, script_sha256 = upload_script(args.host, args.script)
        command = [
            "sbatch",
            "--parsable",
            *args.sbatch_arg,
            submitted_script,
            *args.script_args,
        ]
        result = run_command(args.host, command, cwd=args.chdir, timeout=SSH_TIMEOUT)
    except SmuxError as exc:
        die(str(exc))
    if result.returncode != 0:
        die(f"{args.host}: sbatch failed: {result.stderr.strip() or result.stdout.strip()}")
    response = result.stdout.strip().splitlines()[-1] if result.stdout.strip() else ""
    job_id = response.split(";", 1)[0]
    if not job_id or not all(char.isdigit() or char in "_+." for char in job_id):
        die(f"{args.host}: could not parse sbatch job id from {response!r}")
    record = {
        "submitted_at": datetime.now(timezone.utc).isoformat(),
        "host": args.host,
        "job_id": job_id,
        "script": args.script,
        "submitted_script": submitted_script,
        "script_source": "remote" if args.remote else "local-upload",
        "script_sha256": script_sha256,
        "chdir": args.chdir,
        "sbatch_args": args.sbatch_arg,
        "script_args": args.script_args,
    }
    append_state(record)
    if args.json:
        print(json.dumps(record, indent=2))
    else:
        print(f"{args.host}:{job_id}")
    if getattr(args, "wait", False):
        # The handle was just printed, so a caller reading stdout still gets
        # it before this blocks. Exit status becomes the job's, which is what
        # makes 'smux submit --wait && ./next-step' mean what it looks like.
        return wait_for(args.host, job_id, interval=args.interval, timeout=None)
    return 0


def wait_for(host: str, job_id: str, *, interval: float, timeout: float | None) -> int:
    """Block until a job leaves the queue. 0 only if it COMPLETED."""
    started = time.monotonic()
    previous = None
    while True:
        try:
            finished, state = job_state(host, job_id)
        except SmuxError as exc:
            die(str(exc))
        if state != previous:
            print(f"{host}:{job_id} {state}", flush=True)
            previous = state
        if finished:
            return 0 if state.startswith("COMPLETED") else 1
        if timeout is not None and time.monotonic() - started >= timeout:
            die(f"timed out waiting for {host}:{job_id}")
        time.sleep(interval)


def validate_job_id(job_id: str) -> None:
    if not job_id or not all(char.isdigit() or char in "_+." for char in job_id):
        die(f"invalid Slurm job id: {job_id}")


def command_show(args: argparse.Namespace) -> int:
    ensure_host(args.host)
    validate_job_id(args.job_id)
    result = run_command(
        args.host,
        ["scontrol", "show", "job", "-o", args.job_id],
        timeout=SSH_TIMEOUT,
    )
    if result.returncode != 0:
        die(f"{args.host}:{args.job_id}: {result.stderr.strip() or 'scontrol failed'}")
    print(result.stdout.rstrip())
    return 0


def job_stdout_path(host: str, job_id: str) -> str:
    result = run_command(
        host,
        ["scontrol", "show", "job", "-o", job_id],
        timeout=SSH_TIMEOUT,
    )
    if result.returncode != 0:
        raise SmuxError(
            f"{host}:{job_id}: {result.stderr.strip() or 'scontrol failed'}"
        )
    match = re.search(r"(?:^|\s)StdOut=(\S+)", result.stdout)
    if not match or match.group(1) in {"(null)", ""}:
        raise SmuxError(f"{host}:{job_id}: Slurm reports no stdout path")
    return match.group(1)


def command_logs(args: argparse.Namespace) -> int:
    ensure_host(args.host)
    validate_job_id(args.job_id)
    if args.lines < 1:
        die("--lines must be >= 1")
    try:
        stdout_path = job_stdout_path(args.host, args.job_id)
    except SmuxError as exc:
        die(str(exc))
    command = ["tail", "-n", str(args.lines)]
    if args.follow:
        command.append("-f")
    command.append(stdout_path)
    if args.follow:
        if args.host == "local":
            return subprocess.run(command, check=False).returncode
        remote = shlex.join(command)
        return subprocess.run(
            ["ssh", *ssh_options(), args.host, remote],
            check=False,
        ).returncode
    result = run_command(args.host, command, timeout=SSH_TIMEOUT)
    if result.returncode != 0:
        die(f"{args.host}:{args.job_id}: {result.stderr.strip() or 'tail failed'}")
    print(result.stdout, end="")
    return 0


def command_cancel(args: argparse.Namespace) -> int:
    ensure_host(args.host)
    validate_job_id(args.job_id)
    result = run_command(
        args.host,
        ["scancel", args.job_id],
        timeout=SSH_TIMEOUT,
    )
    if result.returncode != 0:
        die(f"{args.host}:{args.job_id}: {result.stderr.strip() or 'scancel failed'}")
    print(f"{args.host}:{args.job_id} CANCELLED")
    return 0


def command_cleanup(args: argparse.Namespace) -> int:
    ensure_host(args.host)
    if args.older_than_days < 0:
        die("--older-than-days must be >= 0")
    action = "-delete" if args.apply else "-print"
    script = (
        "set -eu; directory=\"$HOME/.local/state/smux/scripts\"; "
        "[ -d \"$directory\" ] || exit 0; "
        f"find \"$directory\" -maxdepth 1 -type f -mtime +{args.older_than_days} "
        f"-print {action if args.apply else ''}"
    )
    result = run_shell(args.host, script, timeout=SSH_TIMEOUT)
    if result.returncode != 0:
        die(f"{args.host}: cleanup failed: {result.stderr.strip() or result.stdout.strip()}")
    paths = [line for line in result.stdout.splitlines() if line.strip()]
    label = "removed" if args.apply else "would remove"
    for path in paths:
        print(f"{label}: {path}")
    print(
        f"{args.host}: {len(paths)} managed script(s) {label}; "
        f"older than {args.older_than_days} days"
    )
    return 0


def job_state(host: str, job_id: str) -> tuple[bool, str]:
    queued = run_command(host, ["squeue", "-h", "-j", job_id, "-o", "%T"], timeout=SSH_TIMEOUT)
    if queued.returncode == 0 and queued.stdout.strip():
        return False, queued.stdout.strip().splitlines()[0]
    accounting = run_command(
        host,
        ["sacct", "-n", "-X", "-j", job_id, "--format=State", "--parsable2"],
        timeout=SSH_TIMEOUT,
    )
    state = accounting.stdout.strip().split("|", 1)[0].strip() if accounting.returncode == 0 else ""
    return True, state or "LEFT_QUEUE"


def command_wait(args: argparse.Namespace) -> int:
    ensure_host(args.host)
    validate_job_id(args.job_id)
    return wait_for(args.host, args.job_id, interval=args.interval, timeout=args.timeout)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="smux",
        description="Operate several independent Slurm controllers over SSH.",
    )
    parser.add_argument("--version", action="version", version="smux 0.4.0")
    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser("init", help="create a private local host config")
    init_parser.add_argument("--force", action="store_true")
    init_parser.set_defaults(func=command_init)

    edit_parser = subparsers.add_parser("edit", help="edit the private host config")
    edit_parser.set_defaults(func=command_edit)

    hosts_parser = subparsers.add_parser("hosts", help="list configured aliases")
    hosts_parser.add_argument("--json", action="store_true")
    hosts_parser.set_defaults(func=command_hosts)

    status_parser = subparsers.add_parser(
        "status", help="probe Slurm and GPUs, then summarize your jobs"
    )
    status_parser.add_argument("hosts", nargs="*")
    status_parser.add_argument("--json", action="store_true")
    status_parser.set_defaults(func=command_status)

    jobs_parser = subparsers.add_parser("jobs", help="aggregate your queues")
    jobs_parser.add_argument("hosts", nargs="*")
    jobs_parser.add_argument("--json", action="store_true")
    jobs_parser.add_argument("--watch", "-w", action="store_true",
                             help="redraw the queue until interrupted")
    jobs_parser.add_argument("--interval", type=float, default=10.0, metavar="SEC",
                             help="seconds between redraws with --watch (default: 10)")
    jobs_parser.set_defaults(func=command_jobs)

    gpus_parser = subparsers.add_parser(
        "gpus", help="show physical GPU occupancy and Slurm GRES type by index"
    )
    gpus_parser.add_argument("hosts", nargs="*")
    gpus_parser.add_argument("--json", action="store_true")
    gpus_parser.set_defaults(func=command_gpus)

    submit_parser = subparsers.add_parser(
        "submit", help="upload a local script and submit it on one host"
    )
    submit_parser.add_argument("host")
    submit_parser.add_argument("script", help="local script path (uploaded and checksum-verified)")
    submit_parser.add_argument("script_args", nargs="*")
    submit_parser.add_argument("--chdir", help="remote working directory")
    submit_parser.add_argument(
        "--remote",
        action="store_true",
        help="treat SCRIPT as an existing remote path instead of uploading it",
    )
    submit_parser.add_argument(
        "--sbatch-arg",
        action="append",
        default=[],
        help="extra sbatch option; repeat as needed (use --sbatch-arg=--partition=gpu)",
    )
    submit_parser.add_argument("--json", action="store_true")
    submit_parser.add_argument("--wait", action="store_true",
                               help="block until the job leaves the queue; "
                                    "exit status is the job's")
    submit_parser.add_argument("--interval", type=float, default=10.0, metavar="SEC",
                               help="seconds between checks with --wait (default: 10)")
    submit_parser.set_defaults(func=command_submit)

    history_parser = subparsers.add_parser(
        "history", help="submissions smux has recorded")
    history_parser.add_argument("host", nargs="?", help="only this host")
    history_parser.add_argument("--limit", type=int, default=20, metavar="N",
                                help="most recent N (default: 20)")
    history_parser.add_argument("--json", action="store_true")
    history_parser.set_defaults(func=command_history)

    show_parser = subparsers.add_parser("show", help="show one job through scontrol")
    show_parser.add_argument("host")
    show_parser.add_argument("job_id")
    show_parser.set_defaults(func=command_show)

    logs_parser = subparsers.add_parser("logs", help="show or follow a job's Slurm stdout")
    logs_parser.add_argument("host")
    logs_parser.add_argument("job_id")
    logs_parser.add_argument("--lines", type=int, default=50)
    logs_parser.add_argument("--follow", "-f", action="store_true")
    logs_parser.set_defaults(func=command_logs)

    cancel_parser = subparsers.add_parser("cancel", help="cancel one explicit Slurm job ID")
    cancel_parser.add_argument("host")
    cancel_parser.add_argument("job_id")
    cancel_parser.set_defaults(func=command_cancel)

    cleanup_parser = subparsers.add_parser(
        "cleanup", help="list or remove stale smux-uploaded scripts"
    )
    cleanup_parser.add_argument("host")
    cleanup_parser.add_argument("--older-than-days", type=int, default=30)
    cleanup_parser.add_argument(
        "--apply",
        action="store_true",
        help="delete listed files; default is a dry run",
    )
    cleanup_parser.set_defaults(func=command_cleanup)

    wait_parser = subparsers.add_parser("wait", help="wait for one job to leave its queue")
    wait_parser.add_argument("host")
    wait_parser.add_argument("job_id")
    wait_parser.add_argument("--interval", type=float, default=10.0)
    wait_parser.add_argument("--timeout", type=float)
    wait_parser.set_defaults(func=command_wait)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if shutil.which("ssh") is None and any(host != "local" for host in load_hosts(required=False)):
        die("ssh is required for remote hosts")
    try:
        return args.func(args)
    except KeyboardInterrupt:
        print("\nsmux: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
