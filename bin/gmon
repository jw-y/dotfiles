#!/usr/bin/env python3
"""GPU monitor — polls nvidia-smi across SSH hosts and renders a live table."""

import argparse
import math
import os
import selectors
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Optional

# ── Config (defaults; overridable via CLI flags) ──────────────────────────────
CONFIG_FILE = Path("~/.config/gmon/hosts").expanduser()
REFRESH_SECONDS = 3.0
SSH_TIMEOUT = 15
DISK_PATH = "~"  # evaluated on each monitored host
FREE_MEM_MIB = 1024  # a GPU with no users and less VRAM used than this counts as "free"
STALE_FACTOR = 3     # rows dim out if their last good poll is older than STALE_FACTOR × REFRESH_SECONDS
# ─────────────────────────────────────────────────────────────────────────────

QUERY = "name,uuid,index,utilization.gpu,memory.used,memory.total,temperature.gpu"
# Fetches GPU stats then process→user mapping in one snapshot
# Uses gpu_uuid to correlate apps→GPU index (gpu_index not supported on all drivers)
CMD = (
    f"nvidia-smi --query-gpu={QUERY} --format=csv,noheader,nounits 2>/dev/null; "
    "echo '---'; "
    "nvidia-smi --query-compute-apps=gpu_uuid,pid --format=csv,noheader,nounits 2>/dev/null "
    "| while IFS=, read uuid pid; do "
    "  uuid=$(echo $uuid | tr -d ' '); pid=$(echo $pid | tr -d ' '); "
    "  user=$(ps -o user= -p $pid 2>/dev/null | tr -d ' '); "
    "  [ -n \"$user\" ] && echo \"$uuid,$user\"; "
    "done"
)

# Linux host metrics: sample CPU counters across the GPU query plus a short
# interval, including in --once mode. MemAvailable excludes reclaimable cache
# from used RAM. Missing /proc leaves host metrics unavailable.
CPU_SAMPLE = "awk '/^cpu / {for(i=2;i<=9;i++) t+=$i; printf \"%.0f %.0f\\n\", t, $5+$6; exit}' /proc/stat"
CMD = (
    "gmon_cpu_before=''; "
    "if [ -r /proc/stat ] && [ -r /proc/meminfo ]; then "
    f"gmon_cpu_before=$({CPU_SAMPLE}); fi; "
    + CMD + "; echo '---system---'; "
    "if [ -n \"$gmon_cpu_before\" ]; then sleep 0.2; "
    "awk -v before=\"$gmon_cpu_before\" '"
    "/^cpu / {split(before,b); for(i=2;i<=9;i++) t+=$i; "
    "dt=t-b[1]; idle=$5+$6-b[2]; cpu=(dt>0 ? 100*(dt-idle)/dt : -1)} "
    "/^MemTotal:/ {total=$2} /^MemAvailable:/ {available=$2; have_available=1} "
    "END {printf \"%.1f,%.0f,%.0f\\n\", cpu, "
    "(have_available ? total-available : -1), total}' /proc/stat /proc/meminfo; fi"
)


@dataclass
class Snapshot:
    gpus: list
    cpu: Optional[float] = None
    mem_used_kib: Optional[int] = None
    mem_total_kib: Optional[int] = None
    disk_available_kib: Optional[int] = None
    disk_used_percent: Optional[int] = None


def query_command():
    """Quote the path locally, but resolve ~ using the monitored host's HOME."""
    if DISK_PATH == "~":
        path = '"$HOME"'
    elif DISK_PATH.startswith("~/"):
        path = '"$HOME"/' + shlex.quote(DISK_PATH[2:])
    else:
        # Prefix relative paths to keep leading '-' from becoming df flags.
        path = shlex.quote(DISK_PATH if DISK_PATH.startswith("/") else "./" + DISK_PATH)
    return (CMD + "; echo '---disk---'; "
            + f"LC_ALL=C df -Pk {path} 2>/dev/null | "
            + "awk 'NR==2 {print $4 \" , \" $5}'")


def _fg(r, g, b):
    return f"\033[38;2;{r};{g};{b}m"


# Catppuccin Mocha palette (24-bit truecolor)
COLORS = {
    "reset":    "\033[0m",
    "bold":     "\033[1m",
    "red":      _fg(243, 139, 168),  # Red
    "maroon":   _fg(235, 160, 172),  # Maroon
    "rosewater":_fg(245, 224, 220),  # Rosewater
    "peach":    _fg(250, 179, 135),  # Peach
    "yellow":   _fg(249, 226, 175),  # Yellow
    "green":    _fg(166, 227, 161),  # Green
    "teal":     _fg(148, 226, 213),  # Teal
    "sapphire": _fg(116, 199, 236),  # Sapphire
    "blue":     _fg(137, 180, 250),  # Blue
    "lavender": _fg(180, 190, 254),  # Lavender
    "mauve":    _fg(203, 166, 247),  # Mauve
    "pink":     _fg(245, 194, 231),  # Pink
    "text":     _fg(205, 214, 244),  # Text
    "subtext1": _fg(186, 194, 222),  # Subtext1
    "subtext0": _fg(166, 173, 200),  # Subtext0
    "overlay1": _fg(127, 132, 156),  # Overlay1
    "overlay0": _fg(108, 112, 134),  # Overlay0
    "surface2": _fg(88, 91, 112),    # Surface2
}


def c(color, text):
    return f"{COLORS[color]}{text}{COLORS['reset']}"


def cb(color, text):
    return f"{COLORS['bold']}{COLORS[color]}{text}{COLORS['reset']}"


# Rotated per server so adjacent hostnames read as distinct colors
ACCENTS = ["mauve", "blue", "teal", "pink", "lavender", "sapphire"]


def load_config():
    """Read hosts and optional jump host from CONFIG_FILE.

    Format:
        jump=<host>     # optional jump host
        local           # this machine, polled without SSH
        host1
        host2           # inline comments ignored
    """
    if not CONFIG_FILE.exists():
        return [], []

    jump = []
    hosts = []
    for raw in CONFIG_FILE.read_text().splitlines():
        line = raw.split("#")[0].strip()
        if not line:
            continue
        if line.startswith("jump="):
            jump = ["-J", line[5:].strip()]
        else:
            hosts.append(line)
    return hosts, jump


def build_ssh_opts(jump):
    # Reuse one connection per host: the first poll opens a master socket,
    # later polls (and back-to-back gmon runs within ControlPersist) piggyback
    # on it — no repeat TCP+auth handshake. The master self-reaps 30s after
    # the last client disconnects.
    #
    # The socket path must stay under the ~104-byte sun_path limit. macOS's
    # $TMPDIR is ~49 chars and "%C" adds a 40-char hash, which overflows — so
    # anchor at a short, stable per-user dir under /tmp instead.
    ctl_base = "/tmp" if os.path.isdir("/tmp") else tempfile.gettempdir()
    ctl_dir = os.path.join(ctl_base, f"gmon-ssh-{os.getuid()}")
    os.makedirs(ctl_dir, mode=0o700, exist_ok=True)
    return [
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "ConnectTimeout=10",
        "-o", "BatchMode=yes",
        "-o", "ControlMaster=auto",
        "-o", f"ControlPath={ctl_dir}/%C",
        "-o", "ControlPersist=30s",
        *jump,
    ]


# The machine gmon runs on, addressed without SSH. Naming it in the host file
# is how you monitor your own GPUs: listing this box under its own SSH alias
# works, but only if sshd is up and the alias resolves from here, and it spends
# a connection and the timeout budget on data that is already local.
LOCAL_HOST = "local"


def local_names():
    """Names that mean "this machine": the keyword, loopback, and our hostname.

    Writing the box's real hostname in the host file is the obvious thing to
    try, so treat it as local rather than quietly SSH-ing to ourselves. Both
    the short and full forms match, since gethostname() may return either.

    Deliberately no getfqdn() — it can trigger a blocking reverse-DNS lookup,
    and stalling startup to recognize one extra spelling is a bad trade.
    """
    names = {LOCAL_HOST, "localhost"}
    try:
        host = socket.gethostname()
    except OSError:
        return names  # nameless host: the keyword still works
    if host:
        names.add(host.lower())
        names.add(host.split(".", 1)[0].lower())
    return names


LOCAL_NAMES = local_names()


def is_local(host):
    return host.strip().lower() in LOCAL_NAMES


def query_host(host, ssh_opts):
    try:
        argv = ["bash", "-c", query_command()] if is_local(host) else ["ssh", *ssh_opts, host, query_command()]
        result = subprocess.run(
            argv, capture_output=True, text=True, timeout=SSH_TIMEOUT
        )
        if not result.stdout.strip():
            return host, None, "no output"

        return host, parse_snapshot(result.stdout), None
    except subprocess.TimeoutExpired:
        return host, None, "timeout"
    except Exception as e:
        return host, None, str(e)


def parse_snapshot(output):
    output, _, disk_output = output.partition("---disk---\n")
    gpu_output, _, system_output = output.partition("---system---\n")
    sections = gpu_output.strip().split("---\n", 1)
    gpu_lines = sections[0].strip().splitlines()
    proc_lines = sections[1].strip().splitlines() if len(sections) > 1 else []

    uuid_users: dict[str, list[str]] = {}
    for line in proc_lines:
        parts = [p.strip() for p in line.split(",")]
        if len(parts) == 2:
            uuid, user = parts
            uuid_users.setdefault(uuid, [])
            if user and user not in uuid_users[uuid]:
                uuid_users[uuid].append(user)

    gpus = []
    for line in gpu_lines:
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 7:
            continue
        name, uuid, idx, util, mem_used, mem_total, temp = parts[:7]
        gpus.append({
            "name":      name.removeprefix("NVIDIA ").strip(),
            "idx":       idx,
            "util":      _int(util),
            "mem_used":  _int(mem_used),
            "mem_total": _int(mem_total),
            "temp":      _int(temp),
            "users":     uuid_users.get(uuid, []),
        })
    snapshot = Snapshot(gpus)
    try:
        cpu, used, total = system_output.strip().split(",")
        cpu, used, total = float(cpu), int(used), int(total)
        if math.isfinite(cpu) and 0 <= cpu <= 100:
            snapshot.cpu = cpu
        if 0 <= used <= total and total > 0:
            snapshot.mem_used_kib, snapshot.mem_total_kib = used, total
    except ValueError:
        pass
    try:
        available, used_percent = disk_output.strip().split(",")
        available = int(available.strip())
        used_percent = int(used_percent.strip().removesuffix("%"))
        if available >= 0 and 0 <= used_percent <= 100:
            snapshot.disk_available_kib = available
            snapshot.disk_used_percent = used_percent
    except ValueError:
        pass
    return snapshot


def _int(val):
    try:
        return int(val)
    except (ValueError, TypeError):
        return None  # handles [N/A], empty, etc.


def temp_color(val):
    # Normal temps recede (dim); only genuinely hot cards get warm/red
    if val is None:
        return "overlay1"
    if val < 75:
        return "subtext0"
    if val < 88:
        return "peach"
    return "red"


# Eighth-block partial fills, so the bar resolves to ~1% precision at width=10
# instead of snapping to the nearest 10% mark
SUB_BLOCKS = ("", "▏", "▎", "▍", "▌", "▋", "▊", "▉")

# Background painted only behind the partial-block character so its empty
# right half blends into the dotted ░ track instead of showing raw terminal
# bg through. Tuned to Catppuccin surface0, which roughly matches the visual
# average of ░ (surface2 fg) over the typical dark terminal background.
BG_PARTIAL = "\033[48;2;49;50;68m"


def _bar(ratio, color, width, dim):
    """Filled-block bar. ratio=None → empty dim track; otherwise clamped to [0, 1]."""
    if ratio is None:
        return c("surface2", "░" * width)
    eighths = int(max(0.0, min(1.0, ratio)) * width * 8)
    full, rem = divmod(eighths, 8)
    fill = "overlay0" if dim else color
    parts = []
    if full:
        parts.append(c(fill, "█" * full))
    if rem:
        parts.append(f"{COLORS[fill]}{BG_PARTIAL}{SUB_BLOCKS[rem]}{COLORS['reset']}")
    pad = width - full - (1 if rem else 0)
    if pad:
        parts.append(c("surface2", "░" * pad))
    return "".join(parts)


def mem_bar(used, total, width=10, dim=False):
    if used is None or total is None or total == 0:
        return _bar(None, "", width, dim)
    return _bar(used / total, "subtext0", width, dim)


def util_bar(util, width=10, dim=False):
    if util is None:
        return _bar(None, "", width, dim)
    return _bar(util / 100, "subtext0", width, dim)


def is_free(gpu):
    """A GPU with no compute processes and near-empty VRAM is grabbable."""
    return not gpu["users"] and (gpu["mem_used"] or 0) < FREE_MEM_MIB


def compress_indices(indexes):
    """['0','1','2','3'] -> '0-3'; ['0','2','3'] -> '0,2-3'.

    A run of consecutive cards is the common case on an idle host, and
    spelling every index out is what pushes the free list onto its own line.
    Anything non-numeric is passed through untouched rather than guessed at.
    """
    try:
        numbers = sorted(int(i) for i in indexes)
    except (TypeError, ValueError):
        return ",".join(indexes)
    parts, start, previous = [], None, None
    for number in numbers + [None]:
        if start is None:
            start = previous = number
            continue
        if number is not None and number == previous + 1:
            previous = number
            continue
        parts.append(str(start) if start == previous else f"{start}-{previous}")
        start = previous = number
    return ",".join(parts)


def render(results, live=True):
    """Render a frame. `results` is a list of (host, snapshot, err, age_seconds).

    age_seconds is None for one-shot mode or hosts that have never returned;
    otherwise it's seconds since the last *successful* poll for that host.
    """
    now = datetime.now().strftime("%H:%M:%S")
    lines = []

    # Keep configuration/CLI order, including the free-GPU summary.
    snapshots = {host: snapshot for host, snapshot, _, _ in results}
    results = [(host, snapshot.gpus if snapshot is not None else None, err, age)
               for host, snapshot, err, age in results]

    free = {}  # host -> [idx, ...], in configured order
    for host, gpus, *_ in results:
        for gpu in gpus or []:
            if is_free(gpu):
                free.setdefault(host, []).append(gpu["idx"])
    n_free = sum(len(v) for v in free.values())

    # Title and free list on one line when they fit, since two header rows for
    # one sentence is a lot on a short terminal. The indices collapse to ranges
    # first — 'baram:0-3' rather than 'baram:0,1,2,3' — which is what usually
    # makes the difference between fitting and not.
    hint = f"  {REFRESH_SECONDS:g}s  ^C" if live else ""
    if n_free:
        detail = "  ".join(f"{h}:{compress_indices(i)}" for h, i in free.items())
        summary = f"{n_free} GPU{'s' if n_free != 1 else ''} free"
    else:
        detail, summary = "", "no free GPUs"
    width = shutil.get_terminal_size((100, 24)).columns
    one_line = len(f"  {now}  {summary}  {detail}{hint}") <= width
    if one_line:
        lines.append(c("overlay1", f"  {now}  ") + cb("green" if n_free else "overlay1", summary)
                     + c("subtext0", f"  {detail}") + c("overlay0", hint))
    else:
        lines.append(cb("mauve", "  GPU Monitor") + c("overlay1", f"  {now}{hint}"))
        lines.append(cb("green" if n_free else "overlay1", f"  {summary}")
                     + c("subtext0", f"  {detail}"))

    # host/gpu/users size to the widest value present (floored at the header label)
    host_w = max([len("HOST")] + [len(h) for h, _, _, _ in results])
    gpu_w = max([len("GPU")] + [len(g["name"]) for _, gpus, _, _ in results if gpus for g in gpus])
    users_w = max([len("USERS")] + [
        len(", ".join(g["users"]) if g["users"] else "idle")
        for _, gpus, _, _ in results if gpus for g in gpus
    ])
    # util cell = 10-wide bar + space + 6-wide " 100%"  (each block = 10%, matches mem)
    # mem cell  = 10-wide bar + space + 13-wide "used/total" (fits H200's 143771/143771)
    col_w = {"host": host_w, "gpu": gpu_w, "idx": 3, "util": 17, "mem": 24, "temp": 6, "users": users_w}
    header = (
        f"  {'HOST':<{col_w['host']}}  {'GPU':<{col_w['gpu']}}  "
        f"{'#':>{col_w['idx']}}  {'UTIL%':^{col_w['util']}}  "
        f"{'MEMORY (MiB)':^{col_w['mem']}}  {'TEMP':>{col_w['temp']}}  "
        + f"{'USERS':<{col_w['users']}}"
    )
    # No rule under the header: the header is already dimmed away from the
    # data, and a full-width line costs a row to repeat that.
    lines.append(c("subtext0", header))

    for i, (host, gpus, err, age) in enumerate(results):
        # A blank row between hosts. The hostname column and the rotating
        # accent already mark where a group starts, so this is not needed to
        # parse the table — it is needed to read it, and four rows across five
        # clusters is a cheaper way to buy that than anything else here.
        if i:
            lines.append("")
        accent = ACCENTS[i % len(ACCENTS)]  # rotate hostname color per server
        host_cell = cb(accent, f"{host:<{col_w['host']}}")  # blanked after first row

        # No data yet — show connecting/error placeholder
        if gpus is None:
            if err == "connecting":
                msg = c("overlay1", "connecting…")
            elif err:
                msg = c("red", f"error: {err}")
            else:
                msg = c("overlay1", "no data")
            lines.append(f"  {host_cell}  {msg}")
            continue
        stale = age is not None and age > REFRESH_SECONDS * STALE_FACTOR
        snapshot = snapshots[host]
        cpu = f"{snapshot.cpu:.0f}%" if snapshot.cpu is not None else "?"
        ram = (f"{snapshot.mem_used_kib / 1048576:.1f}/{snapshot.mem_total_kib / 1048576:.1f} GiB"
               if snapshot.mem_total_kib is not None else "?")
        disk = (f"{snapshot.disk_available_kib / 1048576:.1f} GiB free ({snapshot.disk_used_percent}% used)"
                if snapshot.disk_available_kib is not None else "?")
        disk_label = "home" if DISK_PATH == "~" else DISK_PATH
        lines.append(f"  {host_cell}  " + c("overlay0" if stale else "subtext0",
                                          f"CPU {cpu}   RAM {ram}   DISK {disk_label} {disk}"))
        host_cell = " " * col_w["host"]
        if not gpus:
            lines.append(f"  {host_cell}  " + c("yellow", "no GPUs / nvidia-smi not found"))

        # Stale rows render uniformly dim; otherwise each cell picks its own color
        dim = lambda vivid: "overlay0" if stale else vivid

        for gpu in gpus:
            util = gpu["util"]
            temp = gpu["temp"]
            mu, mt = gpu["mem_used"], gpu["mem_total"]
            mem_str = f"{mu if mu is not None else '?'}/{mt if mt is not None else '?'}"
            users = gpu.get("users", [])

            name_cell  = c(dim("subtext0"), f"{gpu['name']:<{col_w['gpu']}}")
            idx_cell   = c(dim("overlay1"), f"{gpu['idx']:>{col_w['idx']}}")
            util_text  = (c(dim("subtext0"), f"{util:>5}%") if util is not None
                          else c(dim("overlay1"), "    ?%"))
            mem_cell   = c(dim("subtext1"), f"{mem_str:>13}")
            temp_cell  = (c(dim(temp_color(temp)), f"{temp:>4}°C") if temp is not None
                          else c(dim("overlay1"), "   ?°C"))
            users_cell = (c(dim("subtext1"), ", ".join(users)) if users
                          else c(dim("overlay0"), "idle"))
            ubar = util_bar(util, dim=stale)
            mbar = mem_bar(mu, mt, dim=stale)

            line = (
                f"  {host_cell}  "
                f"{name_cell}  "
                f"{idx_cell}  "
                f"{ubar} {util_text}  "
                f"{mbar} {mem_cell}  "
                f"{temp_cell}  "
                + f"{users_cell}"
            )
            lines.append(line)
            host_cell = " " * col_w["host"]  # only show hostname on first GPU row

        if stale:
            why = f" ({err})" if err else ""
            lines.append("  " + " " * col_w["host"] + "  " + c("overlay1", f"⚠ stale {int(age)}s{why}"))

    # Clear-to-EOL on every line so shorter rows don't leave stale chars behind
    frame = "".join(f"{line}\033[K\n" for line in lines)
    # In the live view the trailing newline is a visible blank row: the cursor
    # ends up below the table, and with it hidden that reads as a bottom
    # margin the frame never asked for. Erase-below then starts at the end of
    # the last row instead. One-shot output keeps the newline, or a shell
    # prompt would resume on top of the final line.
    return frame[:-1] if live else frame


def clear():
    sys.stdout.write("\033[2J\033[H")  # full clear + home, once at startup
    sys.stdout.flush()


def enter_screen():
    sys.stdout.write("\033[?1049h\033[?25l")  # alternate screen + hide cursor
    sys.stdout.flush()


def leave_screen():
    sys.stdout.write("\033[?25h\033[?1049l")  # show cursor + restore screen
    sys.stdout.flush()


def edit_config():
    """Open the hosts file in $EDITOR, seeding a template if it doesn't exist."""
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(
            "# GPU monitor hosts — one SSH host per line\n"
            "# jump=thor       # optional jump host\n"
            f"# {LOCAL_HOST:<14}# this machine, without SSH\n"
            f"# {socket.gethostname().split('.', 1)[0]:<14}# so is this machine's own hostname\n"
            "# namu\n"
        )
    editor = os.environ.get("EDITOR", "vi")
    subprocess.call([editor, str(CONFIG_FILE)])


def poll(hosts, ssh_opts):
    results = []
    with ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        futures = {ex.submit(query_host, h, ssh_opts): h for h in hosts}
        for f in as_completed(futures):
            results.append(f.result())
    by_host = {row[0]: row for row in results}
    return [by_host[host] for host in hosts]


def run_once(hosts, ssh_opts):
    """One snapshot, plain to stdout — for scripting or non-interactive output."""
    results = [(h, g, e, None) for h, g, e in poll(hosts, ssh_opts)]
    sys.stdout.write(render(results, live=False))
    sys.stdout.flush()


# A request/response loop inside ONE shell session. Refreshes write a newline
# to the existing stdin; they never launch another ssh or SSH exec channel.
# EOF on stdin ends the remote loop when gmon exits.
FRAME_END = b"\n__GMON_FRAME_END__\n"
def stream_command():
    return "while IFS= read -r request; do " + query_command() + "; printf '\\n__GMON_FRAME_END__\\n'; done"


def monitor_host(host, ssh_opts, stop, update):
    """Keep a session until it fails; back off 5–60 seconds before reconnecting."""
    retry_delay = 5.0
    while not stop.is_set():
        proc = None
        try:
            argv = (["bash", "-c", stream_command()] if is_local(host) else
                    ["ssh", *ssh_opts, "-T", "-o", "ServerAliveInterval=15",
                     "-o", "ServerAliveCountMax=2", host,
                     "bash -c " + shlex.quote(stream_command())])
            # stderr goes to a file so diagnostics cannot fill a pipe and
            # block the session. Surface the last diagnostic on disconnect.
            with tempfile.TemporaryFile() as errors:
                try:
                    proc = subprocess.Popen(argv, stdin=subprocess.PIPE,
                                            stdout=subprocess.PIPE, stderr=errors)
                    with selectors.DefaultSelector() as selector:
                        selector.register(proc.stdout, selectors.EVENT_READ)
                        pending = b""
                        while not stop.is_set():
                            proc.stdin.write(b"\n")
                            proc.stdin.flush()
                            deadline = time.monotonic() + SSH_TIMEOUT
                            while FRAME_END not in pending:
                                if stop.is_set():
                                    return
                                remaining = deadline - time.monotonic()
                                if remaining <= 0:
                                    raise TimeoutError("timeout")
                                if not selector.select(min(remaining, 0.2)):
                                    continue
                                chunk = os.read(proc.stdout.fileno(), 65536)
                                if not chunk:
                                    raise ConnectionError("session disconnected")
                                pending += chunk
                            snapshot, pending = pending.split(FRAME_END, 1)
                            update(parse_snapshot(snapshot.decode(errors="replace")), None)
                            retry_delay = 5.0
                            if stop.wait(REFRESH_SECONDS):
                                return
                except (ConnectionError, BrokenPipeError) as exc:
                    errors.seek(0, os.SEEK_END)
                    errors.seek(max(0, errors.tell() - 2048))
                    detail = errors.read().decode(errors="replace").strip()
                    raise ConnectionError(detail or "session disconnected") from exc
                finally:
                    if proc is not None:
                        # Closing stdin lets the remote read loop exit even
                        # when the SSH transport is shared with other clients.
                        try:
                            proc.stdin.close()
                        except OSError:
                            pass
                        try:
                            proc.wait(timeout=0.5)
                        except subprocess.TimeoutExpired:
                            proc.terminate()
                            try:
                                proc.wait(timeout=0.5)
                            except subprocess.TimeoutExpired:
                                proc.kill()
                                proc.wait()
                        proc.stdout.close()
        except Exception as exc:
            if not stop.is_set():
                update(None, f"{exc}; retry in {retry_delay:g}s")
        if stop.wait(retry_delay):
            return
        retry_delay = min(retry_delay * 2, 60.0)


def run_loop(hosts, ssh_opts):
    """Live refresh loop with an independent persistent session per host.

    Each host runs its own poll thread and writes into a shared state dict.
    The render loop reads that dict on its own cadence — so one stuck SSH
    can never block the rest of the table; that host's row just dims out
    as "stale" while the others keep refreshing.

    On a failed poll we keep the last-known data (so the user still sees
    the table) but stash the failure reason in `err`, which the render
    surfaces inline as "stale Ns (timeout)" etc.
    """
    # host -> (snapshot_or_None, err_or_None, last_successful_ts_or_None)
    state = {h: (None, "connecting", None) for h in hosts}
    stop = threading.Event()

    def update(host, snapshot, err):
        if snapshot is not None:
            state[host] = (snapshot, None, time.monotonic())
        else:
            prev_snapshot, _, prev_ts = state[host]
            state[host] = (prev_snapshot, err, prev_ts)

    def poller(host):
        monitor_host(host, ssh_opts, stop, lambda snapshot, err: update(host, snapshot, err))

    clear()
    threads = [threading.Thread(target=poller, args=(h,), daemon=True) for h in hosts]
    for thread in threads:
        thread.start()

    try:
        while not stop.is_set():
            now = time.monotonic()
            results = []
            for h in hosts:
                snapshot, err, ts = state[h]
                age = (now - ts) if ts is not None else None
                results.append((h, snapshot, err, age))
            # Home cursor and overwrite in place; clear-below wipes any rows
            # left over from a taller previous frame
            sys.stdout.write("\033[H" + render(results) + "\033[J")
            sys.stdout.flush()
            if stop.wait(REFRESH_SECONDS):
                break
    finally:
        stop.set()
        for thread in threads:
            thread.join()


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="gmon",
        description="GPU monitor — polls nvidia-smi across SSH hosts and renders a live table.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            f"Config file: {CONFIG_FILE}\n"
            "  jump=thor       # optional jump host\n"
            f"  {LOCAL_HOST}           # this machine, polled without SSH\n"
            "  baram           # this machine's own hostname works too\n"
            "  namu\n"
        ),
    )
    p.add_argument("hosts", nargs="*", metavar="HOST",
                   help="hosts to monitor (overrides config file)")
    p.add_argument("-1", "--once", action="store_true",
                   help="print a single snapshot and exit")
    p.add_argument("-e", "--edit", action="store_true",
                   help="edit the hosts config in $EDITOR")
    p.add_argument("-r", "--refresh", type=float, default=REFRESH_SECONDS, metavar="SEC",
                   help=f"refresh interval in seconds (default: {REFRESH_SECONDS:g})")
    p.add_argument("-t", "--timeout", type=int, default=SSH_TIMEOUT, metavar="SEC",
                   help=f"per-host snapshot timeout in seconds (default: {SSH_TIMEOUT})")
    p.add_argument("-f", "--free-mem", type=int, default=FREE_MEM_MIB, metavar="MIB",
                   help=f"MiB used below which an idle GPU counts as free (default: {FREE_MEM_MIB})")
    p.add_argument("--disk-path", default=DISK_PATH, metavar="PATH",
                   help="filesystem path to check on each host (default: remote home)")
    jg = p.add_mutually_exclusive_group()
    jg.add_argument("-j", "--jump", metavar="HOST",
                    help="override the jump host from config")
    jg.add_argument("--no-jump", action="store_true",
                    help="ignore the jump host from config")
    args = p.parse_args(argv)
    if not math.isfinite(args.refresh) or args.refresh <= 0:
        p.error("--refresh must be a finite number greater than zero")
    if args.timeout <= 0:
        p.error("--timeout must be greater than zero")
    if not args.disk_path or any(ord(char) < 32 or ord(char) == 127 for char in args.disk_path):
        p.error("--disk-path must be a nonempty path without control characters")
    return args


def main():
    global REFRESH_SECONDS, SSH_TIMEOUT, FREE_MEM_MIB, DISK_PATH
    args = parse_args(sys.argv[1:])

    if args.edit:
        edit_config()
        return

    REFRESH_SECONDS = args.refresh
    SSH_TIMEOUT = args.timeout
    FREE_MEM_MIB = args.free_mem
    DISK_PATH = args.disk_path

    # One-shot if asked, or whenever stdout isn't a terminal (piped/redirected) —
    # a live refresh loop only makes sense on an interactive screen.
    once = args.once or not sys.stdout.isatty()

    config_hosts, config_jump = load_config()
    if args.jump:
        jump = ["-J", args.jump]
    elif args.no_jump:
        jump = []
    else:
        jump = config_jump

    ssh_opts = build_ssh_opts(jump)

    # CLI args override config file hosts (jump flags above apply either way)
    hosts = list(dict.fromkeys(args.hosts or config_hosts))

    # Validate before entering the alternate screen, otherwise leave_screen()
    # wipes this message before the user can read it.
    if not hosts:
        print(f"No hosts found. Add them to {CONFIG_FILE} or pass as arguments.")
        print("Run 'gmon --edit' to create and edit the config file.")
        sys.exit(1)

    if once:
        run_once(hosts, ssh_opts)
        return

    enter_screen()
    try:
        run_loop(hosts, ssh_opts)
    except KeyboardInterrupt:
        pass
    finally:
        leave_screen()
    print("Bye.")


if __name__ == "__main__":
    main()
