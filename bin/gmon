#!/usr/bin/env python3
"""GPU monitor — polls nvidia-smi across SSH hosts and renders a live table."""

import argparse
import json
import math
import os
import re
import selectors
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Optional

# ── Config (defaults; overridable via CLI flags) ──────────────────────────────
CONFIG_FILE = Path("~/.config/gmon/hosts").expanduser()
REFRESH_SECONDS = 3.0
SSH_TIMEOUT = 15
SHOW_TOPOLOGY = False
GPU_BACKEND = "auto"  # prefer NVML, fall back to nvidia-smi
DISK_PATH = "~"  # evaluated on each monitored host
FREE_MEM_MIB = 1024  # a GPU with no users and less VRAM used than this counts as "free"
STALE_FACTOR = 3     # rows dim out if their last good poll is older than STALE_FACTOR × REFRESH_SECONDS
# ─────────────────────────────────────────────────────────────────────────────

QUERY = "name,uuid,index,utilization.gpu,memory.used,memory.total,temperature.gpu"
# Fetches GPU stats then process→user mapping in one snapshot
# Structured compute records use UUIDs. The full process table supplements
# them with graphics/MPS records keyed by index (no graphics CSV query).
# Bound each probe inside the persistent shell; batch all PID owner lookups.
PROBE_HELPERS = r"""
gmon_run() {
    if command -v timeout >/dev/null 2>&1; then
        timeout --foreground -k 0.2 "$@"
    else
        python3 -c 'import subprocess, sys
try:
    sys.exit(subprocess.run(sys.argv[2:], timeout=float(sys.argv[1])).returncode)
except subprocess.TimeoutExpired:
    sys.exit(124)
except FileNotFoundError:
    sys.exit(127)
' "$@"
    fi
}
gmon_stage() {
    gmon_label=$1; shift
    gmon_run "$gmon_timeout" "$@"
    gmon_rc=$?
    if [ "$gmon_rc" -ne 0 ]; then
        printf '\n!gmon:%s:%s\n' "$gmon_label" "$gmon_rc"
    fi
}
"""
CMD = r"""gmon_stage gpu nvidia-smi --query-gpu=QUERY_FIELDS --format=csv,noheader,nounits
echo '---'
gmon_apps=$( {
    gmon_stage compute nvidia-smi --query-compute-apps=gpu_uuid,pid --format=csv,noheader,nounits
    gmon_stage processes nvidia-smi | awk '
        /^!gmon:/ {print; next}
        /Processes:/ {processes=1}
        processes && $1=="|" && $2 ~ /^[0-9]+$/ {
            for(i=3;i<=NF;i++)
                if($i ~ /^[CGMO]([+][CGMO])*$/ && $(i-1) ~ /^[0-9]+$/) {
                    print "index:" $2 "," $(i-1); break
                }
        }'
} | sort -u)
gmon_pids=$(printf '%s\n' "$gmon_apps" | awk -F, '
    $2 ~ /^[[:space:]]*[0-9]+$/ {gsub(/[[:space:]]/,"",$2); print $2}' | sort -u | paste -sd, -)
gmon_users=''
if [ -n "$gmon_pids" ]; then
    gmon_users=$(gmon_stage owners ps -o pid=,user:256= -p "$gmon_pids")
fi
printf '%s\n' "$gmon_apps" | GMON_OWNERS="$gmon_users" awk -F, '
    BEGIN {
        n=split(ENVIRON["GMON_OWNERS"],lines,"\n")
        for(i=1;i<=n;i++) {
            if(lines[i] ~ /^!gmon:/) {print lines[i]; continue}
            gsub(/^[[:space:]]+|[[:space:]]+$/,"",lines[i])
            split(lines[i],parts,/[[:space:]]+/); users[parts[1]]=parts[2]
        }
    }
    /^!gmon:/ {print; next}
    $2 ~ /^[[:space:]]*[0-9]+$/ {
        gsub(/[[:space:]]/,"",$2)
        print $1 "," (users[$2] != "" ? users[$2] : "unknown (PID " $2 ")")
    }'""".replace("QUERY_FIELDS", QUERY)

GPU_CMD = CMD

# Linux host metrics: sample CPU counters across the GPU query plus a short
# interval, including in --once mode. MemAvailable excludes reclaimable cache
# from used RAM. Missing /proc leaves host metrics unavailable.
CPU_SAMPLE = "awk '/^cpu / {for(i=2;i<=9;i++) t+=$i; printf \"%.0f %.0f\\n\", t, $5+$6; exit}' /proc/stat"
CMD = (
    "gmon_cpu_before=''; "
    "if [ -r /proc/stat ] && [ -r /proc/meminfo ]; then "
    f"gmon_cpu_before=$({CPU_SAMPLE}); fi; "
    + CMD + "; echo '---system---'; "
    "if [ -n \"$gmon_cpu_before\" ]; then sleep 0.2; "
    "awk -v before=\"$gmon_cpu_before\" '"
    "/^cpu / {split(before,b); for(i=2;i<=9;i++) t+=$i; "
    "dt=t-b[1]; idle=$5+$6-b[2]; cpu=(dt>0 ? 100*(dt-idle)/dt : -1)} "
    "/^MemTotal:/ {total=$2} /^MemAvailable:/ {available=$2; have_available=1} "
    "END {printf \"%.1f,%.0f,%.0f\\n\", cpu, "
    "(have_available ? total-available : -1), total}' /proc/stat /proc/meminfo; fi"
)


@dataclass
class Snapshot:
    gpus: list
    cpu: Optional[float] = None
    mem_used_kib: Optional[int] = None
    mem_total_kib: Optional[int] = None
    disk_available_kib: Optional[int] = None
    disk_used_percent: Optional[int] = None
    warnings: list = field(default_factory=list)
    gpu_available: bool = True
    gpu_age: Optional[float] = None
    topology: list = field(default_factory=list)
    topology_pending: bool = False


def query_command(include_topology=True, include_gpu=True):
    """Quote the path locally, but resolve ~ using the monitored host's HOME."""
    if DISK_PATH == "~":
        path = '"$HOME"'
    elif DISK_PATH.startswith("~/"):
        path = '"$HOME"/' + shlex.quote(DISK_PATH[2:])
    else:
        # Prefix relative paths to keep leading '-' from becoming df flags.
        path = shlex.quote(DISK_PATH if DISK_PATH.startswith("/") else "./" + DISK_PATH)
    # One-shot queries prefer NVML too, but reserve time for the CLI fallback
    # and host metrics if initialization takes too long.
    native_budget = max(0.05, SSH_TIMEOUT * 0.5)
    budget = max(0.01, min(3.0, (SSH_TIMEOUT - 1) / 7))
    gpu_command = GPU_CMD if include_gpu else "true"
    if include_gpu and GPU_BACKEND != "smi":
        native = ("printf '\\n' | gmon_run " + str(native_budget)
                  + " python3 -u -c " + shlex.quote(NVML_WORKER))
        fallback = GPU_CMD if GPU_BACKEND == "auto" else "printf '\\n!gmon:gpu:1\\n'"
        gpu_command = (
            "gmon_native=$(" + native + "); gmon_native_rc=$?; "
            "case \"$gmon_native\" in *'!gmon:nvml:'*) gmon_native_rc=1;; esac; "
            "if [ \"$gmon_native_rc\" -eq 0 ]; then printf '%s\\n' \"$gmon_native\"; "
            "else gmon_left=$((gmon_snapshot_budget - (SECONDS - gmon_started))); "
            "gmon_timeout=$(awk -v left=\"$gmon_left\" "
            "'BEGIN {n=left/7; if(n>3)n=3; if(n<0.01)n=0.01; print n}'); "
            + fallback + "; fi")
    command = (PROBE_HELPERS + f"export LC_ALL=C; gmon_timeout={budget:g}; "
               + f"gmon_started=$SECONDS; gmon_snapshot_budget={max(0, SSH_TIMEOUT-1)}; "
               + CMD.replace(GPU_CMD, gpu_command) + "; echo '---disk---'; "
               + f"gmon_stage disk df -Pk {path} 2>/dev/null | "
               + """awk '/^!gmon:/ {print; next} NR==2 {print $4 "," $5}'""")
    if include_topology and SHOW_TOPOLOGY:
        command += "; echo '---topology---'; gmon_stage topology nvidia-smi topo -m"
    return command


def _fg(r, g, b):
    return f"\033[38;2;{r};{g};{b}m"


# Catppuccin Mocha palette (24-bit truecolor)
COLORS = {
    "reset":    "\033[0m",
    "bold":     "\033[1m",
    "red":      _fg(243, 139, 168),  # Red
    "maroon":   _fg(235, 160, 172),  # Maroon
    "rosewater":_fg(245, 224, 220),  # Rosewater
    "peach":    _fg(250, 179, 135),  # Peach
    "yellow":   _fg(249, 226, 175),  # Yellow
    "green":    _fg(166, 227, 161),  # Green
    "teal":     _fg(148, 226, 213),  # Teal
    "sapphire": _fg(116, 199, 236),  # Sapphire
    "blue":     _fg(137, 180, 250),  # Blue
    "lavender": _fg(180, 190, 254),  # Lavender
    "mauve":    _fg(203, 166, 247),  # Mauve
    "pink":     _fg(245, 194, 231),  # Pink
    "text":     _fg(205, 214, 244),  # Text
    "subtext1": _fg(186, 194, 222),  # Subtext1
    "subtext0": _fg(166, 173, 200),  # Subtext0
    "overlay1": _fg(127, 132, 156),  # Overlay1
    "overlay0": _fg(108, 112, 134),  # Overlay0
    "surface2": _fg(88, 91, 112),    # Surface2
}


def c(color, text):
    return f"{COLORS[color]}{text}{COLORS['reset']}"


def cb(color, text):
    return f"{COLORS['bold']}{COLORS[color]}{text}{COLORS['reset']}"


# Rotated per server so adjacent hostnames read as distinct colors
ACCENTS = ["mauve", "blue", "teal", "pink", "lavender", "sapphire"]


def load_config():
    """Read hosts and optional jump host from CONFIG_FILE.

    Format:
        jump=<host>     # optional jump host
        local           # this machine, polled without SSH
        host1
        host2           # inline comments ignored
    """
    if not CONFIG_FILE.exists():
        return [], []

    jump = []
    hosts = []
    for raw in CONFIG_FILE.read_text().splitlines():
        line = raw.split("#")[0].strip()
        if not line:
            continue
        if line.startswith("jump="):
            jump = ["-J", line[5:].strip()]
        else:
            hosts.append(line)
    return hosts, jump


def build_ssh_opts(jump):
    # Reuse one connection per host: the first poll opens a master socket,
    # later polls (and back-to-back gmon runs within ControlPersist) piggyback
    # on it — no repeat TCP+auth handshake. The master self-reaps 30s after
    # the last client disconnects.
    #
    # The socket path must stay under the ~104-byte sun_path limit. macOS's
    # $TMPDIR is ~49 chars and "%C" adds a 40-char hash, which overflows — so
    # anchor at a short, stable per-user dir under /tmp instead.
    ctl_base = "/tmp" if os.path.isdir("/tmp") else tempfile.gettempdir()
    ctl_dir = os.path.join(ctl_base, f"gmon-ssh-{os.getuid()}")
    os.makedirs(ctl_dir, mode=0o700, exist_ok=True)
    return [
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "ConnectTimeout=10",
        "-o", "BatchMode=yes",
        "-o", "ControlMaster=auto",
        "-o", f"ControlPath={ctl_dir}/%C",
        "-o", "ControlPersist=30s",
        *jump,
    ]


# The machine gmon runs on, addressed without SSH. Naming it in the host file
# is how you monitor your own GPUs: listing this box under its own SSH alias
# works, but only if sshd is up and the alias resolves from here, and it spends
# a connection and the timeout budget on data that is already local.
LOCAL_HOST = "local"


def local_names():
    """Names that mean "this machine": the keyword, loopback, and our hostname.

    Writing the box's real hostname in the host file is the obvious thing to
    try, so treat it as local rather than quietly SSH-ing to ourselves. Both
    the short and full forms match, since gethostname() may return either.

    Deliberately no getfqdn() — it can trigger a blocking reverse-DNS lookup,
    and stalling startup to recognize one extra spelling is a bad trade.
    """
    names = {LOCAL_HOST, "localhost"}
    try:
        host = socket.gethostname()
    except OSError:
        return names  # nameless host: the keyword still works
    if host:
        names.add(host.lower())
        names.add(host.split(".", 1)[0].lower())
    return names


LOCAL_NAMES = local_names()


def is_local(host):
    return host.strip().lower() in LOCAL_NAMES


def query_host(host, ssh_opts):
    try:
        argv = ["bash", "-c", query_command()] if is_local(host) else ["ssh", *ssh_opts, host, "bash -c " + shlex.quote(query_command())]
        result = subprocess.run(
            argv, capture_output=True, text=True, timeout=SSH_TIMEOUT
        )
        if not result.stdout.strip():
            return host, None, "no output"

        return host, parse_snapshot(result.stdout), None
    except subprocess.TimeoutExpired:
        return host, None, "timeout"
    except Exception as e:
        return host, None, str(e)


def parse_snapshot(output):
    failed = {}
    clean = []
    for line in output.splitlines():
        if line.startswith("!gmon:"):
            _, label, code = line.split(":", 2)
            failed[label] = code
        else:
            clean.append(line)
    output = "\n".join(clean) + "\n"
    output, _, topology_output = output.partition("---topology---\n")
    output, _, disk_output = output.partition("---disk---\n")
    gpu_output, _, system_output = output.partition("---system---\n")
    sections = gpu_output.strip().split("---\n", 1)
    gpu_lines = sections[0].strip().splitlines()
    proc_lines = sections[1].strip().splitlines() if len(sections) > 1 else []

    uuid_users: dict[str, list[str]] = {}
    for line in proc_lines:
        parts = [p.strip() for p in line.split(",")]
        if len(parts) == 2:
            uuid, user = parts
            uuid_users.setdefault(uuid, [])
            if user and user not in uuid_users[uuid]:
                uuid_users[uuid].append(user)

    gpus = []
    for line in gpu_lines:
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 7:
            continue
        name, uuid, idx, util, mem_used, mem_total, temp = parts[:7]
        gpus.append({
            "name":      name.removeprefix("NVIDIA ").strip(),
            "idx":       idx,
            "util":      _int(util),
            "mem_used":  _int(mem_used),
            "mem_total": _int(mem_total),
            "temp":      _int(temp),
            "users":     list(dict.fromkeys(uuid_users.get(uuid, [])
                                            + uuid_users.get(f"index:{idx}", []))),
        })
    age = failed.pop("age", None)
    snapshot = Snapshot(gpus, gpu_available=not ({"gpu", "pending"} & failed.keys())
                        and not ("collection" in failed and not gpus))
    if age is not None:
        try:
            snapshot.gpu_age = max(0, float(age))
        except ValueError:
            pass
    snapshot.topology = parse_topology(topology_output)
    snapshot.topology_pending = topology_output.strip() == "pending"
    labels = {"gpu": "GPU stats", "compute": "Compute processes",
              "processes": "Graphics processes", "owners": "Owner lookup", "disk": "Disk",
              "pending": "GPU data", "collection": "GPU collection", "host": "Host metrics", "topology": "GPU topology"}
    for label, code in failed.items():
        reason = "pending" if label == "pending" else ("timed out" if code in ("124", "137") else "unavailable")
        snapshot.warnings.append(f"{labels.get(label, label)} {reason}")
    for gpu in gpus:
        gpu["owners_complete"] = not ({"compute", "processes", "owners", "collection"} & failed.keys())

    try:
        cpu, used, total = system_output.strip().split(",")
        cpu, used, total = float(cpu), int(used), int(total)
        if math.isfinite(cpu) and 0 <= cpu <= 100:
            snapshot.cpu = cpu
        if 0 <= used <= total and total > 0:
            snapshot.mem_used_kib, snapshot.mem_total_kib = used, total
    except ValueError:
        pass
    try:
        available, used_percent = disk_output.strip().split(",")
        available = int(available.strip())
        used_percent = int(used_percent.strip().removesuffix("%"))
        if available >= 0 and 0 <= used_percent <= 100:
            snapshot.disk_available_kib = available
            snapshot.disk_used_percent = used_percent
    except ValueError:
        pass
    return snapshot


def parse_topology(output):
    """Keep only the GPU-to-GPU matrix; omit NICs and CPU-affinity columns."""
    header, columns, rows = [], [], []
    # Some driver versions underline the header even when stdout is a pipe.
    output = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", output)
    for line in output.splitlines():
        tokens = line.split()
        if not tokens:
            continue
        if not header:
            columns = [i for i, token in enumerate(tokens)
                       if token.startswith("GPU") and token[3:].isdigit()]
            if columns and columns[0] == 0:
                header = [tokens[i] for i in columns]
            continue
        if tokens[0] in header and len(tokens) > max(columns) + 1:
            cells = [tokens[i + 1] for i in columns]
            if all(cell in ("X", "SYS", "NODE", "PHB", "PXB", "PIX")
                   or (cell.startswith("NV") and cell[2:].isdigit()) for cell in cells):
                rows.append([tokens[0], *cells])
    if not rows or len(rows) != len(header):
        return []
    table = [["", *header], *rows]
    widths = [max(len(row[i]) for row in table) for i in range(len(table[0]))]
    return ["  ".join(f"{cell:>{widths[i]}}" for i, cell in enumerate(row)) for row in table]


def _int(val):
    try:
        return int(val)
    except (ValueError, TypeError):
        return None  # handles [N/A], empty, etc.


def temp_color(val):
    # Normal temps recede (dim); only genuinely hot cards get warm/red
    if val is None:
        return "overlay1"
    if val < 75:
        return "subtext0"
    if val < 88:
        return "peach"
    return "red"


# Eighth-block partial fills, so the bar resolves to ~1% precision at width=10
# instead of snapping to the nearest 10% mark
SUB_BLOCKS = ("", "▏", "▎", "▍", "▌", "▋", "▊", "▉")

# Background painted only behind the partial-block character so its empty
# right half blends into the dotted ░ track instead of showing raw terminal
# bg through. Tuned to Catppuccin surface0, which roughly matches the visual
# average of ░ (surface2 fg) over the typical dark terminal background.
BG_PARTIAL = "\033[48;2;49;50;68m"


def _bar(ratio, color, width, dim):
    """Filled-block bar. ratio=None → empty dim track; otherwise clamped to [0, 1]."""
    if ratio is None:
        return c("surface2", "░" * width)
    eighths = int(max(0.0, min(1.0, ratio)) * width * 8)
    full, rem = divmod(eighths, 8)
    fill = "overlay0" if dim else color
    parts = []
    if full:
        parts.append(c(fill, "█" * full))
    if rem:
        parts.append(f"{COLORS[fill]}{BG_PARTIAL}{SUB_BLOCKS[rem]}{COLORS['reset']}")
    pad = width - full - (1 if rem else 0)
    if pad:
        parts.append(c("surface2", "░" * pad))
    return "".join(parts)


def mem_bar(used, total, width=10, dim=False):
    if used is None or total is None or total == 0:
        return _bar(None, "", width, dim)
    return _bar(used / total, "subtext0", width, dim)


def util_bar(util, width=10, dim=False):
    if util is None:
        return _bar(None, "", width, dim)
    return _bar(util / 100, "subtext0", width, dim)


def is_free(gpu):
    """A GPU with no known users, no activity and near-empty VRAM is grabbable."""
    return (gpu.get("owners_complete", True) and not gpu["users"] and gpu["mem_used"] is not None
            and gpu["mem_used"] < FREE_MEM_MIB and gpu["util"] == 0)


def gpu_users_label(gpu):
    if gpu["users"]:
        return ", ".join(gpu["users"])
    return "idle" if is_free(gpu) else "unknown"


def compress_indices(indexes):
    """['0','1','2','3'] -> '0-3'; ['0','2','3'] -> '0,2-3'.

    A run of consecutive cards is the common case on an idle host, and
    spelling every index out is what pushes the free list onto its own line.
    Anything non-numeric is passed through untouched rather than guessed at.
    """
    try:
        numbers = sorted(int(i) for i in indexes)
    except (TypeError, ValueError):
        return ",".join(indexes)
    parts, start, previous = [], None, None
    for number in numbers + [None]:
        if start is None:
            start = previous = number
            continue
        if number is not None and number == previous + 1:
            previous = number
            continue
        parts.append(str(start) if start == previous else f"{start}-{previous}")
        start = previous = number
    return ",".join(parts)


def host_metrics(snapshot):
    cpu = f"{snapshot.cpu:.0f}%" if snapshot.cpu is not None else "?"
    ram = (f"{snapshot.mem_used_kib / 1048576:.1f}/{snapshot.mem_total_kib / 1048576:.1f} GiB"
           if snapshot.mem_total_kib is not None else "?")
    disk = (f"{snapshot.disk_available_kib / 1048576:.1f} GiB free ({snapshot.disk_used_percent}% used)"
            if snapshot.disk_available_kib is not None else "?")
    disk_label = "home" if DISK_PATH == "~" else DISK_PATH
    return f"CPU {cpu:>4}", f"RAM {ram}", f"DISK {disk_label} {disk}"


def render(results, live=True):
    """Render a frame. `results` is a list of (host, snapshot, err, age_seconds).

    age_seconds is None for one-shot mode or hosts that have never returned;
    otherwise it's seconds since the last *successful* poll for that host.
    """
    now = datetime.now().strftime("%H:%M:%S")
    lines = []

    # Keep configuration/CLI order, including the free-GPU summary.
    snapshots = {host: snapshot for host, snapshot, _, _ in results}
    results = [(host, snapshot.gpus if snapshot is not None else None, err, age)
               for host, snapshot, err, age in results]

    free = {}  # host -> [idx, ...], in configured order
    for host, gpus, *_ in results:
        if (snapshots[host] is None or not snapshots[host].gpu_available
                or (snapshots[host].gpu_age is not None
                    and snapshots[host].gpu_age > REFRESH_SECONDS * STALE_FACTOR)):
            continue
        for gpu in gpus or []:
            if is_free(gpu):
                free.setdefault(host, []).append(gpu["idx"])
    n_free = sum(len(v) for v in free.values())

    # Title and free list on one line when they fit, since two header rows for
    # one sentence is a lot on a short terminal. The indices collapse to ranges
    # first — 'baram:0-3' rather than 'baram:0,1,2,3' — which is what usually
    # makes the difference between fitting and not.
    hint = f"  {REFRESH_SECONDS:g}s  ^C" if live else ""
    if n_free:
        detail = "  ".join(f"{h}:{compress_indices(i)}" for h, i in free.items())
        summary = f"{n_free} GPU{'s' if n_free != 1 else ''} free"
    else:
        detail, summary = "", "no free GPUs"
    width = shutil.get_terminal_size((100, 24)).columns
    one_line = len(f"  {now}  {summary}  {detail}{hint}") <= width
    if one_line:
        lines.append(c("overlay1", f"  {now}  ") + cb("green" if n_free else "overlay1", summary)
                     + c("subtext0", f"  {detail}") + c("overlay0", hint))
    else:
        lines.append(cb("mauve", "  GPU Monitor") + c("overlay1", f"  {now}{hint}"))
        lines.append(cb("green" if n_free else "overlay1", f"  {summary}")
                     + c("subtext0", f"  {detail}"))

    # Size host summary columns across the whole frame before adding colors.
    metrics = {host: host_metrics(snapshot) for host, snapshot in snapshots.items()
               if snapshot is not None}
    metric_widths = [max((len(cells[i]) for cells in metrics.values()), default=0)
                     for i in range(2)]

    # host/gpu/users size to the widest value present (floored at the header label)
    host_w = max([len("HOST")] + [len(h) for h, _, _, _ in results])
    gpu_w = max([len("GPU")] + [len(g["name"]) for _, gpus, _, _ in results if gpus for g in gpus])
    users_w = max([len("USERS")] + [
        len(gpu_users_label(g))
        for _, gpus, _, _ in results if gpus for g in gpus
    ])
    # util cell = 10-wide bar + space + 6-wide " 100%"  (each block = 10%, matches mem)
    # mem cell  = 10-wide bar + space + 13-wide "used/total" (fits H200's 143771/143771)
    col_w = {"host": host_w, "gpu": gpu_w, "idx": 3, "util": 17, "mem": 24, "temp": 6, "users": users_w}
    header = (
        f"  {'HOST':<{col_w['host']}}  {'GPU':<{col_w['gpu']}}  "
        f"{'#':>{col_w['idx']}}  {'UTIL%':^{col_w['util']}}  "
        f"{'MEMORY (MiB)':^{col_w['mem']}}  {'TEMP':>{col_w['temp']}}  "
        + f"{'USERS':<{col_w['users']}}"
    )
    # No rule under the header: the header is already dimmed away from the
    # data, and a full-width line costs a row to repeat that.
    lines.append(c("subtext0", header))

    for i, (host, gpus, err, age) in enumerate(results):
        # A blank row between hosts. The hostname column and the rotating
        # accent already mark where a group starts, so this is not needed to
        # parse the table — it is needed to read it, and four rows across five
        # clusters is a cheaper way to buy that than anything else here.
        if i:
            lines.append("")
        accent = ACCENTS[i % len(ACCENTS)]  # rotate hostname color per server
        host_cell = cb(accent, f"{host:<{col_w['host']}}")  # blanked after first row

        # No data yet — show connecting/error placeholder
        if gpus is None:
            if err == "connecting":
                msg = c("overlay1", "connecting…")
            elif err:
                msg = c("red", f"error: {err}")
            else:
                msg = c("overlay1", "no data")
            lines.append(f"  {host_cell}  {msg}")
            continue
        stale = age is not None and age > REFRESH_SECONDS * STALE_FACTOR
        cpu, ram, disk = metrics[host]
        summary = f"{cpu:<{metric_widths[0]}}   {ram:<{metric_widths[1]}}   {disk}"
        lines.append(f"  {host_cell}  " + c("overlay0" if stale else "subtext0", summary))
        host_cell = " " * col_w["host"]
        snapshot = snapshots[host]
        if snapshot.warnings:
            lines.append(f"  {host_cell}  " + c("overlay0" if stale else "yellow",
                                              "; ".join(snapshot.warnings)))
        if not gpus and snapshot.gpu_available:
            lines.append(f"  {host_cell}  " + c("yellow", "no GPUs / nvidia-smi not found"))

        gpu_stale = (not snapshot.gpu_available or (snapshot.gpu_age is not None
                     and snapshot.gpu_age > REFRESH_SECONDS * STALE_FACTOR))
        if gpu_stale and snapshot.gpus:
            age_text = f" ({snapshot.gpu_age:.0f}s old)" if snapshot.gpu_age is not None else ""
            lines.append(f"  {host_cell}  " + c("yellow", "GPU readings stale" + age_text))
        # Host metrics remain fresh while an old GPU snapshot dims.
        dim = lambda vivid: "overlay0" if stale or gpu_stale else vivid

        for gpu in gpus:
            util = gpu["util"]
            temp = gpu["temp"]
            mu, mt = gpu["mem_used"], gpu["mem_total"]
            mem_str = f"{mu if mu is not None else '?'}/{mt if mt is not None else '?'}"
            users = gpu.get("users", [])

            name_cell  = c(dim("subtext0"), f"{gpu['name']:<{col_w['gpu']}}")
            idx_cell   = c(dim("overlay1"), f"{gpu['idx']:>{col_w['idx']}}")
            util_text  = (c(dim("subtext0"), f"{util:>5}%") if util is not None
                          else c(dim("overlay1"), "    ?%"))
            mem_cell   = c(dim("subtext1"), f"{mem_str:>13}")
            temp_cell  = (c(dim(temp_color(temp)), f"{temp:>4}°C") if temp is not None
                          else c(dim("overlay1"), "   ?°C"))
            users_cell = c(dim("subtext1" if users else "overlay0"), gpu_users_label(gpu))
            ubar = util_bar(util, dim=stale or gpu_stale)
            mbar = mem_bar(mu, mt, dim=stale or gpu_stale)

            line = (
                f"  {host_cell}  "
                f"{name_cell}  "
                f"{idx_cell}  "
                f"{ubar} {util_text}  "
                f"{mbar} {mem_cell}  "
                f"{temp_cell}  "
                + f"{users_cell}"
            )
            lines.append(line)
            host_cell = " " * col_w["host"]  # only show hostname on first GPU row

        if SHOW_TOPOLOGY:
            if snapshot.topology:
                lines.append(f"  {host_cell}  " + c("subtext0", "GPU links"))
                for topology_row in snapshot.topology:
                    lines.append(f"  {host_cell}  " + c("overlay1", topology_row))
                lines.append(f"  {host_cell}  " + c("overlay0",
                    "NV# = NVLink links; PIX/PXB = PCIe switches; PHB/NODE/SYS = CPU/PCIe paths"))
            else:
                status = "pending" if snapshot.topology_pending else "unavailable"
                lines.append(f"  {host_cell}  " + c("overlay1", f"GPU links {status}"))

        if stale:
            why = f" ({err})" if err else ""
            lines.append("  " + " " * col_w["host"] + "  " + c("overlay1", f"⚠ stale {int(age)}s{why}"))

    # Clear-to-EOL on every line so shorter rows don't leave stale chars behind
    frame = "".join(f"{line}\033[K\n" for line in lines)
    # In the live view the trailing newline is a visible blank row: the cursor
    # ends up below the table, and with it hidden that reads as a bottom
    # margin the frame never asked for. Erase-below then starts at the end of
    # the last row instead. One-shot output keeps the newline, or a shell
    # prompt would resume on top of the final line.
    return frame[:-1] if live else frame


def clear():
    sys.stdout.write("\033[2J\033[H")  # full clear + home, once at startup
    sys.stdout.flush()


def enter_screen():
    sys.stdout.write("\033[?1049h\033[?25l")  # alternate screen + hide cursor
    sys.stdout.flush()


def leave_screen():
    sys.stdout.write("\033[?25h\033[?1049l")  # show cursor + restore screen
    sys.stdout.flush()


def edit_config():
    """Open the hosts file in $EDITOR, seeding a template if it doesn't exist."""
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(
            "# GPU monitor hosts — one SSH host per line\n"
            "# jump=thor       # optional jump host\n"
            f"# {LOCAL_HOST:<14}# this machine, without SSH\n"
            f"# {socket.gethostname().split('.', 1)[0]:<14}# so is this machine's own hostname\n"
            "# namu\n"
        )
    editor = os.environ.get("EDITOR", "vi")
    subprocess.call([editor, str(CONFIG_FILE)])


def poll(hosts, ssh_opts):
    results = []
    with ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        futures = {ex.submit(query_host, h, ssh_opts): h for h in hosts}
        for f in as_completed(futures):
            results.append(f.result())
    by_host = {row[0]: row for row in results}
    return [by_host[host] for host in hosts]


def run_once(hosts, ssh_opts):
    """One snapshot, plain to stdout — for scripting or non-interactive output."""
    results = [(h, g, e, None) for h, g, e in poll(hosts, ssh_opts)]
    sys.stdout.write(render(results, live=False))
    sys.stdout.flush()


# One remote agent answers refresh requests through the existing SSH channel.
# Slow GPU collection runs separately from host metrics. EOF stops the agent
# and its probes without launching another SSH process per refresh.
FRAME_END = b"\n__GMON_FRAME_END__\n"
NVML_WORKER = r"""import ctypes as c
import os
import pwd
import sys

class NvmlError(Exception):
    pass

class Memory(c.Structure):
    _fields_ = [("total", c.c_ulonglong), ("free", c.c_ulonglong), ("used", c.c_ulonglong)]

class Utilization(c.Structure):
    _fields_ = [("gpu", c.c_uint), ("memory", c.c_uint)]

class Process(c.Structure):
    # Explicit v2 ABI: never pass this layout to an unversioned/v3 function.
    _fields_ = [("pid", c.c_uint), ("used", c.c_ulonglong),
                ("gpu_instance", c.c_uint), ("compute_instance", c.c_uint)]

class Nvml:
    def __init__(self):
        self.lib = c.CDLL("libnvidia-ml.so.1")
        self.bind("nvmlInit_v2", [])
        self.bind("nvmlShutdown", [])
        self.bind("nvmlDeviceGetCount_v2", [c.POINTER(c.c_uint)])
        self.bind("nvmlDeviceGetHandleByIndex_v2", [c.c_uint, c.POINTER(c.c_void_p)])
        for name in ("Name", "UUID"):
            self.bind("nvmlDeviceGet" + name, [c.c_void_p, c.c_char_p, c.c_uint])
        self.bind("nvmlDeviceGetMemoryInfo", [c.c_void_p, c.POINTER(Memory)])
        self.bind("nvmlDeviceGetUtilizationRates", [c.c_void_p, c.POINTER(Utilization)])
        self.bind("nvmlDeviceGetTemperature", [c.c_void_p, c.c_uint, c.POINTER(c.c_uint)])
        for kind in ("Compute", "Graphics"):
            self.bind("nvmlDeviceGet" + kind + "RunningProcesses_v2",
                      [c.c_void_p, c.POINTER(c.c_uint), c.POINTER(Process)])
        self.call("nvmlInit_v2")
        self.names = {}
        self.uid_names = {}

    def bind(self, name, args):
        func = getattr(self.lib, name)
        func.argtypes = args
        func.restype = c.c_uint

    def call(self, name, *args):
        code = getattr(self.lib, name)(*args)
        if code:
            raise NvmlError(str(code))
        return code

    def text(self, handle, name):
        data = c.create_string_buffer(256)
        self.call("nvmlDeviceGet" + name, handle, data, len(data))
        return data.value.decode(errors="replace")

    def processes(self, handle, kind):
        func = getattr(self.lib, "nvmlDeviceGet" + kind + "RunningProcesses_v2")
        capacity = 32
        for attempt in range(4):
            count = c.c_uint(capacity)
            data = (Process * capacity)()
            code = func(handle, c.byref(count), data)
            if code == 7:  # NVML_ERROR_INSUFFICIENT_SIZE; the list may grow mid-query.
                capacity = max(capacity * 2, count.value + 8)
                continue
            if code:
                raise NvmlError(str(code))
            return [data[i].pid for i in range(count.value)]
        raise NvmlError("process list kept growing")

    def owner(self, pid):
        try:
            with open("/proc/" + str(pid) + "/status") as status:
                for line in status:
                    if line.startswith("Uid:"):
                        uid = int(line.split()[1])
                        if uid not in self.uid_names:
                            try:
                                self.uid_names[uid] = pwd.getpwuid(uid).pw_name
                            except KeyError:
                                self.uid_names[uid] = str(uid)
                        return self.uid_names[uid]
        except (OSError, ValueError):
            pass
        return "unknown (PID " + str(pid) + ")"

    def snapshot(self):
        count = c.c_uint()
        self.call("nvmlDeviceGetCount_v2", c.byref(count))
        rows, processes, warnings = [], [], []
        owners = {}
        for index in range(count.value):
            handle = c.c_void_p()
            self.call("nvmlDeviceGetHandleByIndex_v2", index, c.byref(handle))
            if index not in self.names:
                self.names[index] = (self.text(handle, "Name"), self.text(handle, "UUID"))
            name, uuid = self.names[index]
            memory, util, temperature = Memory(), Utilization(), c.c_uint()
            memory_code = self.lib.nvmlDeviceGetMemoryInfo(handle, c.byref(memory))
            util_code = self.lib.nvmlDeviceGetUtilizationRates(handle, c.byref(util))
            temp_code = self.lib.nvmlDeviceGetTemperature(handle, 0, c.byref(temperature))
            rows.append(",".join(map(str, [
                name, uuid, index, util.gpu if not util_code else "N/A",
                memory.used // 1048576 if not memory_code else "N/A",
                memory.total // 1048576 if not memory_code else "N/A",
                temperature.value if not temp_code else "N/A"])))
            pids = set()
            for kind, label in (("Compute", "compute"), ("Graphics", "processes")):
                try:
                    pids.update(self.processes(handle, kind))
                except NvmlError as exc:
                    warnings.append("!gmon:" + label + ":" + str(exc))
            for pid in sorted(pids):
                if pid not in owners:
                    owners[pid] = self.owner(pid)
                processes.append(uuid + "," + owners[pid])
        return "\n".join(rows + ["---"] + processes + list(dict.fromkeys(warnings))) + "\n"

def main():
    nvml = None
    try:
        nvml = Nvml()
        for request in sys.stdin:
            try:
                output = nvml.snapshot()
            except (NvmlError, OSError, AttributeError):
                output = "!gmon:nvml:1\n"
            sys.stdout.write(output + "\n__GMON_FRAME_END__\n")
            sys.stdout.flush()
    except (OSError, AttributeError, NvmlError):
        sys.stdout.write("!gmon:nvml:127\n\n__GMON_FRAME_END__\n")
        sys.stdout.flush()
    finally:
        if nvml is not None:
            nvml.lib.nvmlShutdown()

if __name__ == "__main__":
    main()
"""

GPU_TIMEOUT = 60.0
LIVE_AGENT = r"""import json, os, selectors, signal, subprocess, sys, threading, time

config = json.loads(sys.argv[1])
stop = threading.Event()
lock = threading.Lock()
children = {}
cache = {"data": "!gmon:pending:0\n", "sampled": None, "topology": "pending"}
gpu_ready = threading.Event()

def capture(command, deadline, label):
    with lock:
        if stop.is_set():
            return ""
        proc = subprocess.Popen(["bash", "-c", command], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                start_new_session=True)
        children[proc] = label
    try:
        output, _ = proc.communicate(timeout=deadline)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            output, _ = proc.communicate(timeout=0.3)
        except subprocess.TimeoutExpired as exc:
            output = exc.output or b""
        output += ("\n!gmon:" + label + ":124\n").encode()
    finally:
        with lock:
            if proc.poll() is not None:
                children.pop(proc, None)
    return output.decode(errors="replace")

nvml_proc = None
nvml_buffer = b""

def nvml_snapshot():
    global nvml_proc, nvml_buffer
    if nvml_proc is None:
        with lock:
            if stop.is_set():
                return ""
            nvml_proc = subprocess.Popen([sys.executable, "-u", "-c", config["nvml"]],
                                         stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, start_new_session=True)
            children[nvml_proc] = "nvml"
    proc = nvml_proc
    proc.stdin.write(b"\n")
    proc.stdin.flush()
    end = b"\n__GMON_FRAME_END__\n"
    deadline = time.monotonic() + config["gpu_timeout"]
    with selectors.DefaultSelector() as selector:
        selector.register(proc.stdout, selectors.EVENT_READ)
        while end not in nvml_buffer:
            if stop.is_set():
                return ""
            if time.monotonic() >= deadline:
                raise TimeoutError("NVML timeout")
            if not selector.select(0.2):
                continue
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError("NVML stopped")
            nvml_buffer += chunk
    output, nvml_buffer = nvml_buffer.split(end, 1)
    output = output.decode(errors="replace")
    if "!gmon:nvml:" in output:
        raise RuntimeError("NVML unavailable")
    return output + "\n"

def close_nvml():
    global nvml_proc, nvml_buffer
    with lock:
        proc, nvml_proc = nvml_proc, None
        nvml_buffer = b""
    if proc is None:
        return
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        proc.wait(timeout=0.2)
    except subprocess.TimeoutExpired:
        pass
    try:
        proc.stdin.close()
    except OSError:
        pass
    proc.stdout.close()
    with lock:
        if proc.poll() is not None:
            children.pop(proc, None)


def collect_gpus():
    last_good = ""
    sampled = None
    backend = config["backend"]
    while not stop.is_set():
        started = time.monotonic()
        if backend == "smi":
            output = capture(config["gpu"], config["gpu_timeout"], "collection")
        else:
            try:
                output = nvml_snapshot()
            except (RuntimeError, TimeoutError, OSError, ValueError):
                close_nvml()
                if backend == "auto":
                    backend = "smi"
                    output = capture(config["gpu"], config["gpu_timeout"], "collection")
                else:
                    output = "!gmon:gpu:1\n"
        # Retain previous GPU readings if the primary statistics probe failed.
        has_rows = any(len(line.split(",")) >= 7 for line in output.split("---", 1)[0].splitlines())
        if "!gmon:gpu:" not in output and has_rows:
            last_good, sampled = output, started
        elif last_good:
            output = last_good + "\n" + "\n".join(
                line for line in output.splitlines() if line.startswith("!gmon:"))
        with lock:
            cache.update(data=output, sampled=sampled)
        gpu_ready.set()
        if stop.wait(config["refresh"]):
            return
        # A driver process stuck in the kernel must not accumulate new probes.
        while not stop.is_set():
            with lock:
                blocked = any(label == "collection" and proc.poll() is None for proc, label in children.items())
            if not blocked:
                break
            stop.wait(0.2)

def collect_topology():
    while not stop.is_set():
        if gpu_ready.wait(0.2):
            break
    if stop.is_set():
        return
    output = capture("LC_ALL=C nvidia-smi topo -m", config["gpu_timeout"], "topology")
    with lock:
        cache["topology"] = output


gpu_thread = threading.Thread(target=collect_gpus, daemon=True)
gpu_thread.start()
if config["topology"]:
    threading.Thread(target=collect_topology, daemon=True).start()
try:
    for request in sys.stdin:
        host = capture(config["host"], config["host_timeout"], "host")
        with lock:
            data, sampled = cache["data"], cache["sampled"]
            topology = "\n---topology---\n" + cache["topology"] if config["topology"] else ""
        age = "" if sampled is None else "\n!gmon:age:" + str(time.monotonic() - sampled) + "\n"
        sys.stdout.write(data + "\n" + host + age + topology + "\n__GMON_FRAME_END__\n")
        sys.stdout.flush()
finally:
    with lock:
        stop.set()
        for proc in children:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    gpu_thread.join(timeout=0.2)
    close_nvml()
"""


def stream_command():
    """One remote Python agent keeps slow GPU collection off the refresh path."""
    config = dict(
        gpu=PROBE_HELPERS + f"export LC_ALL=C; gmon_timeout={GPU_TIMEOUT:g}; " + GPU_CMD,
        gpu_timeout=GPU_TIMEOUT,
        backend=GPU_BACKEND,
        nvml=NVML_WORKER,
        host=query_command(include_topology=False, include_gpu=False),
        topology=SHOW_TOPOLOGY,
        host_timeout=max(0.1, SSH_TIMEOUT * 0.8),
        refresh=REFRESH_SECONDS,
    )
    return "python3 -u -c " + shlex.quote(LIVE_AGENT) + " " + shlex.quote(json.dumps(config))


def monitor_host(host, ssh_opts, stop, update):
    """Keep a session until it fails; back off 5–60 seconds before reconnecting."""
    retry_delay = 5.0
    while not stop.is_set():
        proc = None
        try:
            argv = (["bash", "-c", stream_command()] if is_local(host) else
                    ["ssh", *ssh_opts, "-T", "-o", "ServerAliveInterval=15",
                     "-o", "ServerAliveCountMax=2", host,
                     "bash -c " + shlex.quote(stream_command())])
            # stderr goes to a file so diagnostics cannot fill a pipe and
            # block the session. Surface the last diagnostic on disconnect.
            with tempfile.TemporaryFile() as errors:
                try:
                    proc = subprocess.Popen(argv, stdin=subprocess.PIPE,
                                            stdout=subprocess.PIPE, stderr=errors)
                    with selectors.DefaultSelector() as selector:
                        selector.register(proc.stdout, selectors.EVENT_READ)
                        pending = b""
                        while not stop.is_set():
                            proc.stdin.write(b"\n")
                            proc.stdin.flush()
                            deadline = time.monotonic() + SSH_TIMEOUT
                            while FRAME_END not in pending:
                                if stop.is_set():
                                    return
                                remaining = deadline - time.monotonic()
                                if remaining <= 0:
                                    raise TimeoutError("timeout")
                                if not selector.select(min(remaining, 0.2)):
                                    continue
                                chunk = os.read(proc.stdout.fileno(), 65536)
                                if not chunk:
                                    raise ConnectionError("session disconnected")
                                pending += chunk
                            snapshot, pending = pending.split(FRAME_END, 1)
                            update(parse_snapshot(snapshot.decode(errors="replace")), None)
                            retry_delay = 5.0
                            if stop.wait(REFRESH_SECONDS):
                                return
                except (ConnectionError, BrokenPipeError) as exc:
                    errors.seek(0, os.SEEK_END)
                    errors.seek(max(0, errors.tell() - 2048))
                    detail = errors.read().decode(errors="replace").strip()
                    raise ConnectionError(detail or "session disconnected") from exc
                finally:
                    if proc is not None:
                        # Closing stdin lets the remote read loop exit even
                        # when the SSH transport is shared with other clients.
                        try:
                            proc.stdin.close()
                        except OSError:
                            pass
                        try:
                            proc.wait(timeout=0.5)
                        except subprocess.TimeoutExpired:
                            proc.terminate()
                            try:
                                proc.wait(timeout=0.5)
                            except subprocess.TimeoutExpired:
                                proc.kill()
                                proc.wait()
                        proc.stdout.close()
        except Exception as exc:
            if not stop.is_set():
                update(None, f"{exc}; retry in {retry_delay:g}s")
        if stop.wait(retry_delay):
            return
        retry_delay = min(retry_delay * 2, 60.0)


def run_loop(hosts, ssh_opts):
    """Live refresh loop with an independent persistent session per host.

    Each host runs its own poll thread and writes into a shared state dict.
    The render loop reads that dict on its own cadence — so one stuck SSH
    can never block the rest of the table; that host's row just dims out
    as "stale" while the others keep refreshing.

    On a failed poll we keep the last-known data (so the user still sees
    the table) but stash the failure reason in `err`, which the render
    surfaces inline as "stale Ns (timeout)" etc.
    """
    # host -> (snapshot_or_None, err_or_None, last_successful_ts_or_None)
    state = {h: (None, "connecting", None) for h in hosts}
    stop = threading.Event()

    def update(host, snapshot, err):
        if snapshot is not None:
            state[host] = (snapshot, None, time.monotonic())
        else:
            prev_snapshot, _, prev_ts = state[host]
            state[host] = (prev_snapshot, err, prev_ts)

    def poller(host):
        monitor_host(host, ssh_opts, stop, lambda snapshot, err: update(host, snapshot, err))

    clear()
    threads = [threading.Thread(target=poller, args=(h,), daemon=True) for h in hosts]
    for thread in threads:
        thread.start()

    try:
        while not stop.is_set():
            now = time.monotonic()
            results = []
            for h in hosts:
                snapshot, err, ts = state[h]
                age = (now - ts) if ts is not None else None
                results.append((h, snapshot, err, age))
            # Home cursor and overwrite in place; clear-below wipes any rows
            # left over from a taller previous frame
            sys.stdout.write("\033[H" + render(results) + "\033[J")
            sys.stdout.flush()
            if stop.wait(REFRESH_SECONDS):
                break
    finally:
        stop.set()
        for thread in threads:
            thread.join()


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="gmon",
        description="GPU monitor — polls nvidia-smi across SSH hosts and renders a live table.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            f"Config file: {CONFIG_FILE}\n"
            "  jump=thor       # optional jump host\n"
            f"  {LOCAL_HOST}           # this machine, polled without SSH\n"
            "  baram           # this machine's own hostname works too\n"
            "  namu\n"
        ),
    )
    p.add_argument("hosts", nargs="*", metavar="HOST",
                   help="hosts to monitor (overrides config file)")
    p.add_argument("-1", "--once", action="store_true",
                   help="print a single snapshot and exit")
    p.add_argument("-e", "--edit", action="store_true",
                   help="edit the hosts config in $EDITOR")
    p.add_argument("-r", "--refresh", type=float, default=REFRESH_SECONDS, metavar="SEC",
                   help=f"refresh interval in seconds (default: {REFRESH_SECONDS:g})")
    p.add_argument("-t", "--timeout", type=int, default=SSH_TIMEOUT, metavar="SEC",
                   help=f"per-host snapshot timeout in seconds (default: {SSH_TIMEOUT})")
    p.add_argument("-f", "--free-mem", type=int, default=FREE_MEM_MIB, metavar="MIB",
                   help=f"MiB used below which an idle GPU counts as free (default: {FREE_MEM_MIB})")
    p.add_argument("--disk-path", default=DISK_PATH, metavar="PATH",
                   help="filesystem path to check on each host (default: remote home)")
    p.add_argument("--backend", choices=("auto", "nvml", "smi"), default=GPU_BACKEND,
                   help="GPU collector (default: auto prefers NVML, with nvidia-smi fallback)")
    p.add_argument("--topology", action="store_true",
                   help="show GPU hardware links (NVLink/PCIe); cached once per live session")
    jg = p.add_mutually_exclusive_group()
    jg.add_argument("-j", "--jump", metavar="HOST",
                    help="override the jump host from config")
    jg.add_argument("--no-jump", action="store_true",
                    help="ignore the jump host from config")
    args = p.parse_args(argv)
    if not math.isfinite(args.refresh) or args.refresh <= 0:
        p.error("--refresh must be a finite number greater than zero")
    if args.timeout <= 0:
        p.error("--timeout must be greater than zero")
    if not args.disk_path or any(ord(char) < 32 or ord(char) == 127 for char in args.disk_path):
        p.error("--disk-path must be a nonempty path without control characters")
    return args


def main():
    global REFRESH_SECONDS, SSH_TIMEOUT, FREE_MEM_MIB, DISK_PATH, GPU_BACKEND, SHOW_TOPOLOGY
    args = parse_args(sys.argv[1:])

    if args.edit:
        edit_config()
        return

    REFRESH_SECONDS = args.refresh
    SSH_TIMEOUT = args.timeout
    FREE_MEM_MIB = args.free_mem
    DISK_PATH = args.disk_path
    GPU_BACKEND = args.backend
    SHOW_TOPOLOGY = args.topology

    # One-shot if asked, or whenever stdout isn't a terminal (piped/redirected) —
    # a live refresh loop only makes sense on an interactive screen.
    once = args.once or not sys.stdout.isatty()

    config_hosts, config_jump = load_config()
    if args.jump:
        jump = ["-J", args.jump]
    elif args.no_jump:
        jump = []
    else:
        jump = config_jump

    ssh_opts = build_ssh_opts(jump)

    # CLI args override config file hosts (jump flags above apply either way)
    hosts = list(dict.fromkeys(args.hosts or config_hosts))

    # Validate before entering the alternate screen, otherwise leave_screen()
    # wipes this message before the user can read it.
    if not hosts:
        print(f"No hosts found. Add them to {CONFIG_FILE} or pass as arguments.")
        print("Run 'gmon --edit' to create and edit the config file.")
        sys.exit(1)

    if once:
        run_once(hosts, ssh_opts)
        return

    enter_screen()
    try:
        run_loop(hosts, ssh_opts)
    except KeyboardInterrupt:
        pass
    finally:
        leave_screen()
    print("Bye.")


if __name__ == "__main__":
    main()
