#!/usr/bin/env python3
"""cdx — run Codex under a named account profile (separate CODEX_HOME per account).

Ported from the bash implementation. The behaviour is the contract — every
string, exit code and side effect below is asserted by tests/cdx.test.sh, which
drives this file as a subprocess and therefore never had to know which language
it was written in.

Why Python: the tool already required python3 to start, because the account
column decodes a JWT, the quota column speaks HTTP and JSON, and the typo
suggester ranks edit distances. Three heredocs of Python inside a shell script
is the shell telling you what the program is. The two bugs that cost the most
were both bash-shaped — 'read a b c' silently packing the tail into c, and two
hand-rolled string trims that were meant to be one rule — and neither is
expressible here.

What was lost: 'cdx link' used to run with neither codex nor python3 on PATH,
because a repair command should not depend on the thing it repairs. It now
needs the interpreter it is written in. Every machine this runs on has
python3 3.10+, which is why that trade was acceptable.
"""

from __future__ import annotations

import base64
import gzip
import hashlib
import json
import os
import re
import shutil
import signal
import sqlite3
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from pathlib import Path

SELF = Path(__file__).resolve()
CDX_VERSION = "0.1.3"
DEFAULT_UPDATE_URL = "https://raw.githubusercontent.com/jw-y/dotfiles/main/bin/cdx"
HOME = Path(os.path.expanduser("~"))
PROFILES = Path(os.environ.get("CODEX_PROFILES") or HOME / ".codex-profiles")

# Every Codex client — CLI, desktop app, VS Code, the app's remote bootstrap —
# reads ~/.codex. Once that path is a symlink to a profile, "activating" an
# account is just re-pointing it, and no client needs to know about CODEX_HOME.
# Before 'cdx init' it is still a real directory, which is the 'main' profile.
CODEX_LINK = Path(os.environ.get("CDX_CODEX_LINK")
                  or os.environ.get("CODEX_MAIN_HOME")
                  or HOME / ".codex")

# The store holds the one real copy of everything profiles share. It is NOT a
# profile: it has no credentials, never becomes active, and the leading dot
# keeps it out of the glob that enumerates profiles.
#
# Giving it its own directory is the whole point of the layout. When the store
# lived inside whichever profile happened to be first ('main'), that profile
# was secretly load-bearing: it could not be deleted, renaming it had to
# rewrite every other profile's links, and an out-of-band marker file had to
# record where it went. Here every profile is equal and disposable, and every
# link points at a path that never moves — which is what lets 'cdx link'
# reconstruct any profile's links from scratch at any time.
STORE = PROFILES / ".store"

# Config, shared so settings live in one place, not N copies. Safe to replace
# with a link if a profile has its own: nothing here is unrecoverable. SQLite
# databases are excluded even when rebuildable: their WAL/SHM siblings make a
# file-level symlink unsafe.
SHARED_FILES = ["config.toml", "AGENTS.md", "AGENTS.override.md",
                "instructions.md", "custom-instructions.md",
                "models_cache.json"]

# Same idea, but these hold irreplaceable history, so a real file is never
# overwritten to make room for the link. session_index.jsonl and history.jsonl
# belong here for a subtler reason: the
# names you give threads and the prompts you have typed live *only* in these
# files.
#
# SQLite databases are shared through Codex's sqlite_home setting, never by
# symlinking individual database files. SQLite derives its -wal and -shm paths
# from the spelling used to open the database; linking only the main file can
# split one database across directories and eventually produce
# "file is not a database".
SHARED_DATA = ["session_index.jsonl", "history.jsonl"]

# Version-keyed download caches, identical for every account: the Codex binary
# (packages, ~300M) and the plugin runtime (plugins, ~350M). Sharing these is
# what keeps a profile a few hundred KB instead of ~660M. skills/ is shared so
# what you install is available under every account; sessions/ so conversation
# history follows you across accounts rather than splitting per login.
# attachments/, generated_images/ and visualizations/ are keyed by thread id,
# exactly like the transcripts in sessions/. Keeping them per-profile meant a
# thread resumed under a different account could not find its own files.
SHARED_DIRS = ["packages", "plugins", "cache", "skills", "rules", "sessions",
               "archived_sessions", "attachments", "generated_images",
               "visualizations"]

# cdx deliberately has a hybrid layout: credentials and disposable runtime
# state stay with an account, while config and canonical conversation data are
# shared.  Codex adds top-level state over time, so silently treating every new
# name as either private or shared would eventually lose one of those
# properties.  `cdx doctor` compares the live layout with this dated policy and
# makes additions visible without moving them.  Patterns below are current
# rebuildable/runtime state, not candidates for SHARED_DATA.
STORAGE_POLICY_DATE = "2026-09-08"
KNOWN_PRIVATE_ENTRIES = {
    ".cdx-usage.json", ".codex-global-state.json", ".codex-global-state.json.bak",
    ".personality_migration", ".sandbox_migration", ".tmp", "ambient-suggestions",
    "app-server-control", "app-server-daemon", "auth.json",
    "chrome-native-hosts-v2.json", "cloud-config-bundle-cache.json", "computer-use",
    "dictation-history", "electron", "installation_id", "ipc", "log",
    "mcp-oauth-locks", "pets", "process_manager", "shell_snapshots", "sqlite",
    "thread-writer-locks", "tmp", "transcription-history.jsonl",
    "tui-thread-reference-capabilities", "vendor_imports", "version.json",
}
KNOWN_PRIVATE_PATTERNS = (
    re.compile(r"\.\.codex-global-state\.json\.tmp-.*"),
    re.compile(r"(?:goals|logs|memories|queue|state|thread_history)_\d+\.sqlite(?:-(?:shm|wal))?"),
)

SWITCH_LOCK = PROFILES / ".cdx-switch.lock"
QUOTA_WARN_PERCENT = int(os.environ.get("CDX_QUOTA_WARN") or 90)


# ── colour ───────────────────────────────────────────────────────────────────
# Interactive-only by default. NO_COLOR always wins; JSON never uses it.
class C:
    RESET = RED = GREEN = YELLOW = CYAN = DIM = ""


def _init_color() -> None:
    mode = os.environ.get("CDX_COLOR", "auto")
    if "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb":
        if mode == "auto":
            mode = "always" if sys.stdout.isatty() else "never"
        elif mode not in ("always", "never"):
            sys.stderr.write(
                f"cdx: invalid CDX_COLOR={mode} (use auto, always, or never)\n")
            raise SystemExit(1)
    if mode == "always" and "NO_COLOR" not in os.environ \
            and os.environ.get("TERM") != "dumb":
        C.RESET, C.RED, C.GREEN = "\033[0m", "\033[31m", "\033[32m"
        C.YELLOW, C.CYAN, C.DIM = "\033[33m", "\033[36m", "\033[2m"


def die(message: str) -> "NoReturn":  # type: ignore[valid-type]
    sys.stderr.write(f"{C.RED}cdx: {message}{C.RESET}\n")
    raise SystemExit(1)


def out(text: str = "") -> None:
    sys.stdout.write(text + "\n")


# ── layout ───────────────────────────────────────────────────────────────────
def initialized() -> bool:
    """True once 'cdx init' has replaced ~/.codex with a switchable symlink."""
    return CODEX_LINK.is_symlink()


def stored() -> bool:
    return STORE.is_dir()


def shared_src() -> Path:
    """Where the shared originals actually live.

    Before 'cdx init' there is only ~/.codex; an install predating the store
    still keeps them in 'main'.
    """
    if stored():
        return STORE
    if initialized():
        return PROFILES / "main"
    return CODEX_LINK


def validate_name(name: str) -> None:
    if not name or re.search(r"[^A-Za-z0-9._-]", name):
        die(f"invalid profile name '{name}' (use letters, numbers, '.', '_' or '-')")
    # A leading dot is how cdx marks its own directories (the store, the switch
    # lock). Without this, 'cdx rm .store' would resolve to the store and
    # delete every profile's shared history.
    if name.startswith("."):
        die(f"invalid profile name '{name}' (names starting with '.' are reserved for cdx)")


def home_of(name: str) -> Path:
    if name == "main" and not initialized():
        return CODEX_LINK
    return PROFILES / name


def resolve_dir(path: Path) -> str:
    """Every symlink in the path resolved, or '' when it does not exist."""
    try:
        return str(path.resolve(strict=True)) if path.is_dir() else ""
    except OSError:
        return ""


def active_profile() -> str:
    if not initialized():
        return "main"
    return os.path.basename(os.readlink(CODEX_LINK))


def profile_names() -> list[str]:
    """Pre-migration 'main' is ~/.codex and not under PROFILES; afterwards it
    is an ordinary profile the glob finds, so only add it in the first case."""
    names = [] if initialized() else ["main"]
    if PROFILES.is_dir():
        for entry in sorted(PROFILES.iterdir()):
            if entry.is_dir() and not entry.name.startswith("."):
                names.append(entry.name)
    return names


def suggest_profile(name: str) -> str | None:
    """Closest existing profile to a name that matched nothing — usually a typo.

    Returns the best candidate within edit distance 2. Adjacent-swap counts as
    one edit, since transpositions dominate real typos.
    """
    def dist(a: str, b: str) -> int:
        rows = [list(range(len(b) + 1))]
        for i, ca in enumerate(a, 1):
            rows.append([i] + [0] * len(b))
            for j, cb in enumerate(b, 1):
                best = min(rows[i - 1][j] + 1, rows[i][j - 1] + 1,
                           rows[i - 1][j - 1] + (ca != cb))
                if i > 1 and j > 1 and ca == b[j - 2] and a[i - 2] == cb:
                    best = min(best, rows[i - 2][j - 2] + 1)
                rows[i][j] = best
        return rows[-1][-1]

    cands = profile_names()
    if not cands:
        return None
    best = min(cands, key=lambda c: dist(name.lower(), c.lower()))
    return best if dist(name.lower(), best.lower()) <= 2 else None


def missing_profile(name: str) -> "NoReturn":  # type: ignore[valid-type]
    """What to say when <name> has no profile directory: point at the near-miss
    if there is one, so a typo is not answered with 'cdx add <typo>'."""
    hint = suggest_profile(name)
    if hint:
        die(f"no such profile: {name} (did you mean '{hint}'?)")
    die(f"no such profile: {name} (try 'cdx add {name}')")


# ── locking ──────────────────────────────────────────────────────────────────
_lock_held = False


def release_switch_lock() -> None:
    global _lock_held
    if not _lock_held:
        return
    try:
        (SWITCH_LOCK / "pid").unlink()
    except OSError:
        pass
    try:
        SWITCH_LOCK.rmdir()
    except OSError:
        pass
    _lock_held = False


def acquire_switch_lock() -> None:
    """Serialize account switches so symlink changes and process restarts
    cannot race. mkdir is the atomic primitive, as in the shell version."""
    global _lock_held
    PROFILES.mkdir(parents=True, exist_ok=True)

    def take() -> bool:
        try:
            os.mkdir(SWITCH_LOCK, 0o700)
        except FileExistsError:
            return False
        (SWITCH_LOCK / "pid").write_text(f"{os.getpid()}\n")
        return True

    if take():
        _lock_held = True
        return
    if SWITCH_LOCK.is_symlink():
        die(f"unsafe switch lock is a symlink: {SWITCH_LOCK}")
    owner = ""
    try:
        owner = (SWITCH_LOCK / "pid").read_text().split("\n", 1)[0].strip()
    except OSError:
        pass
    if owner.isdigit():
        try:
            os.kill(int(owner), 0)
            die(f"another cdx switch is running (PID {owner})")
        except ProcessLookupError:
            pass
        except PermissionError:
            die(f"another cdx switch is running (PID {owner})")
    try:
        (SWITCH_LOCK / "pid").unlink()
    except OSError:
        pass
    try:
        SWITCH_LOCK.rmdir()
    except OSError:
        die(f"stale switch lock needs inspection: {SWITCH_LOCK}")
    if not take():
        die(f"could not acquire switch lock: {SWITCH_LOCK}")
    _lock_held = True


# ── permissions ──────────────────────────────────────────────────────────────
def secure_profile(home: Path) -> None:
    """Codex homes contain refresh tokens and account-specific runtime state."""
    if not home.is_dir():
        die(f"profile directory is missing: {home}")
    try:
        os.chmod(home, 0o700)
    except OSError:
        die(f"could not set mode 0700 on {home}")
    auth = home / "auth.json"
    if auth.exists():
        try:
            os.chmod(auth, 0o600)
        except OSError:
            die(f"could not set mode 0600 on {auth}")


def secure_all_profiles() -> None:
    if stored():
        os.chmod(STORE, 0o700)
    if not initialized():
        secure_profile(CODEX_LINK)
    if PROFILES.is_dir():
        for entry in sorted(PROFILES.iterdir()):
            if entry.is_dir() and not entry.name.startswith("."):
                secure_profile(entry)


# ── shared links ─────────────────────────────────────────────────────────────
def links_to(path: Path, want: Path) -> bool:
    """True when path is already the link we would create. A link left over
    from an older layout (pointing into a profile, or at a renamed path) is
    not, and gets re-pointed — that repair is what makes the layout
    reconstructable."""
    return path.is_symlink() and os.readlink(path) == str(want)


def link_shared(home: Path) -> None:
    src = shared_src()
    # The store links to nothing: it is the thing being linked to.
    if home == src:
        return
    for name in SHARED_FILES:
        target, link = src / name, home / name
        if not target.exists() or links_to(link, target):
            continue
        # Safe to clobber: a real file here is a copy Codex wrote over the
        # link (it rewrites config.toml atomically), not unrecoverable data.
        _unlink(link)
        os.symlink(target, link)
    # History: a real file here is this profile's own conversations. Never
    # delete one to make room for the link. A symlink is always safe to
    # re-point, since the data is wherever it points.
    for name in SHARED_DATA:
        target, link = src / name, home / name
        if not target.exists() or links_to(link, target):
            continue
        if link.exists() and not link.is_symlink():
            sys.stderr.write(
                f"cdx: {link} is this profile's own — not shared. Move or\n"
                f"     delete it, then 'cdx link', to join the shared history.\n")
            continue
        _unlink(link)
        os.symlink(target, link)
    # Directories: never remove a real one, since that would be a profile's
    # own data. Leave it alone and say so instead. Replacing a *link* is fine.
    for name in SHARED_DIRS:
        target, link = src / name, home / name
        if not target.is_dir() or links_to(link, target):
            continue
        if link.is_dir() and not link.is_symlink():
            sys.stderr.write(
                f"cdx: {link} is this profile's own directory — left as is\n")
            continue
        _unlink(link)
        os.symlink(target, link)


def known_profile_entry(name: str) -> bool:
    """Whether cdx has made an explicit keep/share decision for this name."""
    if name in KNOWN_PRIVATE_ENTRIES:
        return True
    if name in SHARED_FILES + SHARED_DATA + SHARED_DIRS:
        return True
    if name in {f"{item}{suffix}" for item in SHARED_FILES + SHARED_DATA
                for suffix in ("-shm", "-wal")}:
        return True
    return any(pattern.fullmatch(name) for pattern in KNOWN_PRIVATE_PATTERNS)


def storage_unknowns() -> list[dict[str, str]]:
    """Top-level state introduced since cdx's storage policy was reviewed.

    Unknowns are diagnostic only.  In particular, do not auto-link an SQLite
    file: whether it is canonical state or a rebuildable projection cannot be
    inferred from its extension.
    """
    found: list[dict[str, str]] = []
    roots: list[tuple[str, Path]] = []
    if STORE.is_dir():
        roots.append(("store", STORE))
    if PROFILES.is_dir():
        roots.extend((entry.name, entry) for entry in sorted(PROFILES.iterdir())
                     if entry.is_dir() and not entry.name.startswith("."))
    elif CODEX_LINK.is_dir():
        roots.append(("main", CODEX_LINK))
    for profile, root in roots:
        try:
            entries = sorted(root.iterdir(), key=lambda p: p.name)
        except OSError:
            continue
        for entry in entries:
            if known_profile_entry(entry.name):
                continue
            kind = "symlink" if entry.is_symlink() else "directory" if entry.is_dir() else "file"
            found.append({"profile": profile, "name": entry.name, "kind": kind,
                          "path": str(entry)})
    return found


def sqlite_health() -> list[dict[str, str | bool]]:
    """Read-only quick checks for every real top-level SQLite database."""
    checked: list[dict[str, str | bool]] = []
    seen: set[str] = set()
    configured = configured_sqlite_home()
    roots = ([configured] if configured and configured.is_dir() else [])
    if STORE.is_dir() and STORE not in roots:
        roots.append(STORE)
    if PROFILES.is_dir():
        roots += [entry for entry in sorted(PROFILES.iterdir())
                  if entry.is_dir() and not entry.name.startswith(".")]
    elif CODEX_LINK.is_dir():
        roots.append(CODEX_LINK)
    for root in roots:
        try:
            candidates = sorted(root.glob("*.sqlite"))
        except OSError:
            continue
        for candidate in candidates:
            try:
                resolved = str(candidate.resolve(strict=True))
            except OSError as exc:
                checked.append({"path": str(candidate), "ok": False, "detail": str(exc)})
                continue
            if resolved in seen:
                continue
            seen.add(resolved)
            uri = "file:" + urllib.parse.quote(resolved) + "?mode=ro"
            try:
                db = sqlite3.connect(uri, uri=True, timeout=0.25)
                try:
                    detail = str(db.execute("PRAGMA quick_check(1)").fetchone()[0])
                finally:
                    db.close()
                checked.append({"path": resolved, "ok": detail == "ok", "detail": detail})
            except sqlite3.Error as exc:
                # SQLite may request directory access for locking even in
                # mode=ro. A sandbox can deny that while still allowing the
                # database itself to be read. With no live WAL/SHM sidecars,
                # immutable mode is an equivalent integrity check that does
                # not attempt lock-file access.
                sidecars = (Path(resolved + "-wal"), Path(resolved + "-shm"))
                if str(exc) == "unable to open database file" \
                        and not any(path.exists() for path in sidecars):
                    immutable = uri + "&immutable=1"
                    try:
                        db = sqlite3.connect(immutable, uri=True, timeout=0.25)
                        try:
                            detail = str(db.execute("PRAGMA quick_check(1)").fetchone()[0])
                        finally:
                            db.close()
                        checked.append({"path": resolved, "ok": detail == "ok",
                                        "detail": detail})
                        continue
                    except sqlite3.Error as fallback_exc:
                        exc = fallback_exc
                checked.append({"path": resolved, "ok": False, "detail": str(exc)})
    return checked


def codex_version() -> str:
    try:
        proc = subprocess.run(["codex", "--version"], capture_output=True, text=True,
                              timeout=5)
        return (proc.stdout or proc.stderr).strip() or "unknown"
    except (OSError, subprocess.SubprocessError):
        return "unknown"


def _unlink(path: Path) -> None:
    try:
        path.unlink()
    except OSError:
        pass


def configured_sqlite_home() -> Path | None:
    """Return the absolute sqlite_home selected in the shared config.

    cdx writes an absolute path, so every client on a host resolves the same
    directory regardless of its working directory. A hand-written relative
    value is deliberately left unresolved here because Codex resolves it from
    each process's cwd and therefore cannot be a reliable shared location.
    """
    config = shared_src() / "config.toml"
    try:
        lines = config.read_text().splitlines()
    except OSError:
        return None
    in_top_level = True
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            in_top_level = False
        if not in_top_level:
            continue
        match = re.match(r'^sqlite_home\s*=\s*"((?:[^"\\]|\\.)*)"\s*(?:#.*)?$',
                         stripped)
        if match:
            try:
                value = json.loads('"' + match.group(1) + '"')
            except json.JSONDecodeError:
                return None
            path = Path(os.path.expanduser(value))
            return path if path.is_absolute() else None
    return None


def set_configured_sqlite_home(path: Path) -> None:
    """Set the top-level sqlite_home key without rewriting the user's TOML."""
    config = shared_src() / "config.toml"
    try:
        text = config.read_text()
    except FileNotFoundError:
        text = ""
    except OSError as exc:
        die(f"could not read {config}: {exc}")
    replacement = f"sqlite_home = {json.dumps(str(path))}"
    lines = text.splitlines()
    found = False
    in_top_level = True
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("["):
            in_top_level = False
        if in_top_level and re.match(r"^sqlite_home\s*=", stripped):
            lines[index] = replacement
            found = True
            break
    if not found:
        lines.insert(0, replacement)
    rendered = "\n".join(lines) + "\n"
    temp = config.with_name(config.name + f".cdx-tmp-{os.getpid()}")
    try:
        with temp.open("x") as handle:
            handle.write(rendered)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, config)
    except OSError as exc:
        die(f"could not update {config}: {exc}")
    finally:
        _unlink(temp)


def _sqlite_ok(path: Path) -> tuple[bool, str]:
    try:
        db = sqlite3.connect(str(path), timeout=1)
        try:
            detail = str(db.execute("PRAGMA quick_check(1)").fetchone()[0])
        finally:
            db.close()
        return detail == "ok", detail
    except sqlite3.Error as exc:
        return False, str(exc)


def _sqlite_backup(source: Path, destination: Path) -> None:
    """Create a transactionally consistent copy, including source WAL state."""
    temp = destination.with_name(destination.name + f".cdx-tmp-{os.getpid()}")
    _unlink(temp)
    try:
        src = sqlite3.connect(str(source), timeout=5)
        dst = sqlite3.connect(str(temp), timeout=5)
        try:
            src.backup(dst)
        finally:
            dst.close()
            src.close()
        ok, detail = _sqlite_ok(temp)
        if not ok:
            die(f"SQLite backup of {source} failed integrity check: {detail}")
        os.chmod(temp, 0o600)
        os.replace(temp, destination)
    finally:
        _unlink(temp)


# ── quota ────────────────────────────────────────────────────────────────────
# Live quota, per account. The number Codex shows in '/status' comes from
# GET /wham/usage, which the CLI itself polls while it runs; asking for it
# directly is the only way to get a per-account figure here, because the
# rate_limits recorded in sessions/ carry no account identity and sessions/
# is shared by every profile.
#
# The call doubles as the only trustworthy health check. Token expiry claims
# cannot do that job: every id_token on a working install is long expired
# (Codex refreshes access tokens behind them), so a date column would report
# alarm on accounts that are fine. A 401 here means the refresh token itself
# is dead and the account needs 'cdx add' again — that is worth showing.
USAGE_ENDPOINT = os.environ.get(
    "CDX_USAGE_ENDPOINT", "https://chatgpt.com/backend-api/wham/usage")


def _check_endpoint() -> None:
    """The request carries a live access token, so the destination is checked
    before it is sent anywhere: 'http://' would put the token on the wire in
    clear, and any other scheme is a typo worth catching. 'file://' is how the
    tests point it at a fixture, and reads nothing over the network."""
    if not (USAGE_ENDPOINT.startswith("https://")
            or USAGE_ENDPOINT.startswith("file://")):
        die(f"refusing to send credentials to CDX_USAGE_ENDPOINT={USAGE_ENDPOINT}"
            " (https:// or file:// only)")


class SameHostAuth(urllib.request.HTTPRedirectHandler):
    """urllib replays the original headers on a 30x — it drops only
    content-length and content-type — so a redirect off chatgpt.com would hand
    the access token to whatever host answered. Keep it on redirects that stay
    on the same host, strip it otherwise."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and urllib.parse.urlsplit(newurl).netloc != \
                urllib.parse.urlsplit(req.full_url).netloc:
            new.remove_header("Authorization")
        return new


_opener = urllib.request.build_opener(SameHostAuth)


def _claims(token: str) -> dict:
    try:
        payload = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(
            payload + "=" * (-len(payload) % 4)))
    except Exception:
        return {}


def parse_usage(body: dict) -> dict:
    """The endpoint's response, reduced to what cdx stores and shows.

    Pure: no clock beyond the stamp, no network, no filesystem. This is the
    layer that decides whether an account can run at all, and every mistake
    made about that this month was made here — reading has_credits as
    exhaustion, reporting whichever window happened to be 'primary', missing
    spend_control entirely. Being callable with a dict literal is the point.
    """
    limits = body.get("rate_limit") or {}
    windows = []
    for key in ("primary_window", "secondary_window"):
        w = limits.get(key) or {}
        if w.get("used_percent") is not None:
            windows.append({"used": w["used_percent"], "reset_at": w.get("reset_at"),
                            "seconds": w.get("limit_window_seconds")})
    # 'primary' is not a fixed window: on some plans it is the weekly quota, on
    # others the 5-hour one with the week in 'secondary'. Report whichever sits
    # closest to its limit — that is the one that stops you — and keep the rest.
    head = max(windows, key=lambda w: w["used"]) if windows else {}
    # A percentage measures rate limiting — how fast a rolling window is being
    # spent. It says nothing about a credit balance, which is what a
    # credit-based plan runs out of, and the two disagree by construction: an
    # account with nothing left sits at a LOW percentage precisely because it
    # cannot spend. So the balance is captured whole, and kept.
    #
    # What it is NOT used for is a verdict. 'has_credits: false' reads like
    # 'spent' and actually means 'this account does not use credits at all' —
    # it is what the subscriptions report.
    credits = limits.get("credits") or body.get("credits") or {}
    # The third axis, and the only one that catches an admin-set budget. An
    # account over its monthly credit allowance reports allowed=true,
    # limit_reached=false and a low percentage — every rate-limit field says
    # 'fine' — while refusing to run. spend_control.reached is the one field
    # that says so, and individual_limit stays null when the budget is set on
    # the organisation rather than the user.
    spend = body.get("spend_control") or {}
    return {"fetched_at": time.time(), "used": head.get("used"),
            "reset_at": head.get("reset_at"), "window": head.get("seconds"),
            "windows": windows, "plan": body.get("plan_type"),
            "email": body.get("email"),
            "credits": credits or None, "spend_control": spend or None,
            "state": "spendlimit" if spend.get("reached") else
                     "blocked" if limits.get("limit_reached")
                                  or limits.get("allowed") is False else "ok"}


def _quota(home: Path, token: str | None) -> tuple[dict | None, str]:
    """Cached inside the profile, not the store: it is per-account by definition."""
    mode = os.environ.get("CDX_USAGE", "auto")
    ttl = int(os.environ.get("CDX_USAGE_TTL") or 900)
    force = _quota.force  # type: ignore[attr-defined]
    cache = home / ".cdx-usage.json"
    try:
        cached = json.loads(cache.read_text())
    except Exception:
        cached = None
    if mode == "off" or not token:
        return cached, "cache"
    # 'auto' (the default) re-fetches once the figure ages past the TTL, while
    # 'cache' is the explicit predictable/offline mode that only fills an
    # empty cache and otherwise never calls out.
    if cached and not force and (mode == "cache"
                                 or time.time() - cached.get("fetched_at", 0) < ttl):
        return cached, "cache"
    req = urllib.request.Request(USAGE_ENDPOINT, headers={
        "Authorization": "Bearer " + token, "User-Agent": "cdx"})
    # Accounts are fetched concurrently, and the endpoint can throttle that
    # short burst even though every credential is healthy. Retry only errors
    # which may clear; a rejected credential is final and must not hold up the
    # other accounts. Each worker owns its retry, so one failure never aborts
    # or suppresses another profile's refresh.
    for attempt in range(3):
        try:
            with _opener.open(req, timeout=5) as fh:
                body = json.load(fh)
            break
        except urllib.error.HTTPError as exc:
            # 401/403 is the signal we actually care about: the credentials
            # are no longer usable, whatever the token dates claim.
            if exc.code in (401, 403):
                rec = dict(cached or {})
                rec["state"] = "relogin"
                return rec, "live"
            if exc.code not in (408, 429, 500, 502, 503, 504) or attempt == 2:
                return cached, "offline"
            retry_after = exc.headers.get("Retry-After") if exc.headers else None
            try:
                delay = min(float(retry_after), 5.0) if retry_after else 0.25 * 2 ** attempt
            except (TypeError, ValueError):
                delay = 0.25 * 2 ** attempt
            time.sleep(max(0.0, delay))
        except Exception:
            # Offline, DNS failure, timeout: fall back to whatever we knew.
            return cached, "offline"
    # 'primary' is not a fixed window: on some plans it is the weekly quota, on
    # others the 5-hour one with the week in 'secondary'. Reporting whichever
    # sits in 'primary' made the column mean different things per account, so
    # take the window closest to its limit — that is the one that stops you —
    # and label it, since 16% of a week and 16% of five hours are not the same
    # news. The others are kept so nothing is lost.
    rec = parse_usage(body)
    try:
        tmp = cache.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(rec))
        os.chmod(tmp, 0o600)
        os.replace(tmp, cache)
    except Exception:
        pass
    return rec, "live"


_quota.force = False  # type: ignore[attr-defined]


def span_label(seconds: float) -> str:
    """'wk', '3d', '5h' — the window a percentage belongs to.

    16% of a week and 16% of five hours are not the same news, so the label
    travels with the number everywhere it is shown.
    """
    if seconds >= 604800:
        return "wk"
    if seconds >= 86400:
        return f"{round(seconds / 86400)}d"
    return f"{round(seconds / 3600)}h"


def reset_phrase(epoch: float) -> str:
    """Wall clock first, countdown in parentheses.

    Relative rather than a bare date: the question is "wait it out or switch?",
    and a day-only date answers it wrong precisely when the reset is close — a
    window closing in five hours renders as today's date, which reads as
    already reset. One that has rolled over has no useful clock time left, so
    it is just 'now'.
    """
    left = epoch - time.time()
    if left <= 0:
        return "now"
    if left < 3600:
        rel = f"in {round(left / 60)}m"
    elif left < 86400:
        rel = f"in {round(left / 3600)}h"
    else:
        rel = f"in {round(left / 86400)}d"
    return time.strftime("%b %d %H:%M", time.localtime(epoch)) + f" ({rel})"


def bar(ratio: float, width: int = 10) -> str:
    """Simple whole-cell bar; the adjacent percentage carries the precision.

    Fractional block glyphs render unevenly in common terminal fonts and look
    especially noisy against the shaded track (for example ``▏░░░░░``).
    """
    # int(x + .5) is conventional half-up rounding. Python's round() uses
    # ties-to-even, which made equally exact half-cells lean in alternating
    # directions (25% of six -> 2 cells, 75% -> 4 cells).
    filled = int(max(0.0, min(1.0, ratio)) * width + 0.5)
    return "█" * filled + "░" * (width - filled)


@dataclass
class Row:
    """One account's line. A record rather than a delimited string: the shell
    version packed these into unit-separated fields and read them back
    positionally, which silently shifted every column left the moment a field
    was added."""
    name: str
    kind: str = "-"
    account: str = ""
    plan: str = ""
    used: str = ""
    resets: str = ""
    state: str = ""
    age: int | None = None
    refreshed: str = ""
    note: str = ""
    allowance: str = ""
    # Every window the endpoint reported, not just the binding one. The
    # listing has room for a single figure and shows whichever is closest to
    # its limit; 'status' has room for all of them, and an account can be at
    # 0% of five hours and 84% of the week at the same time.
    windows: list = field(default_factory=list)


def _row(name: str, home: Path) -> Row:
    try:
        auth = json.loads((home / "auth.json").read_text())
    except FileNotFoundError:
        return Row(name, "-", "not logged in", state="none")
    except Exception:
        return Row(name, "-", "unreadable auth.json", state="bad")
    tokens = auth.get("tokens") or {}
    kind = auth.get("auth_mode") or ("apikey" if auth.get("OPENAI_API_KEY") else "?")
    claims = _claims(tokens.get("id_token") or "")
    who = claims.get("email") or (tokens.get("account_id") or "")[:8] or "?"
    plan = (claims.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type") or ""
    rec, src = _quota(home, tokens.get("access_token"))
    rec = rec or {}

    used = resets = ""
    if rec.get("used") is not None:
        # '~' marks a figure we could not refresh, so a stale number is never
        # mistaken for a live one.
        used = f"{round(rec['used'])}%" + ("~" if src == "offline" else "")
        if rec.get("window"):
            used += " " + span_label(rec["window"])
    if rec.get("reset_at"):
        resets = reset_phrase(rec["reset_at"])

    age = int(time.time() - rec["fetched_at"]) if rec.get("fetched_at") else None
    cr = rec.get("credits") or {}
    # Codex models a spend limit as {limit, remaining_percent, resets_at}, but
    # only fills it in for a limit set on the individual. A budget set on the
    # workspace arrives as the bare 'reached' boolean — no numbers exist to
    # show, on this endpoint or any other the CLI knows.
    ind = (rec.get("spend_control") or {}).get("individual_limit") or {}
    state = rec.get("state") or ("none" if not rec else "")

    if state == "relogin":
        note = "re-login"
    elif state == "spendlimit":
        note = "spend limit"
    elif state == "blocked":
        note = "rate limited"
    elif ind.get("remaining_percent") is not None:
        note = f"{round(ind['remaining_percent'])}% budget"
    elif cr.get("unlimited"):
        note = "unlimited"
    elif cr.get("has_credits") is True and cr.get("balance") is not None:
        note = str(cr["balance"])
    else:
        note = ""

    # Spelled out for 'status' only. The listing stays silent when there is no
    # balance to show; a diagnostic is the one place where "the endpoint
    # reports none" beats an empty cell you have to interpret.
    if ind.get("remaining_percent") is not None:
        allowance = f"{round(ind['remaining_percent'])}% of the spend budget left"
        if ind.get("limit"):
            allowance += f" (limit {ind['limit']})"
    elif not cr:
        allowance = "not reported"
    elif cr.get("unlimited"):
        allowance = "unlimited"
    elif cr.get("has_credits") is False:
        allowance = "not used on this plan"
    elif cr.get("balance") is not None:
        allowance = str(cr["balance"])
    else:
        # has_credits true with no balance: the account spends credits but the
        # figure is held by the workspace, not this endpoint.
        allowance = "used, but the balance is not exposed here"

    return Row(name, kind, rec.get("email") or who, rec.get("plan") or plan,
               used, resets, state, age,
               (auth.get("last_refresh") or "?")[:10], note, allowance,
               rec.get("windows") or [])


def profile_rows(names: list[str], *, force: bool = False) -> list[Row]:
    """One request per profile, concurrently: a cold cache costs one timeout
    rather than one per account, and an offline machine stalls once."""
    _quota.force = force  # type: ignore[attr-defined]
    if not names:
        return []
    with ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(lambda n: _row(n, home_of(n)), names))


def roomiest(rows: list["Row"], exclude: str) -> tuple[str, int]:
    """The usable account with the most room left, ignoring `exclude`.

    Only accounts in state 'ok' qualify: one that cannot run is not a place to
    send anyone, however low its percentage reads — and it reads low precisely
    *because* it cannot run.
    """
    best, best_pct = "", 101
    for r in rows:
        pct = pct_of(r.used)
        if r.name != exclude and r.state == "ok" and pct is not None and pct < best_pct:
            best, best_pct = r.name, pct
    return best, best_pct


def pct_of(used: str) -> int | None:
    """The percentage out of a rendered USED cell.

    The cell carries more than the number — a '~' when the figure could not be
    refreshed, and the window it belongs to ('96%~ wk'). One rule, one place:
    the shell version had two, which diverged the moment the window label was
    appended and silently disabled the quota warning.
    """
    head = used.split("%", 1)[0]
    return int(head) if head.isdigit() else None


# ── listing ──────────────────────────────────────────────────────────────────
def list_profiles(argv: list[str]) -> int:
    force = as_json = False
    for arg in argv:
        if arg == "--refresh":
            force = True
        elif arg == "--no-usage":
            os.environ["CDX_USAGE"] = "off"
        elif arg == "--json":
            as_json = True
        else:
            die(f"unknown option to 'list': {arg}")

    names = profile_names()
    active = active_profile()
    rows = profile_rows(names, force=force)

    if as_json:
        # The record, not the rendering: raw percentages and epochs rather
        # than '52% wk' and 'Aug 18 18:17 (in 6d)'. Anything reading this
        # wants to compare numbers, and re-parsing a cell built for a terminal
        # is the mistake this file has already made twice.
        out(json.dumps({
            "active_profile": active,
            "accounts": [{
                "name": r.name,
                "active": r.name == active,
                "auth_mode": r.kind,
                "account": r.account,
                "plan": r.plan,
                "used_percent": pct_of(r.used),
                "window_seconds": next(
                    (w.get("seconds") for w in r.windows
                     if w.get("used") == pct_of(r.used)), None),
                "windows": r.windows,
                "state": r.state,
                "usable": r.state == "ok",
                "note": r.note,
                "allowance": r.allowance,
                "measured_seconds_ago": r.age,
                "credentials_refreshed": r.refreshed or None,
            } for r in rows],
        }, indent=2))
        return 0

    relogin = any(r.state == "relogin" for r in rows)
    # A rejected account may carry an old cached percentage, but the listing
    # replaces it with "re-login" because that quota is no longer meaningful.
    # Its timestamp must not then make every visible figure look stale.
    oldest = max([r.age or 0 for r in rows if r.state != "relogin"], default=0)
    for r in rows:
        # An account that cannot run takes over the USED cell rather than
        # earning a column of its own: the percentage is not what stopped it,
        # so it is not the thing to read. 'status' still gives both.
        if r.state in ("relogin", "blocked", "spendlimit"):
            r.used = r.note
        if r.state == "relogin":
            r.resets = ""

    # How you signed in is 'chatgpt' on every ordinary account, so a column
    # for it is a constant — nine characters saying nothing. It only carries
    # information when it is something else, and then it belongs next to the
    # account it describes rather than in a column of its own. 'not logged in'
    # already says so in the ACCOUNT cell, so a bare '-' adds nothing either.
    for r in rows:
        if r.kind not in ("chatgpt", "-", "", None):
            r.account += f" ({r.kind})"

    # A bar in front of the figure, so relative fullness reads without parsing
    # numbers — the same trick gmon uses for GPU memory, and the reason status
    # gained one per window. Accounts stopped by something a percentage cannot
    # express ('spend limit') keep the words and get blank space where the bar
    # would be, so the column still lines up.
    # Built alongside the row, never written back into it: r.used stays the
    # figure, and everything downstream keeps parsing data rather than a
    # rendered cell. Writing the bar into r.used broke the recommendation
    # below within minutes of being added — the same mistake, twice in one
    # file, is what pct_of() exists to stop.
    BAR_W = 6
    cells: dict[str, str] = {}
    for r in rows:
        pct = pct_of(r.used)
        if pct is not None:
            cells[r.name] = f"{bar(pct / 100, BAR_W)} {r.used}"
        elif r.used:
            cells[r.name] = f"{' ' * BAR_W} {r.used}"
        else:
            cells[r.name] = ""

    # Widths follow the content: fixed ones either truncate a long account or
    # leave a gutter of blanks for everyone who has short ones.
    wn = max([len("NAME")] + [len(r.name) for r in rows])
    wa = max([len("ACCOUNT")] + [len(r.account) for r in rows])
    wp = max([len("PLAN")] + [len(r.plan) for r in rows])
    wu = max([len("USED")] + [len(c) for c in cells.values()])

    out(f"{C.DIM}   {'NAME':<{wn}}  {'ACCOUNT':<{wa}}  "
        f"{'PLAN':<{wp}}  {'USED':>{wu}}  RESETS{C.RESET}")
    for r in rows:
        mark = " *" if r.name == active else "  "
        pct = pct_of(r.used)
        # Colour tracks whichever limit actually stops this account, which is
        # not always the percentage: a spent balance sits at a LOW percentage
        # precisely because it cannot spend. Green means "you can work here"
        # and has to keep meaning exactly that.
        if r.state in ("relogin", "blocked", "spendlimit"):
            color = C.RED
        elif pct is None:
            color = ""
        elif pct >= QUOTA_WARN_PERCENT:
            color = C.RED
        elif pct >= 60:
            color = C.YELLOW
        else:
            color = C.GREEN
        out(f"{mark} {r.name:<{wn}}  {r.account:<{wa}}  "
            f"{C.DIM}{r.plan:<{wp}}{C.RESET}  {color}{cells[r.name]:>{wu}}{C.RESET}  "
            f"{C.DIM}{r.resets}{C.RESET}")

    # A failed automatic refresh or explicit cache mode can still leave an old
    # figure, so state its age — an unlabelled percentage reads as current.
    if oldest >= 300:
        ago = (f"{oldest // 60}m" if oldest < 3600 else
               f"{oldest // 3600}h" if oldest < 86400 else f"{oldest // 86400}d")
        out(f"{C.YELLOW}   quota measured {ago} ago — 'cdx --refresh' "
            f"for live figures{C.RESET}")
    # The listing exists to answer "where should I work?", and that question
    # only has an answer worth printing when the account you are on cannot do
    # it. Silence means the active account is fine — the same rule the columns
    # follow, so a healthy listing stays four lines.
    here = next((r for r in rows if r.name == active), None)
    if here is not None:
        here_pct = pct_of(here.used)
        stuck = here.state in ("relogin", "blocked", "spendlimit")
        if stuck or (here_pct is not None and here_pct >= QUOTA_WARN_PERCENT):
            best, best_pct = roomiest(rows, active)
            # Somewhere fuller than where you already are is not a
            # recommendation. An account that cannot run at all is the
            # exception: anything usable beats it.
            if best and not stuck and here_pct is not None and best_pct >= here_pct:
                best = ""
            why = here.note if stuck else f"{here_pct}% used"
            if best:
                out(f"{C.YELLOW}   {active} is at {why} — '{best}' has the most "
                    f"room ({best_pct}% used): 'cdx use {best}'{C.RESET}")
            else:
                out(f"{C.YELLOW}   {active} is at {why}, and no other account "
                    f"has room{C.RESET}")

    if relogin:
        out(f"\n{C.YELLOW}(re-login: the account was rejected — its refresh "
            f"token is dead.{C.RESET}")
        out(f'{C.YELLOW} run "cdx add <name>" to sign in again.){C.RESET}')
    if not initialized():
        out(f"\n({CODEX_LINK} is a plain directory — run 'cdx init' to enable switching)")
    elif legacy_layout():
        # Non-fatal: listing accounts still works fine on the old layout. Only
        # the commands that depend on the store refuse outright.
        out(f"\n{C.YELLOW}(no shared store — {PROFILES / 'main'} still holds it; "
            f"'cdx link' explains the fix){C.RESET}")
    return 0


# ── process inspection ───────────────────────────────────────────────────────
def profile_from_control_path(path: str) -> str | None:
    """Map an app-server control/log path back to its owning profile."""
    prefix = f"{PROFILES}/"
    if path.startswith(prefix) and "/app-server-control/" in path:
        return path[len(prefix):].split("/", 1)[0]
    if path.startswith(f"{CODEX_LINK}/app-server-control/"):
        return active_profile()
    return None


def open_paths(pid: int) -> list[str]:
    """Every filesystem path a process currently has open.

    /proc is authoritative where it exists and resolves each fd to its real
    path, which is what lets a caller recognise a file reached through the
    moving ~/.codex symlink. macOS has no /proc, so lsof stands in; its -Fn
    format gives one n-prefixed path per line.
    """
    fd_dir = Path(f"/proc/{pid}/fd")
    if fd_dir.is_dir():
        paths = []
        try:
            for fd in fd_dir.iterdir():
                try:
                    paths.append(os.readlink(fd))
                except OSError:
                    pass
        except OSError:
            pass
        return paths
    if not shutil.which("lsof"):
        return []
    proc = subprocess.run(["lsof", "-a", "-p", str(pid), "-Fn"],
                          capture_output=True, text=True)
    return [line[1:] for line in proc.stdout.splitlines() if line.startswith("n")]


def app_server_profile(pid: int) -> str:
    """Inspect open control-socket descriptors instead of trusting CODEX_HOME:
    a long-running process may have inherited the moving ~/.codex symlink."""
    for target in PROCS.open_paths(pid):
        owner = profile_from_control_path(target)
        if owner:
            return owner
    return "unknown"


class Processes:
    """Everything cdx knows about other processes, in one place.

    Which PIDs to signal is the only decision here that cannot be sandboxed by
    an environment variable — pgrep sees the whole user's process table, so a
    mistake in the path filter reaches real Codex sessions however isolated the
    profiles are. CDX_NO_KILL exists for exactly that reason and is the reason
    no test has ever run the signalling path.

    Behind this seam the selection logic can be handed a process table that
    does not exist: a proxy that is not bound, a server holding a file under
    the old profile, a PID that exits mid-scan. Nothing else about the class
    matters — it is four thin wrappers.
    """

    def matching(self, pattern: str) -> list[int]:
        proc = subprocess.run(["pgrep", "-u", self.username(), "-f", pattern],
                              capture_output=True, text=True)
        return [int(p) for p in proc.stdout.split() if p.isdigit()]

    def username(self) -> str:
        proc = subprocess.run(["id", "-un"], capture_output=True, text=True)
        return proc.stdout.strip()

    def cmdline(self, pid: int) -> str:
        try:
            return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode()
        except OSError:
            proc = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                                  capture_output=True, text=True)
            return proc.stdout.strip()

    def open_paths(self, pid: int) -> list[str]:
        return open_paths(pid)

    def terminate(self, pid: int) -> None:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass

    def force_kill(self, pid: int) -> None:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass

    def alive(self, pid: int) -> bool:
        # kill(pid, 0) also succeeds for a zombie. Treat it as exited: no code
        # or file handles remain, and only its parent can reap the process-table
        # entry. Counting zombies as survivors produced false timeout errors.
        try:
            tail = Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1]
            if tail.split(None, 1)[0] == "Z":
                return False
        except (OSError, IndexError):
            pass
        try:
            os.kill(pid, 0)
            return True
        except OSError:
            return False


PROCS = Processes()


def pgrep(pattern: str) -> list[int]:
    return PROCS.matching(pattern)


@dataclass(frozen=True)
class AppServerLifecycle:
    """How the active profile's app-server was launched.

    The daemon owns a server only when its pidfile names that live PID.
    Command-line shape alone is insufficient: a foreground remote-control
    server also carries --remote-control, and a stale daemon can outlive its
    pidfile.
    """

    mode: str
    remote_status: str
    configured: bool
    managed_pid: int | None
    managed_remote: bool

    @property
    def problem(self) -> bool:
        return (self.remote_status == "configured" and self.mode != "stopped") \
            or (self.remote_status == "enabled" and self.mode == "unmanaged")


def read_pid(path: Path) -> int | None:
    try:
        value = path.read_text().strip()
        if value.isdigit():
            return int(value)
        payload = json.loads(value)
        pid = payload.get("pid")
        return pid if isinstance(pid, int) and not isinstance(pid, bool) else None
    except (OSError, ValueError, AttributeError):
        return None


def remote_control_configured(home: Path) -> bool:
    try:
        settings = json.loads((home / "app-server-daemon/settings.json").read_text())
        return settings.get("remoteControlEnabled") is True
    except (OSError, ValueError, AttributeError):
        return False


def app_server_lifecycle(home: Path, server_pids: list[int]) -> AppServerLifecycle:
    """Classify live servers against one profile's daemon state."""
    managed_pid = read_pid(home / "app-server-daemon/app-server.pid")
    commands = {pid: PROCS.cmdline(pid) for pid in server_pids}
    remote_pids = {pid for pid, cmd in commands.items()
                   if "app-server" in cmd and "--remote-control" in cmd}
    managed_running = managed_pid is not None and managed_pid in server_pids
    configured = remote_control_configured(home)
    if not server_pids:
        mode = "stopped"
    elif managed_running:
        mode = "persistent"
    elif remote_pids:
        mode = "unmanaged"
    else:
        mode = "ephemeral"
    if remote_pids:
        remote_status = "enabled"
    elif configured:
        remote_status = "configured"
    else:
        remote_status = "off"
    return AppServerLifecycle(
        mode=mode,
        remote_status=remote_status,
        configured=configured,
        managed_pid=managed_pid,
        managed_remote=managed_running and managed_pid in remote_pids,
    )


def remote_control_label(state: AppServerLifecycle) -> str:
    if state.remote_status == "enabled":
        owner = "managed" if state.managed_remote else "unmanaged"
        return f"enabled — {owner}"
    if state.remote_status == "configured":
        if state.mode == "stopped":
            return "configured — server stopped"
        return f"configured — blocked by {state.mode} server"
    if state.mode == "ephemeral":
        return "off — close SSH clients before enabling"
    return "off"


# ── status ───────────────────────────────────────────────────────────────────
def section(title: str) -> None:
    out(f"\n{C.CYAN}{title}{C.RESET}")


def row(label: str, value: str) -> None:
    out(f"  {label:<13} {value}")


def tilde(path: str) -> str:
    """Paths here are long and mostly $HOME. Shortening keeps the value column
    from wrapping, which is what made the old output hard to read."""
    home = str(HOME)
    return "~" + path[len(home):] if path.startswith(home + "/") else path


def cmd_status(argv: list[str]) -> int:
    as_json = False
    subject = ""
    for arg in argv:
        if arg == "--json":
            as_json = True
        elif arg.startswith("-"):
            die(f"unknown option to 'status': {arg}")
        elif subject:
            die("status takes one profile name")
        else:
            subject = arg

    active = active_profile()
    # The Clients section and the verdict are always about the active profile:
    # they describe what is running on this machine, which does not change
    # because you asked about another account.
    if subject:
        validate_name(subject)
        home = home_of(subject)
        if not home.is_dir():
            missing_profile(subject)
    else:
        subject = active
        home = home_of(active)

    # Cached figure only: status is a diagnostic that must work offline, and
    # 'cdx --refresh' is right there when a live number is wanted.
    saved = os.environ.get("CDX_USAGE")
    os.environ["CDX_USAGE"] = "off"
    try:
        r = profile_rows([subject])[0]
    finally:
        if saved is None:
            os.environ.pop("CDX_USAGE", None)
        else:
            os.environ["CDX_USAGE"] = saved

    account = r.account + (f" ({r.kind})" if r.kind else "") + (f" {r.plan}" if r.plan else "")
    # The listing's compact '43% wk' is a column heading's worth of context;
    # here there is room for the sentence it stands for.
    if r.used:
        head, _, span = r.used.partition(" ")
        if span == "wk":
            span_text = " of the weekly limit"
        elif not span:
            span_text = ""
        else:
            span_text = f" of the {span.replace('h', '-hour')} limit"
        quota = f"{head}{span_text}, resets {r.resets}"
    else:
        quota = "unknown — run 'cdx --refresh'"
    # The rate limit is not always what stopped the account, so say which one
    # it is rather than letting the percentage answer for both.
    verdict = ""
    if r.state == "spendlimit":
        verdict = (f"{C.RED}over its spend limit — cannot run regardless "
                   f"of the above{C.RESET}")
    elif r.state == "blocked":
        quota += f" {C.RED}(rate limited now){C.RESET}"
    refreshed = r.refreshed or "never"

    session_store = resolve_dir(home / "sessions") or "missing"
    state_file = home / "state_5.sqlite"
    if state_file.is_symlink():
        state_store = f"shared -> {os.readlink(state_file)}"
    elif state_file.exists():
        state_store = str(state_file)
    else:
        state_store = "missing"

    # Display forms only — the JSON keeps the full paths, since a consumer has
    # no way to expand 'shared' back into one.
    session_disp = "shared" if session_store.startswith(f"{STORE}/") else tilde(session_store)
    state_disp = "shared" if state_store.startswith(f"shared -> {STORE}/") else tilde(state_store)

    server_pids = pgrep(r"[cC]odex.*app-server.*--listen[ =]unix://")
    proxy_count = len(pgrep(r"(^|/)codex app-server proxy( |$)"))
    lifecycle = app_server_lifecycle(home_of(active), server_pids)

    mismatch = False
    server_rows: list[tuple[int, str]] = []
    server_lines: list[str] = []
    if not server_pids:
        server_lines.append(f"  {'app server':<13} not running")
        if proxy_count:
            mismatch = True
    else:
        for pid in server_pids:
            # A persistent server need not keep an open profile file. Its
            # daemon pidfile is the stronger ownership proof in that case.
            owner = active if pid == lifecycle.managed_pid else app_server_profile(pid)
            server_rows.append((pid, owner))
            if owner == active:
                server_lines.append(
                    f"  {'app server':<13} PID {pid} — {owner} {C.GREEN}(matches){C.RESET}")
            else:
                server_lines.append(
                    f"  {'app server':<13} PID {pid} — {owner} {C.RED}(MISMATCH){C.RESET}")
                mismatch = True

    duplicate_servers = sum(owner == active for _, owner in server_rows) > 1

    if not as_json:
        section("Account")
        if subject == active:
            row("profile", f"{C.CYAN}{subject}{C.RESET}")
        else:
            # Say it plainly: every other section still describes the machine,
            # so a reader must not take this for the account in use.
            row("profile", f"{C.CYAN}{subject}{C.RESET} "
                           f"{C.YELLOW}(not active — '{active}' is){C.RESET}")
        row("signed in", r.account + (f" — {r.kind}" if r.kind else "")
                         + (f", {r.plan}" if r.plan else ""))
        row("quota", quota)
        # Every window, not just the binding one. An account can sit at 0% of
        # its five-hour window and 84% of its week at the same time, and the
        # single figure above can only report one of them. Only worth the
        # lines when there is more than one to compare.
        if len(r.windows) > 1:
            # The one the headline figure came from — the closest to its
            # limit, which is the one that will stop you first.
            binding = max(r.windows, key=lambda w: w.get("used") or 0)
            for w in sorted(r.windows, key=lambda w: w.get("seconds") or 0):
                pct = w.get("used")
                if pct is None:
                    continue
                label = span_label(w.get("seconds") or 0)
                when = reset_phrase(w["reset_at"]) if w.get("reset_at") else ""
                mark = "  <" if w is binding else ""
                out(f"  {'':<13} {label:<4} {bar(pct / 100)} {round(pct):>3}%"
                    f"  {C.DIM}{when}{C.RESET}{mark}")
        if verdict:
            out(f"  {'':<13} {verdict}")
        # 'allowance' rather than 'credits': the same line carries a credit
        # balance, a spend budget, or the fact that neither is reported.
        if r.allowance:
            row("allowance", r.allowance)
        row("refreshed", refreshed)
        section("Storage")
        if stored():
            row("store", tilde(str(STORE)))
        else:
            row("store", f"{C.YELLOW}none — predates the store; run any command "
                         f"for the fix{C.RESET}")
        row("conversations", session_disp)
        row("state index", state_disp)
        section("Clients")
        for line in server_lines:
            out(line)
        row("ssh proxies", str(proxy_count))
        row("server mode", lifecycle.mode)
        row("remote ctrl", remote_control_label(lifecycle))
        row("desktop", "not observable from this host")
        out()

    if duplicate_servers:
        status_word, color = "duplicate-servers", C.RED
        message = ("DUPLICATE APP SERVERS — run "
                   f"'cdx use {active} --force' to collapse stale writers.")
    elif mismatch:
        status_word, color = "mismatch", C.RED
        message = f"MISMATCH — run 'cdx use {active}' to refresh Codex and remote clients."
    elif not server_pids:
        status_word, color = "idle", C.YELLOW
        message = f"IDLE — the next Codex client should start with {active}."
    elif lifecycle.problem:
        status_word, color = "remote-conflict", C.RED
        message = ("REMOTE CONTROL CONFLICT — close connected clients, then run "
                   "'codex remote-control start'.")
    else:
        status_word, color = "ok", C.GREEN
        message = f"OK — host-side Codex execution is using {active}."

    if as_json:
        # Straight from the cache file, not the rendered column: a consumer
        # wants the percentage and the epoch, not "42%" and "Aug 18 (in 6d)".
        try:
            c = json.loads((home / ".cdx-usage.json").read_text())
            quota_json = {"used_percent": c.get("used"), "reset_at": c.get("reset_at"),
                          "measured_at": c.get("fetched_at"), "state": c.get("state"),
                          "credits": c.get("credits")}
        except Exception:
            quota_json = None
        recommended = (f"cdx use {active} --force"
                       if status_word == "duplicate-servers" else
                       f"cdx use {active}" if status_word == "mismatch" else
                       "codex remote-control start"
                       if status_word == "remote-conflict" else None)
        out(json.dumps({
            "active_profile": active,
            "reported_profile": subject,
            "selected_account": account,
            "quota": quota_json,
            "conversation_store": session_store,
            "state_index": state_store,
            "app_servers": [{"pid": pid, "profile": owner,
                             "matches_active_profile": owner == active}
                            for pid, owner in server_rows],
            "ssh_remote_proxies": proxy_count,
            "desktop_account_observable": False,
            "app_server_mode": lifecycle.mode,
            "remote_control": {
                "status": lifecycle.remote_status,
                "configured": lifecycle.configured,
                "managed_pid": lifecycle.managed_pid,
                "managed": lifecycle.managed_remote,
            },
            "status": status_word,
            "recommended_command": recommended,
        }, indent=2))
    else:
        out(f"Status: {color}{message}{C.RESET}")
    return 1 if mismatch or lifecycle.problem else 0


# ── init and the store ───────────────────────────────────────────────────────
def legacy_layout() -> bool:
    return initialized() and not stored()


def explain_legacy() -> None:
    """An install made before the store existed keeps its shared data inside
    'main'. cdx carries no converter for that: it was a one-time operation, and
    keeping a rarely-run command that stops processes and moves gigabytes is
    worse than explaining the fix."""
    legacy = PROFILES / "main"
    items = [f for f in SHARED_FILES + SHARED_DATA + SHARED_DIRS
             if (legacy / f).exists() and not (legacy / f).is_symlink()]
    w = sys.stderr.write
    w(f"{C.YELLOW}cdx: this install predates the shared store.{C.RESET}\n")
    w("     Its shared data still lives inside the 'main' profile, which makes\n")
    w("     'main' undeletable and unrenameable. To finish the layout:\n")
    w("\n")
    w("       # 1. stop Codex on this machine (the desktop app will reconnect)\n")
    w("       pkill -u \"$(id -un)\" -f 'codex.*app-server'\n")
    w("\n")
    w("       # 2. move the shared data into the store (same filesystem: instant)\n")
    w(f"       mkdir -p {STORE} && chmod 700 {STORE}\n")
    if len(items) > 1:
        # Brace expansion needs a comma: '{sessions}' stays literal, so a
        # single leftover item has to be printed as a plain path.
        w(f"       mv {legacy}/{{{','.join(items)}}} \\\n")
        w(f"          {STORE}/\n")
    elif len(items) == 1:
        w(f"       mv {legacy}/{items[0]} \\\n")
        w(f"          {STORE}/\n")
    else:
        w("       # (nothing left to move — 'main' holds no unshared originals)\n")
    if items:
        w(f"       mv {legacy}/*.sqlite-wal {legacy}/*.sqlite-shm {STORE}/ 2>/dev/null\n")
    w("\n")
    w("       # 3. re-point every profile at the store\n")
    w("       cdx link\n")


def require_store() -> None:
    if legacy_layout():
        explain_legacy()
        raise SystemExit(1)


def move_store_out_of(src: Path) -> int:
    """Move the one real copy of every shared entry into the store. Everything
    is a same-filesystem rename, so nothing is copied and nothing is deleted;
    items already in the store, or already links, are skipped."""
    if STORE.exists() and not STORE.is_dir():
        die(f"{STORE} exists but is not a directory — move it aside and rerun")
    STORE.mkdir(parents=True, exist_ok=True)
    os.chmod(STORE, 0o700)
    moved = 0
    for name in SHARED_FILES + SHARED_DATA + SHARED_DIRS:
        item = src / name
        if not item.exists() or item.is_symlink() or (STORE / name).exists():
            continue
        os.rename(item, STORE / name)
        moved += 1
    # New installations use Codex's supported sqlite_home setting. Move the
    # initial account's databases as a unit into that directory; future
    # profiles address them there directly rather than through symlinks.
    for item in sorted(src.glob("*.sqlite*")):
        if not re.fullmatch(r".+\.sqlite(?:-(?:wal|shm))?", item.name):
            continue
        if not item.is_symlink() and not (STORE / item.name).exists():
            os.rename(item, STORE / item.name)
            moved += 1
    # sqlite's sidecars must travel with their database or the index looks
    # corrupt; they are recreated next to the resolved path afterwards.
    for name in SHARED_DATA:
        for suffix in ("-wal", "-shm"):
            side = src / (name + suffix)
            if side.exists() and not side.is_symlink() and not (STORE / side.name).exists():
                os.rename(side, STORE / side.name)
    return moved


def cmd_init(argv: list[str]) -> int:
    if initialized():
        out(f"already set up: {CODEX_LINK} -> {os.readlink(CODEX_LINK)}")
        # Not a full no-op: an install from before the store looks "set up"
        # but still has its shared data buried in the 'main' profile.
        if legacy_layout():
            explain_legacy()
        return 0
    if not CODEX_LINK.is_dir():
        die(f"{CODEX_LINK} does not exist — nothing to set up")
    # 'mv dir existing-dir/' moves it *inside*, so without this the real home
    # lands at PROFILES/main/.codex and the pointer ends up on a stale 'main'
    # — no data lost, but the wrong account is silently active.
    if (PROFILES / "main").exists():
        die(f"{PROFILES / 'main'} already exists, but {CODEX_LINK} is a real\n"
            f"     directory. Move one aside — if that profile is the account you want, delete\n"
            f"     or rename {CODEX_LINK} and 'ln -s {PROFILES / 'main'} {CODEX_LINK}' instead")

    if not argv or argv[0] != "-y":
        # Without a terminal there is nobody to answer, and silently doing
        # nothing is the worst outcome — say how to proceed instead.
        if not sys.stdin.isatty():
            die("not a terminal — rerun as 'cdx init -y' to confirm")
        out(f"cdx: one-time setup — {CODEX_LINK} becomes a symlink so accounts can be")
        out("     switched by re-pointing it. Your current account moves to")
        out(f"     {PROFILES / 'main'} and stays the active one. Nothing is copied.")
        sys.stdout.write("proceed? [y/N] ")
        sys.stdout.flush()
        reply = sys.stdin.readline().strip()
        if reply not in ("y", "Y"):
            out("cancelled")
            return 1

    PROFILES.mkdir(parents=True, exist_ok=True)
    os.rename(CODEX_LINK, PROFILES / "main")
    secure_profile(PROFILES / "main")
    os.symlink(PROFILES / "main", CODEX_LINK)
    out(f"set up: {CODEX_LINK} -> {PROFILES / 'main'}")
    # Hoist the shared data straight out of 'main' so it is never load-bearing.
    move_store_out_of(PROFILES / "main")
    set_configured_sqlite_home(STORE)
    link_shared(PROFILES / "main")
    out(f"shared store: {STORE}")
    return 0


# ── stopping bound processes ─────────────────────────────────────────────────
def stop_bound_to(old: str, dry_run: bool = False, proxy_policy: str = "always",
                  target_profile: str | None = None, force: bool = False) -> int:
    """Kill running Codex processes whose open files still point inside `old`.

    SSH remote proxies need their own rule: they hold anonymous socket fds
    rather than paths below `old`, so the fd scan never sees them, yet they
    front the app-server we are about to kill. Leaving them up strands the
    desktop on a dead backend.
      always   — 'use', where the account itself changes, so every cached
                 connection is stale whether or not we stopped anything.
      if-stale — 'rename', where the account is unchanged: disconnect them
                 only when we actually stopped a process they could be
                 fronting, so an idle machine keeps its remote sessions.
    """
    old = old.rstrip("/")
    if not old:
        return 0
    if not Path("/proc/self/fd").is_dir() and not shutil.which("lsof"):
        sys.stderr.write("cdx: cannot find processes bound to the old profile "
                         "(need /proc or lsof)\n")
        return 1

    killed: list[int] = []
    proxies: list[int] = []
    remote_proxies = 0
    stale_servers = 0
    for pid in PROCS.matching("[cC]odex"):
        matched = False
        cmd = PROCS.cmdline(pid)
        remote_proxy = "codex app-server proxy" in cmd
        if remote_proxy and proxy_policy == "always":
            matched = True
        # A repeated `cdx use personal` must also clean up a server left on
        # `lab`.  Looking only below the old active directory missed exactly
        # that case: shared SQLite fds resolve into .store, while the stale
        # server's control socket names a different profile.
        app_server = "app-server" in cmd and "--listen" in cmd and not remote_proxy
        if not matched and target_profile and app_server:
            owner = app_server_profile(pid)
            if owner not in ("unknown", target_profile):
                matched = True
                stale_servers += 1
        if not matched:
            matched = any(target.startswith(old + "/")
                          for target in PROCS.open_paths(pid))
        if matched:
            killed.append(pid)
            if remote_proxy:
                remote_proxies += 1
        elif remote_proxy:
            # Not bound to `old` itself, but a candidate if anything else is:
            # tracked separately so escalation cannot list it twice.
            proxies.append(pid)

    # We stopped something a proxy could be fronting, so those connections are
    # now dead ends: take them down too and let the desktop reconnect.
    if proxy_policy == "if-stale" and killed and proxies:
        killed.extend(proxies)
        remote_proxies += len(proxies)

    if not killed:
        out("  No running processes were bound to the old profile.")
        return 0
    listed = " ".join(str(p) for p in killed)
    if dry_run:
        out(f"{C.YELLOW}  Would stop {len(killed)} process(es): {listed}{C.RESET}")
        if stale_servers:
            out(f"{C.YELLOW}  Would remove {stale_servers} stale cross-profile "
                f"app server(s).{C.RESET}")
        if remote_proxies:
            out(f"{C.YELLOW}  Would disconnect {remote_proxies} SSH remote "
                f"proxy/proxies.{C.RESET}")
        if force:
            out(f"{C.YELLOW}  Would force-kill only verified Codex survivors "
                f"after the 20-second graceful timeout.{C.RESET}")
        return 0
    out(f"{C.YELLOW}  Stopping {len(killed)} process(es) bound to the old "
        f"profile: {listed}{C.RESET}")
    if stale_servers:
        out(f"{C.YELLOW}  Removing {stale_servers} stale cross-profile app "
            f"server(s).{C.RESET}")
    if remote_proxies:
        out(f"{C.YELLOW}  Disconnecting {remote_proxies} SSH remote proxy/proxies; "
            f"desktop clients should reconnect.{C.RESET}")
    # Escape hatch for anything running cdx against a scratch CODEX_PROFILES.
    # Process selection is the one part of cdx that cannot be sandboxed by env
    # vars — pgrep sees the whole user's process table — so a bug in the path
    # filter reaches real Codex sessions no matter how isolated the profiles
    # are. The test suite sets this so a broken build cannot kill live work.
    if os.environ.get("CDX_NO_KILL") == "1":
        out(f"{C.YELLOW}  CDX_NO_KILL=1 — signalling nothing.{C.RESET}")
        return 0
    for pid in killed:
        PROCS.terminate(pid)
    # A real app-server takes its time on SIGTERM — it closes sqlite handles
    # and tears down client sessions first. Five seconds was not enough and
    # made 'rename' abort on a perfectly healthy shutdown, so wait 20.
    waited = 0
    survivors: list[int] = []
    for attempt in range(1, 201):
        survivors = [pid for pid in killed if PROCS.alive(pid)]
        if not survivors:
            break
        time.sleep(0.1)
        waited = attempt
    if survivors:
        if force:
            # Recheck command identity immediately before SIGKILL. A PID that
            # exited and was reused during the graceful wait must never make
            # an unrelated process eligible for the hard-stop path.
            verified = [pid for pid in survivors
                        if "codex" in PROCS.cmdline(pid).lower()]
            refused = [pid for pid in survivors if pid not in verified]
            if refused:
                sys.stderr.write(
                    f"{C.RED}cdx: refusing to force-kill PID(s) whose identity "
                    f"changed: {' '.join(str(p) for p in refused)}{C.RESET}\n")
                return 1
            out(f"{C.YELLOW}  Force-killing {len(verified)} verified Codex "
                f"survivor(s): {' '.join(str(p) for p in verified)}{C.RESET}")
            for pid in verified:
                PROCS.force_kill(pid)
            for _attempt in range(50):
                survivors = [pid for pid in verified if PROCS.alive(pid)]
                if not survivors:
                    break
                time.sleep(0.1)
            if not survivors:
                out(f"{C.GREEN}  All targeted processes exited.{C.RESET}")
                return 0
            sys.stderr.write(
                f"{C.RED}cdx: force-killed but still observable after 5 seconds: "
                f"{' '.join(str(p) for p in survivors)}{C.RESET}\n")
            return 1
        sys.stderr.write(f"{C.RED}cdx: {len(survivors)} process(es) did not exit after "
                         f"20 seconds: {' '.join(str(p) for p in survivors)}{C.RESET}\n")
        sys.stderr.write(f"{C.YELLOW}     They were not force-killed; inspect them "
                         f"and rerun with --force if appropriate.{C.RESET}\n")
        return 1
    if waited >= 10:
        out(f"{C.YELLOW}  (waited {waited // 10}s for a graceful exit){C.RESET}")
    out(f"{C.GREEN}  All targeted processes exited.{C.RESET}")
    return 0


def restart_remote_control(profile: str) -> int:
    """Restore a daemon that cdx deliberately stopped during a switch."""
    if os.environ.get("CDX_NO_KILL") == "1":
        out(f"{C.YELLOW}  Would restart Remote Control for {profile}.{C.RESET}")
        return 0
    out(f"{C.YELLOW}  Restarting Remote Control for {profile}...{C.RESET}")
    proc = subprocess.run(
        ["codex", "remote-control", "start"],
        text=True,
        capture_output=True,
    )
    if proc.stdout:
        sys.stdout.write(proc.stdout)
    if proc.stderr:
        sys.stderr.write(proc.stderr)
    if proc.returncode:
        sys.stderr.write(
            f"{C.RED}cdx: profile switched, but Remote Control did not restart."
            f"{C.RESET}\n"
        )
        sys.stderr.write("     Close connected clients and run "
                         "'codex remote-control start'.\n")
        return proc.returncode
    return 0


# ── use ──────────────────────────────────────────────────────────────────────
def report_quota(target: str, names: list[str]) -> None:
    """What 'use' reports about the account you just landed on. Cache only:
    activating an account must never wait on, or fail because of, the network."""
    saved = os.environ.get("CDX_USAGE")
    os.environ["CDX_USAGE"] = "off"
    try:
        rows = profile_rows(names)
    finally:
        if saved is None:
            os.environ.pop("CDX_USAGE", None)
        else:
            os.environ["CDX_USAGE"] = saved

    best, best_pct = roomiest(rows, target)
    target_pct, unusable = None, False
    for r in rows:
        if r.name == target:
            target_pct = pct_of(r.used)
            if r.state == "relogin":
                out(f"{C.RED}  '{r.name}' was rejected by OpenAI — its refresh "
                    f"token is dead.{C.RESET}")
                out(f"{C.YELLOW}  Run 'cdx add {r.name}' to sign in again.{C.RESET}")
                return
            if r.state == "spendlimit":
                # Landing here is exactly when this has to be said: every
                # rate-limit field reports fine, so the percentage on the next
                # line would otherwise read as permission to work.
                out(f"{C.RED}  '{r.name}' is over its spend limit and cannot run "
                    f"— the{C.RESET}")
                out(f"{C.RED}  usage below is its rate limit, which is not what "
                    f"stopped it.{C.RESET}")
                unusable = True
            if r.used:
                out(f"  quota: {r.used} used, resets {r.resets}")

    if not unusable:
        if target_pct is None or target_pct < QUOTA_WARN_PERCENT:
            return
        out(f"{C.YELLOW}  {target} is nearly out of quota ({target_pct}% used).{C.RESET}")
        # Only worth naming an alternative that is actually better.
        if not best or best_pct >= target_pct:
            return
    if not best:
        return
    out(f"{C.YELLOW}  '{best}' has the most room ({best_pct}% used) — "
        f"'cdx use {best}'.{C.RESET}")


def cmd_use(argv: list[str]) -> int:
    if not argv:
        die("use needs a name (try 'cdx' to list)")
    name = argv[0]
    validate_name(name)
    restart, dry_run, force = True, False, False
    for arg in argv[1:]:
        if arg == "--restart":
            restart = True
        elif arg == "--no-restart":
            restart = False
        elif arg == "--dry-run":
            dry_run = True
        elif arg == "--force":
            force = True
        else:
            die(f"unknown option to 'use': {arg}")
    if force and not restart:
        die("--force cannot be combined with --no-restart")
    if not initialized():
        die(f"run 'cdx init' first — it makes {CODEX_LINK} switchable")
    home = home_of(name)
    if not home.is_dir():
        missing_profile(name)
    # Resolve the old target before repointing. Restart it even when the name
    # is already active: that is how a caller repairs stale cached connections.
    if not dry_run:
        acquire_switch_lock()
    old_target = resolve_dir(CODEX_LINK)
    old_lifecycle = None
    if restart and old_target:
        old_servers = pgrep(r"[cC]odex.*app-server.*--listen[ =]unix://")
        old_lifecycle = app_server_lifecycle(Path(old_target), old_servers)
    preserve_remote = bool(old_lifecycle and old_lifecycle.managed_remote)
    if dry_run:
        out(f"{C.YELLOW}Dry run:{C.RESET} would activate {C.CYAN}{name}{C.RESET} "
            f"({CODEX_LINK} -> {home})")
        if restart and old_target:
            stop_bound_to(old_target, dry_run=True, target_profile=name, force=force)
            if preserve_remote:
                restart_remote_control(name)
        else:
            out("  Existing Codex and remote connections would be left running.")
        return 0
    secure_all_profiles()
    link_shared(home)
    _replace_symlink(home, CODEX_LINK)
    out(f"{C.GREEN}→{C.RESET} {C.CYAN}{name}{C.RESET} is now active "
        f"({CODEX_LINK} -> {home})")
    if not (home / "auth.json").is_file():
        out(f"{C.YELLOW}  '{name}' is not logged in yet — run 'cdx add {name}' "
            f"to authenticate.{C.RESET}")
    report_quota(name, profile_names())
    if restart:
        if old_target:
            stopped = stop_bound_to(old_target, target_profile=name, force=force)
            if stopped:
                return stopped
            if preserve_remote and restart_remote_control(name):
                return 1
    else:
        out("  Existing Codex and remote connections were left running by request.")
        out("  They may keep the old account until restarted or reconnected.")
    return 0


def _replace_symlink(target: Path, link: Path) -> None:
    """Repoint `link` at `target` atomically.

    The shell version needed 'ln -sfn' here: without -n, ln follows the
    existing symlink and drops the new one *inside* the profile directory,
    silently doing nothing. os.symlink to a temp name plus rename has the same
    effect and is atomic besides.
    """
    tmp = link.with_name(link.name + f".cdx-tmp-{os.getpid()}")
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    os.symlink(target, tmp)
    os.rename(tmp, link)


# ── add ──────────────────────────────────────────────────────────────────────
def headless() -> bool:
    """The browser flow needs a browser on THIS machine: 'codex login' spins up
    a localhost callback server, so a browser elsewhere cannot complete it."""
    if os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_TTY"):
        return True
    if os.uname().sysname == "Darwin":
        return False
    return not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def cmd_add(argv: list[str]) -> int:
    if not argv:
        die("add needs a name")
    name, rest = argv[0], argv[1:]
    validate_name(name)
    # Before 'cdx init', 'main' means ~/.codex itself; afterwards (and perhaps
    # renamed away) it is an ordinary name again.
    if not initialized() and name == "main":
        die(f"'main' is reserved for {CODEX_LINK}")
    home = home_of(name)
    if home.is_dir():
        # A profile with no credentials is a login that never finished (say, a
        # Ctrl-C'd browser flow) — retry it instead of demanding a new name.
        if (home / "auth.json").is_file():
            die(f"{name} already exists ({home})")
        out(f"→ '{name}' exists but is not logged in — retrying login")
    home.mkdir(parents=True, exist_ok=True)
    secure_profile(home)
    link_shared(home)
    login_args = list(rest)
    if not login_args and headless():
        login_args = ["--device-auth"]
    if "--device-auth" in login_args:
        out(f"→ logging in to '{name}' with device auth (no local browser needed)")
    else:
        out(f"→ logging in to '{name}' (a browser window will open)")
    env = dict(os.environ, CODEX_HOME=str(home))
    subprocess.run(["codex", "login", *login_args], env=env)
    secure_profile(home)
    return 0


# ── rename, rm, link ─────────────────────────────────────────────────────────
def cmd_rename(argv: list[str]) -> int:
    if len(argv) < 2 or not argv[0] or not argv[1]:
        die("usage: cdx rename <old> <new>")
    old, new = argv[0], argv[1]
    validate_name(old)
    validate_name(new)
    if not initialized():
        die(f"run 'cdx init' first — before that, 'main' is {CODEX_LINK} itself")
    require_store()
    old_home, new_home = PROFILES / old, PROFILES / new
    if not old_home.is_dir():
        missing_profile(old)
    if new_home.exists():
        die(f"{new} already exists ({new_home})")
    acquire_switch_lock()
    active = active_profile()
    # Running processes cache the old path (CODEX_HOME strings, log fds); stop
    # the ones holding files under it while fd inspection can still see the
    # pre-rename path. Proxies without such files keep running: the account
    # behind ~/.codex is not changing, only its directory name.
    if stop_bound_to(str(old_home), proxy_policy="if-stale") != 0:
        die("rename aborted — inspect the survivors and rerun")
    os.rename(old_home, new_home)
    if active == old:
        _replace_symlink(new_home, CODEX_LINK)
    out(f"{C.GREEN}→{C.RESET} renamed {C.CYAN}{old}{C.RESET} to {C.CYAN}{new}{C.RESET}")
    if active == old:
        out(f"  It stays the active profile ({CODEX_LINK} -> {new_home}).")
    return 0


def cmd_rm(argv: list[str]) -> int:
    if not argv:
        die("rm needs a name")
    name, rest = argv[0], argv[1:]
    assume_yes = False
    for arg in rest:
        if arg in ("-y", "--yes"):
            assume_yes = True
        else:
            die(f"unknown option to 'rm': {arg}")
    # No profile-is-load-bearing guard needed: shared data lives in the store,
    # which validate_name cannot name.
    validate_name(name)
    home = home_of(name)
    if not home.is_dir():
        missing_profile(name)
    # The guard must not be conditional on 'initialized'. Before 'cdx init',
    # home_of maps 'main' to CODEX_LINK itself — the one real copy of every
    # profile's config, conversations and caches, none of it yet hoisted into
    # the store.
    if resolve_dir(CODEX_LINK) == resolve_dir(home):
        if initialized():
            die(f"refusing to delete the active profile '{name}' (switch profiles first)")
        die(f"refusing to delete '{name}' — before 'cdx init' it is {CODEX_LINK} itself,\n"
            "     which holds the only copy of your config, conversations and caches")
    if not assume_yes:
        # Same reasoning as 'init': with no terminal nobody can answer, and
        # letting a read hit EOF would abort with no explanation.
        if not sys.stdin.isatty():
            die(f"not a terminal — rerun as 'cdx rm {name} -y' to confirm")
        sys.stdout.write(f"delete {home} and its credentials? [y/N] ")
        sys.stdout.flush()
        reply = sys.stdin.readline().strip()
        if reply not in ("y", "Y"):
            out("cancelled")
            return 1
    shutil.rmtree(home)
    out(f"removed {name}")
    return 0


def cmd_link() -> int:
    """Rebuild every profile's links to the store. This is the repair command:
    the store path is fixed, so a profile's links are fully derivable."""
    require_store()
    secure_all_profiles()
    if PROFILES.is_dir():
        for entry in sorted(PROFILES.iterdir()):
            if entry.is_dir() and not entry.name.startswith("."):
                link_shared(entry)
                out(f"linked {entry.name}")
    return 0


def cmd_share_sqlite(argv: list[str]) -> int:
    """Move live SQLite state behind Codex's supported sqlite_home setting.

    The destination is one directory per host. Profiles then share the same
    databases without file symlinks, so SQLite keeps each DB and its WAL/SHM
    sidecars together. Existing per-profile databases are archived rather than
    deleted; when a destination DB is missing, the active profile is preferred.
    """
    force = False
    destination_arg = ""
    for arg in argv:
        if arg == "--force":
            force = True
        elif arg.startswith("-"):
            die(f"unknown option to 'share-sqlite': {arg}")
        elif destination_arg:
            die("usage: cdx share-sqlite [absolute-directory] [--force]")
        else:
            destination_arg = arg
    require_store()
    destination = Path(os.path.expanduser(destination_arg)) if destination_arg else STORE
    if not destination.is_absolute():
        die("share-sqlite needs an absolute directory")
    destination = Path(os.path.abspath(destination))

    active = active_profile()
    profiles = [entry for entry in sorted(PROFILES.iterdir())
                if entry.is_dir() and not entry.name.startswith(".")]
    candidates: dict[str, list[Path]] = {}
    roots = [STORE]
    active_home = home_of(active)
    if active_home in profiles:
        roots.append(active_home)
    roots.extend(profile for profile in profiles if profile != active_home)
    for root in roots:
        for path in sorted(root.glob("*.sqlite")):
            candidates.setdefault(path.name, []).append(path)
    if not candidates:
        die("no SQLite databases found to migrate")

    out(f"SQLite sharing: {destination}")
    if stop_bound_to(str(PROFILES), target_profile=active, force=force):
        die("Codex is still using the old SQLite layout; migration cancelled")
    destination.mkdir(parents=True, exist_ok=True)
    os.chmod(destination, 0o700)

    copied: list[str] = []
    skipped: list[str] = []
    for name, sources in sorted(candidates.items()):
        target = destination / name
        if target.exists():
            ok, detail = _sqlite_ok(target)
            if not ok:
                die(f"destination database {target} is unhealthy: {detail}")
            continue
        healthy_source = None
        # Prefer the active profile over dormant copies, except that the old
        # store copy is canonical for databases formerly shared by cdx.
        ordered = sources
        if name not in ("state_5.sqlite", "memories_1.sqlite"):
            ordered = sorted(sources, key=lambda p: p.parent != active_home)
        for source in ordered:
            ok, _detail = _sqlite_ok(source)
            if ok:
                healthy_source = source
                break
        if healthy_source is None:
            if name in ("state_5.sqlite", "memories_1.sqlite"):
                die(f"no healthy source found for canonical {name}; nothing was archived")
            skipped.append(name)
            out(f"  skipping unhealthy rebuildable database {name}")
            continue
        _sqlite_backup(healthy_source, target)
        copied.append(name)

    stamp = time.strftime("%Y%m%d-%H%M%S")
    archive = PROFILES / ".recovery-archive" / f"sqlite-sharing-{stamp}"
    archived: list[str] = []
    for profile in profiles:
        for path in sorted(profile.glob("*.sqlite*")):
            # Only database files and their SQLite sidecars belong here.
            if not re.fullmatch(r".+\.sqlite(?:-(?:wal|shm))?", path.name):
                continue
            archive_profile = archive / profile.name
            archive_profile.mkdir(parents=True, exist_ok=True)
            os.rename(path, archive_profile / path.name)
            archived.append(f"{profile.name}/{path.name}")
    if archived:
        os.chmod(archive, 0o700)

    set_configured_sqlite_home(destination)
    link_shared(active_home)
    out(f"  configured sqlite_home = {destination}")
    out(f"  copied {len(copied)} database(s); archived {len(archived)} old file(s)")
    if skipped:
        out(f"  Codex will recreate: {', '.join(skipped)}")
    if archived:
        out(f"  recovery archive: {archive}")
    out("  Desktop clients may reconnect now.")
    return 0


# ── app, ssh, run ────────────────────────────────────────────────────────────
def cmd_app(argv: list[str]) -> int:
    """The desktop app defaults to ~/.codex and has no in-app switcher, but
    macOS can hand it a different one at launch. Two knobs, because the
    integrated app is two things: CODEX_HOME holds Codex-local state, while the
    ChatGPT login itself lives in the Electron session."""
    name = workspace = ""
    stock = False
    # [dir] is optional, so --stock has to be recognised wherever it lands
    # rather than at a fixed position.
    for arg in argv:
        if arg == "--stock":
            stock = True
        elif arg.startswith("-"):
            die(f"unknown option to 'app': {arg}")
        elif not name:
            name = arg
        elif not workspace:
            workspace = arg
        else:
            die(f"unexpected argument to 'app': {arg}")
    # Default to whatever is active, not a hardcoded 'main' — that name is
    # only the initial one and 'cdx rename' may have moved it.
    name = name or active_profile()
    workspace = workspace or os.getcwd()
    validate_name(name)
    if os.uname().sysname != "Darwin":
        die("app launching is macOS-only")
    home = home_of(name)
    if not home.is_dir():
        missing_profile(name)

    app = os.environ.get("CHATGPT_APP", "")
    if not app:
        for candidate in ("/Applications/ChatGPT.app", "/Applications/Codex.app"):
            if Path(candidate).is_dir():
                app = candidate
                break
    if not app:
        die("desktop app not found — set CHATGPT_APP=/path/to/ChatGPT.app")

    secure_profile(home)
    link_shared(home)
    out(f"→ {app}  (CODEX_HOME={home})")
    if stock:
        # Reuse the app's default Electron session — the existing ChatGPT
        # desktop login — rather than giving this profile its own.
        subprocess.run(["open", "-n", "--env", f"CODEX_HOME={home}",
                        "-a", app, workspace])
    else:
        (home / "electron").mkdir(parents=True, exist_ok=True)
        subprocess.run(["open", "-n", "--env", f"CODEX_HOME={home}",
                        "-a", app, workspace,
                        "--args", f"--user-data-dir={home}/electron"])
    return 0


def cmd_ssh(argv: list[str]) -> int:
    """Run cdx on a remote host: 'cdx ssh baram use work'. Each host keeps its
    own accounts and its own active one; this is just a way to drive them
    without opening a shell."""
    if not argv:
        die("usage: cdx ssh <host> [cdx args...]")
    host, rest = argv[0], argv[1:]
    # Reachability is ssh's business: jump hosts, ports, users and keys all
    # come from ~/.ssh/config.
    ssh_cmd = ["ssh"]
    # A TTY is needed for the prompts in 'use' and 'add', but asking for one
    # when stdin is a pipe just prints a warning, so only do it when useful.
    if sys.stdin.isatty():
        ssh_cmd.append("-t")
    opts = os.environ.get("CDX_SSH_OPTS", "")
    if opts:
        ssh_cmd.extend(opts.split())
    # Ship this script to the host and run it there, instead of requiring an
    # install on every machine. Compress before base64: once cdx grew past
    # zsh's per-argument ceiling, an uncompressed payload failed before SSH
    # could even start it. stdin stays free, so -t can still carry prompts.
    enc = base64.b64encode(gzip.compress(SELF.read_bytes())).decode()
    args = "".join(" " + _shell_quote(a) for a in rest)
    # PATH: a non-interactive ssh shell has neither ~/.local/bin nor the codex
    # install dir, and rc files are not sourced, so set it explicitly.
    remote = (f"f=$(mktemp) && printf %s {enc} | base64 -d | gzip -d > $f && "
              f'PATH="$HOME/.local/bin:$PATH" CDX_SSH_SHIPPED=1 python3 $f{args}; '
              "r=$?; rm -f $f; exit $r")
    return subprocess.run([*ssh_cmd, host, remote]).returncode


def _shell_quote(word: str) -> str:
    return "'" + word.replace("'", "'\\''") + "'"


def cmd_run(argv: list[str]) -> "NoReturn":  # type: ignore[valid-type]
    name, rest = argv[0], argv[1:]
    validate_name(name)
    home = home_of(name)
    if not home.is_dir():
        missing_profile(name)
    secure_profile(home)
    link_shared(home)
    if not (home / "auth.json").is_file():
        sys.stderr.write(f"cdx: '{name}' is not logged in — Codex will prompt.\n")
    os.execvpe("codex", ["codex", *rest], dict(os.environ, CODEX_HOME=str(home)))


# ── compatibility and self-update ──────────────────────────────────────────
def cmd_doctor(argv: list[str]) -> int:
    as_json = False
    for arg in argv:
        if arg == "--json":
            as_json = True
        else:
            die(f"unknown option to 'doctor': {arg}")

    unknowns = storage_unknowns()
    databases = sqlite_health()
    bad_databases = [item for item in databases if not item["ok"]]
    active = active_profile()
    servers = []
    for pid in pgrep(r"[cC]odex.*app-server.*--listen[ =]unix://"):
        owner = app_server_profile(pid)
        servers.append({"pid": pid, "profile": owner,
                        "matches_active_profile": owner == active})
    stale = [server for server in servers if server["profile"] not in (active, "unknown")]
    duplicate_servers = sum(server["matches_active_profile"] for server in servers) > 1
    unsafe_sqlite_links = []
    if PROFILES.is_dir():
        for profile in sorted(PROFILES.iterdir()):
            if not profile.is_dir() or profile.name.startswith("."):
                continue
            unsafe_sqlite_links.extend(str(path) for path in sorted(profile.glob("*.sqlite"))
                                       if path.is_symlink())
    sqlite_home = configured_sqlite_home()
    healthy = (sqlite_home is not None and sqlite_home.is_dir()
               and not unknowns and not bad_databases and not stale
               and not duplicate_servers and not unsafe_sqlite_links)
    report = {
        "cdx_version": CDX_VERSION,
        "codex_version": codex_version(),
        "storage_policy_date": STORAGE_POLICY_DATE,
        "unknown_storage": unknowns,
        "sqlite": databases,
        "active_profile": active,
        "app_servers": servers,
        "duplicate_app_servers": duplicate_servers,
        "unsafe_sqlite_links": unsafe_sqlite_links,
        "sqlite_home": str(sqlite_home) if sqlite_home else None,
        "healthy": healthy,
    }
    if as_json:
        out(json.dumps(report, indent=2))
    else:
        section("Versions")
        row("cdx", CDX_VERSION)
        row("codex", report["codex_version"])
        row("policy", STORAGE_POLICY_DATE)
        section("Storage")
        row("recognized", "yes" if not unknowns else "new entries need review")
        row("sqlite home", tilde(str(sqlite_home)) if sqlite_home else "not configured")
        for item in unknowns:
            out(f"  {C.YELLOW}{item['profile']}/{item['name']} "
                f"({item['kind']}){C.RESET}")
        row("sqlite", f"{len(databases)} checked, {len(bad_databases)} failed")
        for item in bad_databases:
            out(f"  {C.RED}{tilde(str(item['path']))}: {item['detail']}{C.RESET}")
        for path in unsafe_sqlite_links:
            out(f"  {C.RED}{tilde(path)}: unsafe SQLite symlink; keep databases "
                f"profile-local{C.RESET}")
        section("Clients")
        row("active", active)
        if not servers:
            row("app server", "not running")
        for server in servers:
            mark = "matches" if server["matches_active_profile"] else "MISMATCH"
            out(f"  app server    PID {server['pid']} — {server['profile']} ({mark})")
        if duplicate_servers:
            row("client issue", f"{C.RED}multiple writers on active profile{C.RESET}")
        out()
        if healthy:
            out(f"{C.GREEN}Healthy: cdx recognizes this Codex layout.{C.RESET}")
        else:
            out(f"{C.YELLOW}Attention: cdx found compatibility or client-state "
                f"drift; it changed nothing.{C.RESET}")
            if sqlite_home is None:
                out(f"{C.YELLOW}  Run 'cdx share-sqlite' to use one safe SQLite "
                    f"directory per host.{C.RESET}")
    return 0 if healthy else 1


def _version_tuple(version: str) -> tuple[int, int, int]:
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        die(f"invalid cdx version '{version}'")
    return tuple(int(part) for part in version.split("."))  # type: ignore[return-value]


def _candidate_version(data: bytes) -> str:
    match = re.search(rb'^CDX_VERSION = "(\d+\.\d+\.\d+)"$', data, re.MULTILINE)
    if not match:
        die("download is not a versioned cdx release")
    return match.group(1).decode()


def _validate_candidate(data: bytes, source: str) -> str:
    if not data.startswith(b"#!/usr/bin/env python3\n") or b'"""cdx ' not in data[:512]:
        die(f"download from {source} does not look like cdx")
    version = _candidate_version(data)
    try:
        compile(data, source, "exec")
    except SyntaxError as exc:
        die(f"download from {source} is not valid Python: {exc}")
    return version


def _git_update_candidate(force: bool) -> tuple[bytes, str]:
    """Fetch bin/cdx from this checkout's GitHub origin."""
    override = os.environ.get("CDX_UPDATE_URL")
    if override:
        try:
            with urllib.request.urlopen(override, timeout=15) as response:
                return response.read(), override
        except (OSError, urllib.error.URLError) as exc:
            die(f"could not fetch cdx update: {exc}")

    root_proc = subprocess.run(["git", "-C", str(SELF.parent), "rev-parse",
                                "--show-toplevel"], capture_output=True, text=True)
    if root_proc.returncode != 0:
        try:
            with urllib.request.urlopen(DEFAULT_UPDATE_URL, timeout=15) as response:
                return response.read(), DEFAULT_UPDATE_URL
        except (OSError, urllib.error.URLError) as exc:
            die(f"cdx is not in a Git checkout and GitHub could not be reached: {exc}")
    root = Path(root_proc.stdout.strip())
    try:
        relative = SELF.relative_to(root)
    except ValueError:
        die(f"cdx resolved outside its Git checkout: {SELF}")
    remote = os.environ.get("CDX_UPDATE_REMOTE", "origin")
    branch = os.environ.get("CDX_UPDATE_BRANCH", "main")
    remote_url = subprocess.run(["git", "-C", str(root), "remote", "get-url", remote],
                                capture_output=True, text=True)
    if remote_url.returncode != 0 or "github.com" not in remote_url.stdout:
        die(f"update remote '{remote}' is not a GitHub remote")
    dirty = subprocess.run(["git", "-C", str(root), "status", "--porcelain", "--",
                            str(relative)], capture_output=True, text=True)
    if dirty.stdout.strip() and not force:
        die(f"{relative} has local changes; commit them or rerun 'cdx update --force'")
    fetched = subprocess.run(["git", "-C", str(root), "fetch", "--quiet", remote, branch],
                             capture_output=True, text=True)
    if fetched.returncode != 0:
        die(f"could not fetch {remote}/{branch}: {fetched.stderr.strip()}")
    shown = subprocess.run(["git", "-C", str(root), "show", f"FETCH_HEAD:{relative}"],
                           capture_output=True)
    if shown.returncode != 0:
        die(f"{relative} does not exist on {remote}/{branch}")
    return shown.stdout, f"{remote}/{branch}:{relative}"


def cmd_update(argv: list[str]) -> int:
    check_only = False
    force = False
    for arg in argv:
        if arg == "--check":
            check_only = True
        elif arg == "--force":
            force = True
        else:
            die(f"unknown option to 'update': {arg}")
    if os.environ.get("CDX_SSH_SHIPPED") == "1":
        die("'cdx ssh <host>' already ships the current local cdx; run the "
            "host's installed cdx directly to update its checkout")

    candidate, source = _git_update_candidate(force)
    remote_version = _validate_candidate(candidate, source)
    local_data = SELF.read_bytes()
    local_hash = hashlib.sha256(local_data).hexdigest()
    remote_hash = hashlib.sha256(candidate).hexdigest()
    if local_hash == remote_hash:
        out(f"cdx {CDX_VERSION} is up to date ({local_hash[:12]}).")
        return 0
    if _version_tuple(remote_version) < _version_tuple(CDX_VERSION) and not force:
        die(f"GitHub has older cdx {remote_version}; refusing to downgrade {CDX_VERSION}")
    if remote_version == CDX_VERSION and not force:
        die(f"GitHub changed cdx {remote_version} without changing CDX_VERSION; "
            "fix the release version or use --force")
    if check_only:
        out(f"cdx {remote_version} is available (installed: {CDX_VERSION}).")
        return 0

    mode = stat.S_IMODE(SELF.stat().st_mode)
    temp = SELF.with_name(SELF.name + f".update-{os.getpid()}")
    try:
        with temp.open("xb") as handle:
            handle.write(candidate)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp, mode)
        os.replace(temp, SELF)
    finally:
        try:
            temp.unlink()
        except OSError:
            pass
    out(f"Updated cdx {CDX_VERSION} -> {remote_version} from {source} "
        f"({remote_hash[:12]}).")
    return 0


def cmd_version(argv: list[str]) -> int:
    if not argv:
        out(f"cdx {CDX_VERSION}")
        return 0
    if argv == ["--check"]:
        return cmd_update(["--check"])
    die("usage: cdx version [--check]")


# ── help ─────────────────────────────────────────────────────────────────────
def usage() -> None:
    out(f"""cdx — switch between Codex accounts.

Every Codex client — CLI, desktop app, VS Code, the app's SSH remote — reads
{tilde(str(CODEX_LINK))}. cdx makes that a symlink, so switching accounts is just
re-pointing it and no client needs configuring.

{C.CYAN}Every day{C.RESET}
  cdx                      list accounts, with how much quota each has left
  cdx use <name>           make <name> active for every client on this machine
  cdx <name> [args...]     run one codex command as <name>, without switching
  cdx status [name]        check an account (the active one by default)
                           against what is running

{C.CYAN}Managing accounts{C.RESET}
  cdx add <name>           create <name> and log in
  cdx rename <old> <new>   rename an account — any of them, 'main' included
  cdx rm <name>            delete <name> and its credentials

{C.CYAN}Other machines{C.RESET}
  cdx app <name> [dir]     launch the desktop app as <name> (macOS only)
  cdx ssh <host> [args...] run cdx on <host>, e.g. 'cdx ssh baram use work'
                           (cdx ships itself; nothing to install there)

{C.CYAN}Setup and repair{C.RESET}
  cdx init                 one-time: make {tilde(str(CODEX_LINK))} a switchable link
  cdx link                 rebuild every account's links to the store
  cdx share-sqlite [dir]   share SQLite safely within this host
  cdx doctor               audit Codex storage and running profile compatibility

{C.CYAN}Keeping cdx current{C.RESET}
  cdx version              show the installed cdx release
  cdx version --check      check GitHub for a newer release
  cdx update               fetch and atomically install the latest bin/cdx

{C.CYAN}Options{C.RESET}
  --refresh                take a live quota reading instead of the cached one
  --no-usage               skip quota entirely
  --json                   machine-readable listing (also 'status --json')
  use --no-restart         leave running clients on the old account
  use --dry-run            show what would change, and change nothing
  use --force              hard-stop verified Codex survivors after 20 seconds
  add <name> [args...]     extra arguments pass through to 'codex login'
  app <name> [dir] --stock reuse the app's existing ChatGPT desktop login
  init -y / rm <name> -y   skip the confirmation prompt
  status <name>            report that account instead of the active one
  status --json            machine-readable, with the raw quota figures
  doctor --json            machine-readable compatibility report
  update --check           report an update without installing it
  update --force           replace local edits or allow a downgrade

{C.CYAN}Layout{C.RESET}
  accounts  {tilde(str(PROFILES))}/<name>
  shared    {tilde(str(STORE))}
  An account holds only its credentials and account-local state. Config,
  conversations, attachments and caches live once in the store and are
  symlinked into each account. SQLite state is shared through Codex's
  sqlite_home setting, never by symlinking database files, so accounts stay small,
  'resume' finds your work whichever account is active, and any account can be
  renamed or deleted. 'cdx link' rebuilds those symlinks if Codex overwrites
  one.

{C.CYAN}Environment{C.RESET}
  CODEX_PROFILES           where accounts live
  CDX_CODEX_LINK           the switchable link, normally {tilde(str(CODEX_LINK))}
  CDX_USAGE                off never asks OpenAI for quota; cache never updates
                           an existing figure; auto (the default) re-fetches
                           once the cache is older than CDX_USAGE_TTL seconds
                           (900), falling back to the cache when offline.
  CDX_QUOTA_WARN           percent at which 'use' warns you (90)
  CDX_COLOR                auto, always or never (NO_COLOR also disables it)
  CDX_NO_KILL=1            report which processes would be stopped, stop none""")


SUB_HELP = {
    "list": """cdx [list] [--refresh] [--no-usage] [--json]

  List accounts, '*' marking the active one, with how much of its rate-limit
  window each has spent and when that window resets. An account that cannot
  run says why in place of the percentage ('spend limit', 'rate limited',
  're-login'); 'cdx status <name>' then gives the long form.

  --refresh    ask OpenAI for live figures instead of using the cache
  --no-usage   skip the quota lookup entirely
  --json       raw percentages, epochs and states instead of a table""",
    "status": """cdx status [name] [--json]

  Report an account and check it against what is running on this machine.
  With no name, the active account.

  The Account section follows the name you give. Storage, Clients and the
  verdict always describe this machine, so they do not change when you ask
  about another account — a non-active account is marked as such.

  Quota comes from the cache, so this works offline; 'cdx --refresh' takes a
  live reading. Clients also show whether the app-server is persistent,
  ephemeral or unmanaged and whether Remote Control is healthy. Exits non-zero
  on a profile mismatch or Remote Control lifecycle conflict.

  --json       machine-readable, with raw percentages and epochs, plus
               'reported_profile' alongside 'active_profile'""",
    "use": """cdx use <name> [--no-restart] [--dry-run] [--force]

  Point ~/.codex at <name>, which switches every Codex client on this
  machine at once, then stop the processes still bound to the old account so
  they come back on the new one. SSH remote proxies are disconnected too, so
  the desktop app reconnects rather than holding a dead backend. If the old
  profile has a verified daemon-managed Remote Control server, cdx restarts
  Remote Control for the newly active profile.

  Reports where you landed, and warns when that account is nearly out of
  quota or cannot run at all, naming the account with the most room.

  --no-restart  leave running clients on the old account
  --dry-run     show what would change, change nothing
  --force       SIGKILL verified Codex processes that survive SIGTERM for 20s""",
    "add": """cdx add <name> [args...]

  Create <name> and log in. Extra arguments pass through to 'codex login';
  over SSH or without a display, device auth is used automatically. Rerunning
  it on an account whose login never finished retries that login.""",
    "app": """cdx app [name] [dir] [--stock]

  Launch the desktop app as <name> (macOS only), defaulting to the active
  account and the current directory.

  --stock      reuse the app's existing ChatGPT desktop login instead of
               giving this account its own Electron session""",
    "ssh": """cdx ssh <host> [args...]

  Run cdx on <host>: 'cdx ssh baram use work'. The script ships itself over
  the connection, so nothing needs installing there. Each host keeps its own
  accounts and its own active one. Reachability — ports, users, ProxyJump —
  comes from ~/.ssh/config; CDX_SSH_OPTS adds flags for one call.""",
    "rename": """cdx rename <old> <new>

  Rename an account, 'main' included. Nothing points into an account once the
  store exists, so this is a directory rename plus the active pointer.
  Processes holding files under the old path are stopped first.""",
    "rm": """cdx rm <name> [-y]

  Delete <name> and its credentials. Shared history, config and caches live in
  the store, so they survive. Refuses to delete the active account, and
  refuses 'main' before 'cdx init', where it is still ~/.codex itself.

  -y           skip the confirmation prompt""",
    "init": """cdx init [-y]

  One-time setup: turn ~/.codex into a symlink so accounts can be switched
  by re-pointing it. The current account moves to the accounts directory and
  stays active; shared data is hoisted into the store. A rename on one
  filesystem, so nothing is copied.

  -y           skip the confirmation prompt""",
    "link": """cdx link

  Rebuild every account's symlinks into the store. The repair command: run it
  if Codex overwrites a link with a real file, or a link is left pointing
  somewhere stale. An account's own data is never replaced — it is reported
  and left alone.""",
    "share-sqlite": """cdx share-sqlite [absolute-directory] [--force]

  Consolidate this host's SQLite state behind Codex's supported sqlite_home
  setting. The default directory is the shared store. Use an explicit local
  path on a host whose home directory is on NFS. Existing per-profile files
  move to a timestamped recovery archive; nothing is deleted.

  --force       SIGKILL verified Codex processes that survive SIGTERM for 20s""",
    "doctor": """cdx doctor [--json]

  Compare the live Codex home layout with cdx's dated storage policy, run
  read-only SQLite quick checks, and report app servers bound to another
  profile. Unknown files are reported but never moved or linked automatically.

  --json       machine-readable compatibility report""",
    "version": """cdx version [--check]

  Print cdx's embedded release version. --check fetches the latest bin/cdx
  from the checkout's GitHub origin and reports whether an update is ready.""",
    "update": """cdx update [--check] [--force]

  Fetch bin/cdx from the current Git checkout's GitHub origin/main, validate
  its identity, Python syntax and embedded version, then replace this script
  atomically. Refuses to overwrite local bin/cdx edits or reuse a release
  number unless --force is explicit.

  --check      report what is available without installing it
  --force      overwrite local edits or permit a downgrade""",
}


# ── dispatch ─────────────────────────────────────────────────────────────────
def main(argv: list[str]) -> int:
    _init_color()
    _check_endpoint()

    command = argv[0] if argv else ""
    rest = argv[1:]

    # Only the word straight after the command counts as a help request: 'cdx
    # add work --help' is asking 'codex login' for its help, not cdx for its
    # own.
    if rest and rest[0] in ("-h", "--help"):
        key = {"ls": "list", "mv": "rename"}.get(command, command)
        if key in SUB_HELP:
            out(SUB_HELP[key])
            return 0

    if command in ("-h", "--help", "help"):
        usage()
        return 0

    # 'link' is exempt from the codex check because it is the repair command,
    # and the breakage it repairs takes codex off PATH. The launcher at
    # ~/.local/bin/codex is a symlink through the shared packages/ dir, so the
    # moment that dir moves — a hand-run migration, a renamed store —
    # resolving it fails. Demanding codex here would put the only fix on the
    # far side of the thing that needs fixing. cmd_link shells out to nothing.
    if command not in ("link", "share-sqlite", "doctor", "version", "update") \
            and not shutil.which("codex"):
        die("codex is not on PATH")

    if command in ("", "list", "ls"):
        return list_profiles(rest if command else argv)
    if command in ("--refresh", "--no-usage"):
        # The listing is the default command, so its flags have to work
        # without naming it — 'cdx --refresh' is what you actually type.
        return list_profiles(argv)
    if command == "add":
        return cmd_add(rest)
    if command == "init":
        return cmd_init(rest)
    if command == "use":
        return cmd_use(rest)
    if command == "app":
        return cmd_app(rest)
    if command == "status":
        return cmd_status(rest)
    if command == "doctor":
        return cmd_doctor(rest)
    if command == "share-sqlite":
        return cmd_share_sqlite(rest)
    if command == "version":
        return cmd_version(rest)
    if command == "update":
        return cmd_update(rest)
    if command == "ssh":
        return cmd_ssh(rest)
    if command in ("rename", "mv"):
        return cmd_rename(rest)
    if command == "migrate":
        # Removed once every machine had been converted. Kept as a dispatch
        # entry so muscle memory gets the layout answer instead of "no such
        # profile".
        if legacy_layout():
            explain_legacy()
            return 1
        out(f"cdx: 'migrate' is gone — this install already uses the store ({STORE})")
        return 0
    if command == "rm":
        return cmd_rm(rest)
    if command == "link":
        return cmd_link()
    if command.startswith("-"):
        die(f"unknown option {command} (see cdx -h)")
    return cmd_run(argv)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    finally:
        release_switch_lock()
